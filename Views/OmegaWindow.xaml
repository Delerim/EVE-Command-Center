<Window x:Class="EveCommandCenter.Views.OmegaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EVE Command Center | Omega" Width="1320" Height="850" MinWidth="1050" MinHeight="650" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#102D31"/><Setter Property="BorderBrush" Value="#245058"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="10"/></Style></ResourceDictionary></Window.Resources>
<DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="OMEGA &amp; CLONES" Foreground="#55D7D2" FontSize="26" FontWeight="Bold"/><Border Background="#102D31" CornerRadius="6" Padding="12" Margin="0,12"><TextBlock Text="ESI does not expose Omega expiry or verified Alpha/Omega status. Subscription dates and account groups below are manually recorded from your launcher. Home station and jump clones are read from ESI after authorization." TextWrapping="Wrap" Foreground="#9FC5C7"/></Border><TextBlock x:Name="Summary" Foreground="#55D7D2" FontSize="16" Margin="0,0,0,12"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#8FB2B5" Margin="0,10,0,0"/>
<Grid><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="220"/></Grid.RowDefinitions><DataGrid x:Name="Pilots" SelectionChanged="Selected"><DataGrid.Columns><DataGridTemplateColumn Header="PILOT" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Portrait}" Width="36" Height="36" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ACCOUNT GROUP" Binding="{Binding Account}" Width="*"/><DataGridTemplateColumn Header="RECORDED STATUS" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OmegaStatus}" Foreground="{Binding Color}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="TIME LEFT" Binding="{Binding Remaining}" Width="*"/><DataGridTextColumn Header="RECORDED EXPIRY" Binding="{Binding Expires}" Width="1.5*"/><DataGridTextColumn Header="JUMP CLONES" Binding="{Binding JumpCount}" Width="*"/></DataGrid.Columns></DataGrid>
<GridSplitter Grid.Row="1" Height="8" Background="#245058" HorizontalAlignment="Stretch" ResizeDirection="Rows"/><DockPanel Grid.Row="2"><StackPanel DockPanel.Dock="Top"><WrapPanel Margin="0,10"><TextBlock Text="Account group " VerticalAlignment="Center"/><TextBox x:Name="Account" Width="150"/><TextBlock Text=" Recorded expiry (local) " VerticalAlignment="Center"/><DatePicker x:Name="Expiry" Width="156" Style="{StaticResource CommandDatePicker}"/><TextBox x:Name="Time" Text="00:00" Width="65" ToolTip="Local expiry time HH:mm"/><Button Content="SAVE DATE" Click="Save_Click" Margin="8,0"/><Button Content="CLEAR DATE" Click="Clear_Click"/><Button Content="LINK CLONE PERMISSION" Click="Link_Click" Margin="8,0"/></WrapPanel><TextBlock Text="Saving a date also applies it to existing pilots with the same non-empty account group. Group membership is chosen by you, not discovered through ESI." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel><TextBox x:Name="Clones" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#102D31" Foreground="#DDF6F4"/></DockPanel></Grid></DockPanel></Window>
