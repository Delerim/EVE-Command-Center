<Window x:Class="EveCommandCenter.Views.OmegaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EVE Command Center | Omega" Width="1320" Height="960" MinWidth="1050" MinHeight="650" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#102D31"/><Setter Property="AlternatingRowBackground" Value="#0C2529"/><Setter Property="RowHeight" Value="48"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="BorderBrush" Value="#245058"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="10"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C5750"/><Setter Property="Foreground" Value="#DDF6F4"/></Trigger></Style.Triggers></Style>
<Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style><Style x:Key="Tile" TargetType="Border"><Setter Property="Background" Value="#102D31"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
</ResourceDictionary></Window.Resources><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="OMEGA &amp; CLONES" Foreground="#55D7D2" FontSize="26" FontWeight="Bold"/><CheckBox x:Name="Alerts" Content="DESKTOP REMINDERS" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFD166" Click="Alerts_Click"/></DockPanel><Border Background="#102D31" CornerRadius="6" Padding="12" Margin="0,12"><TextBlock Text="Dates are recorded manually from your launcher. Clone details come from ESI. Update dates after renewing." TextWrapping="Wrap" Foreground="#9FC5C7"/></Border><UniformGrid Columns="4"><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="TRACKED ACCOUNTS" Foreground="#91A4AD"/><TextBlock x:Name="TrackedTile" FontSize="25" Foreground="#74D6C9"/></StackPanel></Border><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="UNDER 30 DAYS" Foreground="#FFD166"/><TextBlock x:Name="DueTile" FontSize="25" Foreground="#FFD166"/></StackPanel></Border><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="EXPIRED / VERIFY" Foreground="#F27878"/><TextBlock x:Name="ExpiredTile" FontSize="25" Foreground="#F27878"/></StackPanel></Border><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="GLOBAL PLEX / UNIT" Foreground="#9EBFFF"/><TextBlock x:Name="PlexTile" FontSize="25" Foreground="#9EBFFF"/></StackPanel></Border></UniformGrid><TextBlock x:Name="Summary" Foreground="#55D7D2" FontSize="13" Margin="0,0,0,12"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#8FB2B5" Margin="0,10,0,0"/>
<TabControl x:Name="OmegaTabs" Background="#07181B" Foreground="#DDF6F4" BorderThickness="0" Padding="0">
<TabItem Header="ACCOUNTS &amp; CLONES"><Grid Background="#07181B" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="315"/></Grid.ColumnDefinitions>
<Border Background="#0C2529" CornerRadius="8" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PILOTS | Select one to manage its account" Foreground="#74D6C9" Margin="0,0,0,12" FontWeight="Bold"/><DataGrid x:Name="Pilots" SelectionChanged="Selected"><DataGrid.Columns><DataGridTemplateColumn Header="PILOT" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Portrait}" Width="36" Height="36" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="TIME LEFT" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#07181B" CornerRadius="5" Padding="8,6" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding Remaining}" Foreground="{Binding Color}" FontWeight="Bold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="RECORDED EXPIRY" Binding="{Binding Expires}" Width="1.5*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="2" Background="#102D31" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock x:Name="SelectedTitle" Text="SELECT A PILOT" FontSize="19" Foreground="#74D6C9" FontWeight="Bold"/>
<TextBlock x:Name="SelectedStatus" Foreground="#91A4AD" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="Account group" Margin="0,20,0,6"/><TextBox x:Name="Account" MinHeight="32"/>
<TextBlock Text="Recorded expiry (local)" Margin="0,16,0,6"/><WrapPanel><DatePicker x:Name="Expiry" Width="160" Style="{StaticResource CommandDatePicker}"/><TextBox x:Name="Time" Text="00:00" Width="70" Margin="8,0,0,0"/></WrapPanel>
<WrapPanel Margin="0,16,0,12"><Button Content="SAVE DATE" Click="Save_Click" Margin="0,0,8,0"/><Button Content="CLEAR DATE" Click="Clear_Click"/></WrapPanel>
<TextBlock Text="A saved date applies to pilots sharing this account group." Foreground="#91A4AD" TextWrapping="Wrap"/>
<Border Height="1" Background="#245058" Margin="0,22"/>
<TextBlock Text="CLONE DETAILS" Foreground="#9EBFFF" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBox x:Name="Clones" IsReadOnly="True" TextWrapping="Wrap" Background="#102D31" Foreground="#DDF6F4" BorderThickness="0" MinHeight="120"/>
<Button Content="LINK CLONE PERMISSION" Click="Link_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
</StackPanel></ScrollViewer></Border></Grid></TabItem>
<TabItem Header="RENEWAL BUDGET"><Grid Background="#07181B" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="290"/></Grid.ColumnDefinitions>
<Border Background="#0C2529" CornerRadius="8" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="NEXT RENEWAL" FontSize="20" Foreground="#FFD166" FontWeight="Bold"/><ComboBox x:Name="Offer" Margin="0,14" SelectionChanged="Budget_Changed"/><TextBlock x:Name="BudgetTotal" Foreground="#74D6C9" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,16"/></StackPanel><DataGrid x:Name="Budgets" Margin="0,10" SelectionChanged="Budget_Selected"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="ACCOUNT / PILOT" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PLEX TO BUY" Binding="{Binding Plex}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="SAVED ISK" Binding="{Binding Saved}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="STILL TO SAVE" Binding="{Binding Gap}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="ISK / DAY UNTIL EXPIRY" Binding="{Binding Daily}" Width="1.2*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="2" Background="#102D31" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="ACCOUNT SAVINGS" FontSize="18" Foreground="#74D6C9" FontWeight="Bold"/><TextBlock x:Name="SavingsTitle" Margin="0,8" Foreground="#9FC5C7" TextWrapping="Wrap"/><TextBlock Text="PLEX set aside" Margin="0,14,0,6"/><TextBox x:Name="SavedPlex" Text="0" MinHeight="32"/><TextBlock Text="ISK set aside" Margin="0,14,0,6"/><TextBox x:Name="SavedIsk" Text="0" MinHeight="32"/><Button Content="SAVE BUDGET" Click="Savings_Click" Margin="0,16" HorizontalAlignment="Left"/><TextBlock Text="Funds are entered manually per account. Each named account is counted once; ungrouped pilots count separately." Foreground="#91A4AD" TextWrapping="Wrap"/>
<Border Height="1" Background="#245058" Margin="0,20"/><TextBlock Text="MARKET QUOTE" Foreground="#9EBFFF" FontWeight="Bold"/><TextBlock x:Name="QuoteText" TextWrapping="Wrap" Foreground="#91A4AD" Margin="0,12"/><Button Content="REFRESH WHEN DUE" Click="Market_Click" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer></Border></Grid></TabItem>
<TabItem Header="NES OFFERS"><Grid Background="#07181B" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="290"/></Grid.ColumnDefinitions>
<Border Background="#0C2529" CornerRadius="8" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="COMPARE OMEGA PACKAGES" FontSize="20" Foreground="#9EBFFF" FontWeight="Bold"/><TextBlock Text="Sorted by PLEX per 30 days. Check availability before buying; reference prices are not live NES quotes." Foreground="#91A4AD" TextWrapping="Wrap" Margin="0,12"/></StackPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button Content="OFFER SOURCE" Click="OfferSource_Click" Margin="0,0,8,0"/><Button Content="REMOVE SELECTED" Click="RemoveDeal_Click" Margin="0,0,8,0"/><Button Content="EVE STORE" Click="Store_Click"/></WrapPanel><DataGrid ToolTip="Select a package and use Offer Source to check its published details." x:Name="Deals"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PACKAGE" Binding="{Binding Name}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PLEX / 30 DAYS" Binding="{Binding Monthly}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="EST. ISK" Binding="{Binding Cost}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="AVAILABILITY" Binding="{Binding Validity}" Width="1.3*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<Border Grid.Column="2" Background="#102D31" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="ADD A NES OFFER" FontSize="18" Foreground="#FFD166" FontWeight="Bold"/><TextBlock Text="Enter a deal you see in the store." Foreground="#91A4AD" Margin="0,8"/><TextBlock Text="Name" Margin="0,14,0,6"/><TextBox x:Name="DealName" Text="NES offer" MinHeight="32"/><TextBlock Text="Omega days" Margin="0,14,0,6"/><TextBox x:Name="DealDays" Text="30" MinHeight="32"/><TextBlock Text="Total PLEX" Margin="0,14,0,6"/><TextBox x:Name="DealPlex" Text="500" MinHeight="32"/><TextBlock Text="Last valid day (local)" Margin="0,14,0,6"/><DatePicker x:Name="DealEnd" Style="{StaticResource CommandDatePicker}"/><Button Content="ADD OFFER" Click="Deal_Click" Margin="0,18" HorizontalAlignment="Left"/><TextBlock Text="ISK costs use the cached global PLEX sell quote. Available order volume and price changes may affect the final cost." TextWrapping="Wrap" Foreground="#91A4AD"/></StackPanel></ScrollViewer></Border></Grid></TabItem>
<TabItem Header="OFFER NEWS"><Border Background="#0C2529" CornerRadius="8" Padding="18" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="OFFICIAL OMEGA &amp; PLEX NEWS" FontSize="20" Foreground="#FFD166" FontWeight="Bold"/><TextBlock x:Name="NewsStatus" Foreground="#91A4AD" TextWrapping="Wrap" Margin="0,12"/></StackPanel><Button DockPanel.Dock="Bottom" Content="OPEN SELECTED ANNOUNCEMENT" Click="News_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/><DataGrid x:Name="News" MouseDoubleClick="News_Click"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PUBLISHED" Binding="{Binding Date}" Width="120"/><DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="ANNOUNCEMENT" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border></TabItem>
</TabControl></DockPanel></Window>