<Window x:Class="EveCommandCenter.Views.OmegaWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EVE Command Center | Omega" Width="1320" Height="960" MinWidth="1050" MinHeight="650" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#102D31"/><Setter Property="BorderBrush" Value="#245058"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="10"/></Style><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C5750"/><Setter Property="Foreground" Value="#DDF6F4"/></Trigger></Style.Triggers></Style>
<Style x:Key="Tile" TargetType="Border"><Setter Property="Background" Value="#102D31"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,10,10"/></Style>
</ResourceDictionary></Window.Resources>
<DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="OMEGA &amp; CLONES" Foreground="#55D7D2" FontSize="26" FontWeight="Bold"/><CheckBox x:Name="Alerts" Content="DESKTOP REMINDERS" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFD166" Click="Alerts_Click"/></DockPanel><Border Background="#102D31" CornerRadius="6" Padding="12" Margin="0,12"><TextBlock Text="ESI does not expose Omega expiry or verified Alpha/Omega status. Subscription dates and account groups below are manually recorded from your launcher. Home station and jump clones are read from ESI after authorization." TextWrapping="Wrap" Foreground="#9FC5C7"/></Border><UniformGrid Columns="4"><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="TRACKED ACCOUNTS" Foreground="#91A4AD"/><TextBlock x:Name="TrackedTile" FontSize="25" Foreground="#74D6C9"/></StackPanel></Border><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="UNDER 30 DAYS" Foreground="#FFD166"/><TextBlock x:Name="DueTile" FontSize="25" Foreground="#FFD166"/></StackPanel></Border><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="EXPIRED / VERIFY" Foreground="#F27878"/><TextBlock x:Name="ExpiredTile" FontSize="25" Foreground="#F27878"/></StackPanel></Border><Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="JITA PLEX / UNIT" Foreground="#9EBFFF"/><TextBlock x:Name="PlexTile" FontSize="25" Foreground="#9EBFFF"/></StackPanel></Border></UniformGrid><TextBlock x:Name="Summary" Foreground="#55D7D2" FontSize="16" Margin="0,0,0,12"/></StackPanel><TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#8FB2B5" Margin="0,10,0,0"/>
<TabControl x:Name="OmegaTabs"><TabItem Header="ACCOUNTS &amp; CLONES"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="220"/></Grid.RowDefinitions><DataGrid x:Name="Pilots" SelectionChanged="Selected"><DataGrid.Columns><DataGridTemplateColumn Header="PILOT" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Portrait}" Width="36" Height="36" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="ACCOUNT GROUP" Binding="{Binding Account}" Width="*"/><DataGridTemplateColumn Header="RECORDED STATUS" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding OmegaStatus}" Foreground="{Binding Color}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="TIME LEFT" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#07181B" CornerRadius="5" Padding="6"><TextBlock Text="{Binding Remaining}" Foreground="{Binding Color}" FontWeight="Bold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="RECORDED EXPIRY" Binding="{Binding Expires}" Width="1.5*"/><DataGridTextColumn Header="JUMP CLONES" Binding="{Binding JumpCount}" Width="*"/></DataGrid.Columns></DataGrid>
<GridSplitter Grid.Row="1" Height="8" Background="#245058" HorizontalAlignment="Stretch" ResizeDirection="Rows"/><DockPanel Grid.Row="2"><StackPanel DockPanel.Dock="Top"><WrapPanel Margin="0,10"><TextBlock Text="Account group " VerticalAlignment="Center"/><TextBox x:Name="Account" Width="150"/><TextBlock Text=" Recorded expiry (local) " VerticalAlignment="Center"/><DatePicker x:Name="Expiry" Width="156" Style="{StaticResource CommandDatePicker}"/><TextBox x:Name="Time" Text="00:00" Width="65" ToolTip="Local expiry time HH:mm"/><Button Content="SAVE DATE" Click="Save_Click" Margin="8,0"/><Button Content="CLEAR DATE" Click="Clear_Click"/><Button Content="LINK CLONE PERMISSION" Click="Link_Click" Margin="8,0"/></WrapPanel><TextBlock Text="Saving a date also applies it to existing pilots with the same non-empty account group. Group membership is chosen by you, not discovered through ESI." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel><TextBox x:Name="Clones" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#102D31" Foreground="#DDF6F4"/></DockPanel></Grid></TabItem>
<TabItem Header="RENEWAL BUDGET &amp; OFFERS"><ScrollViewer VerticalScrollBarVisibility="Auto" Background="#07181B"><StackPanel Margin="12">
<Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="PLAN YOUR NEXT RENEWAL" FontSize="20" FontWeight="Bold" Foreground="#FFD166"/><TextBlock Text="Choose an Omega package. Totals count each named account once; ungrouped pilots count separately. Savings are manually earmarked per account, not read from your wallet or PLEX vault." Foreground="#9FC5C7" TextWrapping="Wrap" Margin="0,8"/><WrapPanel><ComboBox x:Name="Offer" Width="360" SelectionChanged="Budget_Changed"/><Button Content="REFRESH WHEN DUE" Click="Market_Click" Margin="8,0"/><Button Content="OFFICIAL EVE STORE" Click="Store_Click"/></WrapPanel><TextBlock x:Name="QuoteText" TextWrapping="Wrap" Foreground="#91A4AD" Margin="0,8"/><TextBlock x:Name="BudgetTotal" FontSize="17" Foreground="#74D6C9" TextWrapping="Wrap"/>
<DataGrid x:Name="Budgets" Height="230" Margin="0,10" SelectionChanged="Budget_Selected"><DataGrid.Columns><DataGridTextColumn Header="ACCOUNT / PILOT" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PLEX TO BUY" Binding="{Binding Plex}" Width="110"/><DataGridTextColumn Header="SAVED ISK" Binding="{Binding Saved}" Width="120"/><DataGridTextColumn Header="STILL TO SAVE" Binding="{Binding Gap}" Width="140"/><DataGridTextColumn Header="ISK / DAY UNTIL EXPIRY" Binding="{Binding Daily}" Width="180"/></DataGrid.Columns></DataGrid>
<WrapPanel><TextBlock Text="Selected account savings: PLEX " VerticalAlignment="Center"/><TextBox x:Name="SavedPlex" Width="95" Text="0"/><TextBlock Text=" ISK " VerticalAlignment="Center"/><TextBox x:Name="SavedIsk" Width="170" Text="0"/><Button Content="SAVE BUDGET" Click="Savings_Click" Margin="8,0"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="NES PACKAGE COMPARISON" FontSize="18" Foreground="#9EBFFF" FontWeight="Bold"/><TextBlock Text="Reference packages use CCP's June 2026 base prices, not live NES prices. Enter the price and expiry you see in NES to compare a deal. ISK estimates use the latest cached Jita sell quote; market depth and price movement can change the final cost." TextWrapping="Wrap" Foreground="#9FC5C7" Margin="0,8"/>
<DataGrid x:Name="Deals" Height="175"><DataGrid.Columns><DataGridTextColumn Header="PACKAGE" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PLEX / 30 DAYS" Binding="{Binding Monthly}" Width="125"/><DataGridTextColumn Header="EST. ISK" Binding="{Binding Cost}" Width="125"/><DataGridTextColumn Header="AVAILABILITY" Binding="{Binding Validity}" Width="170"/><DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="2*"/></DataGrid.Columns></DataGrid>
<WrapPanel Margin="0,10"><TextBlock Text="Name " VerticalAlignment="Center"/><TextBox x:Name="DealName" Width="160" Text="NES offer"/><TextBlock Text=" Days " VerticalAlignment="Center"/><TextBox x:Name="DealDays" Width="60" Text="30"/><TextBlock Text=" PLEX " VerticalAlignment="Center"/><TextBox x:Name="DealPlex" Width="80" Text="500"/><TextBlock Text=" Last valid day (local) " VerticalAlignment="Center"/><DatePicker x:Name="DealEnd" Width="145" Style="{StaticResource CommandDatePicker}"/><Button Content="ADD OFFER" Click="Deal_Click" Margin="8,0"/><Button Content="REMOVE SELECTED" Click="RemoveDeal_Click"/><Button Content="OFFER SOURCE" Click="OfferSource_Click" Margin="8,0"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource Tile}"><StackPanel><TextBlock Text="OFFICIAL OMEGA &amp; PLEX ANNOUNCEMENTS" FontSize="18" Foreground="#FFD166" FontWeight="Bold"/><TextBlock x:Name="NewsStatus" Foreground="#9FC5C7" TextWrapping="Wrap" Margin="0,8"/><DataGrid x:Name="News" Height="185" MouseDoubleClick="News_Click"><DataGrid.Columns><DataGridTextColumn Header="PUBLISHED" Binding="{Binding Date}" Width="120"/><DataGridTextColumn Header="ANNOUNCEMENT ? DOUBLE-CLICK TO OPEN" Binding="{Binding Title}" Width="*"/></DataGrid.Columns></DataGrid><Button Content="OPEN SELECTED ANNOUNCEMENT" Click="News_Click" HorizontalAlignment="Left" Margin="0,8"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem></TabControl></DockPanel></Window>
