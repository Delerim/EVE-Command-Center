<Window x:Class="EveMultiPreview.Views.PilotCommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EVE Command Center - Pilot Command Center"
        Width="1500" Height="820" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080E11" Foreground="#EAF7F4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#15312C"/>
            <Setter Property="BorderBrush" Value="#2D5C53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D493F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#276A5B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="#9BB2AC"/>
            <Setter Property="Background" Value="#101B1E"/>
            <Setter Property="BorderBrush" Value="#253D39"/>
        </Style>

        <!-- Same adaptive full-width pill rail used by Mining Command Center. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#0D181B"
                                    BorderBrush="#1E3B36"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="4"
                                    Margin="0,0,0,8">
                                <UniformGrid IsItemsHost="True"
                                             Rows="1"
                                             HorizontalAlignment="Stretch"/>
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8FA9A3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill"
                                HorizontalAlignment="Stretch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#284840"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#142A26"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#1C5A4F"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#58D3B4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0B1417"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#0D171A"/>
            <Setter Property="AlternatingRowBackground" Value="#101C1F"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#142125"/>
            <Setter Property="Foreground" Value="#63CDB2"/>
            <Setter Property="BorderBrush" Value="#203531"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#DCEAE6"/>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="#101B1E"/>
            <Setter Property="BorderBrush" Value="#22443E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="PilotListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="MaxWidth" Value="245"/>
            <Setter Property="MinHeight" Value="108"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outer"
                                Background="#101B1E"
                                BorderBrush="#294A44"
                                BorderThickness="1"
                                CornerRadius="10"
                                MinHeight="108"
                                Padding="9">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#429881"/>
                                <Setter TargetName="Outer" Property="Background" Value="#132522"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#58D3B4"/>
                                <Setter TargetName="Outer" Property="Background" Value="#16332D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#091114" BorderBrush="#28574E"
            BorderThickness="1" CornerRadius="14">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#12332D" BorderBrush="#2A5F54"
                            BorderThickness="1" CornerRadius="8"
                            Height="30" Padding="10,0" Margin="0,0,12,0">
                        <TextBlock Text="PILOTS" Foreground="#58D3B4"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Pilot Command Center"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="#F1F8F6"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="18" Background="#29423D"
                            Margin="13,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Connect a character to begin"
                               Foreground="#6F9189" FontSize="10"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}"
                            Content="_" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowButton}"
                            Content="X" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0B1518"
                    BorderBrush="#19332E" BorderThickness="1"
                    CornerRadius="12" Padding="10" Margin="0,0,0,10"
                    MinHeight="132">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Width="138"
                            MinHeight="108"
                            Margin="10,0,0,0"
                            VerticalAlignment="Stretch"
                            Click="AddCharacter_Click">
                        <StackPanel>
                            <TextBlock Text="+" FontSize="24"
                                       Foreground="#58D3B4"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Add Character"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="EVE SSO"
                                       Foreground="#78958E" FontSize="9"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ListBox x:Name="PilotList"
                             ItemsSource="{Binding Pilots}"
                             SelectionChanged="PilotList_SelectionChanged"
                             Background="#0B1518"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="108"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource PilotListItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"
                                             HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="90">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="54" Height="54"
                                                CornerRadius="8"
                                                ClipToBounds="True"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding PortraitUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding CharacterName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F8F6"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding WalletText}"
                                                       Foreground="#58D3B4"
                                                       FontSize="10.5"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SpText}"
                                                       Foreground="#9DB5AF"
                                                       FontSize="10"/>
                                            <TextBlock Text="{Binding TrainingText}"
                                                       Foreground="#E7B85A"
                                                       FontSize="9.5"
                                                       Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2" Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="WALLET" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="WalletText" Text="-"
                                   Foreground="#58D3B4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL SP" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="TotalSpText" Text="-"
                                   Foreground="#EAF7F4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="CURRENT TRAINING" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="CurrentSkillText" Text="-"
                                   Foreground="#E7B85A" FontSize="13"
                                   FontWeight="SemiBold" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="SkillProgress"
                                     Height="5" Minimum="0" Maximum="100"
                                     Value="0" Margin="0,7,0,0"
                                     Foreground="#58D3B4"
                                     Background="#1A292C"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="QUEUE ENDS" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="QueueEndsText" Text="-"
                                   Foreground="#EAF7F4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh" Margin="0,0,8,0"
                            Click="Refresh_Click"/>
                    <Button Content="Disconnect"
                            Background="#342022" BorderBrush="#6B353B"
                            Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="#0B1518"
                    BorderBrush="#19332E" BorderThickness="1"
                    CornerRadius="12" Padding="10">
                <TabControl>
                    <TabItem Header="Skill Queue">
                        <DataGrid x:Name="SkillQueueGrid" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="55"/>
                                <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" Width="*"/>
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="85"/>
                                <DataGridTextColumn Header="Starts" Binding="{Binding Starts}" Width="150"/>
                                <DataGridTextColumn Header="Finishes" Binding="{Binding Finishes}" Width="150"/>
                                <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Wallet">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#101B1E" BorderBrush="#22443E"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="13" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Character wallet"
                                               Foreground="#78958E"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WalletTabBalanceText"
                                               Text="-"
                                               Foreground="#58D3B4"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="14,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="WalletGrid" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="175"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="220"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="135"/>
                                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="135"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
