<Window x:Class="EveMultiPreview.Views.PilotCommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EVE Command Center - Pilot Command Center"
        Width="1500" Height="820" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080E11" Foreground="#EAF7F4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#15312C"/>
            <Setter Property="BorderBrush" Value="#2D5C53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D493F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#276A5B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="#9BB2AC"/>
            <Setter Property="Background" Value="#101B1E"/>
            <Setter Property="BorderBrush" Value="#253D39"/>
        </Style>

        <!-- Same adaptive full-width pill rail used by Mining Command Center. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#0D181B"
                                    BorderBrush="#1E3B36"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="4"
                                    Margin="0,0,0,8">
                                <TabPanel IsItemsHost="True"
                                          HorizontalAlignment="Left"/>
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8FA9A3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Pill"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#284840"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#142A26"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#1C5A4F"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#58D3B4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0B1417"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#0D171A"/>
            <Setter Property="AlternatingRowBackground" Value="#101C1F"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#142125"/>
            <Setter Property="Foreground" Value="#63CDB2"/>
            <Setter Property="BorderBrush" Value="#203531"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#DCEAE6"/>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="#101B1E"/>
            <Setter Property="BorderBrush" Value="#22443E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="PilotListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="245"/>
            <Setter Property="MinHeight" Value="108"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outer"
                                Background="#101B1E"
                                BorderBrush="#294A44"
                                BorderThickness="1"
                                CornerRadius="10"
                                MinHeight="108"
                                Padding="9">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#429881"/>
                                <Setter TargetName="Outer" Property="Background" Value="#132522"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#58D3B4"/>
                                <Setter TargetName="Outer" Property="Background" Value="#16332D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkillFilterButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="#101F22"/>
            <Setter Property="BorderBrush" Value="#274740"/>
        </Style>

        <Style x:Key="SkillSearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#0C171A"/>
            <Setter Property="BorderBrush" Value="#294A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchShell"
                                        Property="BorderBrush"
                                        Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchShell"
                                        Property="BorderBrush"
                                        Value="#3F7569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#101A1E"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell"
                                        Property="Background"
                                        Value="#17322D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell"
                                        Property="Background"
                                        Value="#1C5A4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkillCategoryCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#0C171A"/>
            <Setter Property="BorderBrush" Value="#294A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="10,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="#EAF7F4"/>
                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               Foreground="#58D3B4"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Margin="0,5,0,0"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="420"
                                        Background="#101A1E"
                                        BorderBrush="#315E56"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboShell"
                                        Property="BorderBrush"
                                        Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboShell"
                                        Property="BorderBrush"
                                        Value="#3F7569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Border Background="#091114" BorderBrush="#28574E"
            BorderThickness="1" CornerRadius="14">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#12332D" BorderBrush="#2A5F54"
                            BorderThickness="1" CornerRadius="8"
                            Height="30" Padding="10,0" Margin="0,0,12,0">
                        <TextBlock Text="PILOTS" Foreground="#58D3B4"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Pilot Command Center"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="#F1F8F6"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="18" Background="#29423D"
                            Margin="13,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Connect a character to begin"
                               Foreground="#6F9189" FontSize="10"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}"
                            Content="_" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowButton}"
                            Content="X" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0B1518"
                    BorderBrush="#19332E" BorderThickness="1"
                    CornerRadius="12" Padding="10" Margin="0,0,0,10"
                    MinHeight="132">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Width="138"
                            MinHeight="108"
                            Margin="10,0,0,0"
                            VerticalAlignment="Stretch"
                            Click="AddCharacter_Click">
                        <StackPanel>
                            <TextBlock Text="+" FontSize="24"
                                       Foreground="#58D3B4"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Add Character"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="EVE SSO"
                                       Foreground="#78958E" FontSize="9"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ListBox x:Name="PilotList"
                             ItemsSource="{Binding Pilots}"
                             SelectionChanged="PilotList_SelectionChanged"
                             Background="#0B1518"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="108"
                             HorizontalContentAlignment="Left"
                             VerticalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{StaticResource PilotListItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="90">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="54" Height="54"
                                                CornerRadius="8"
                                                ClipToBounds="True"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding PortraitUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding CharacterName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F8F6"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding WalletText}"
                                                       Foreground="#58D3B4"
                                                       FontSize="10.5"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SpText}"
                                                       Foreground="#9DB5AF"
                                                       FontSize="10"/>
                                            <TextBlock Text="{Binding TrainingText}"
                                                       Foreground="#E7B85A"
                                                       FontSize="9.5"
                                                       Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2" Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="WALLET" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="WalletText" Text="-"
                                   Foreground="#58D3B4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL SP" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="TotalSpText" Text="-"
                                   Foreground="#EAF7F4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="CURRENT TRAINING" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="CurrentSkillText" Text="-"
                                   Foreground="#E7B85A" FontSize="13"
                                   FontWeight="SemiBold" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="SkillProgress"
                                     Height="5" Minimum="0" Maximum="100"
                                     Value="0" Margin="0,7,0,0"
                                     Foreground="#58D3B4"
                                     Background="#1A292C"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="QUEUE ENDS" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="QueueEndsText" Text="-"
                                   Foreground="#EAF7F4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh" Margin="0,0,8,0"
                            Click="Refresh_Click"/>
                    <Button Content="Disconnect"
                            Background="#342022" BorderBrush="#6B353B"
                            Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="#0B1518"
                    BorderBrush="#19332E" BorderThickness="1"
                    CornerRadius="12" Padding="10">
                <TabControl>
                    <TabItem Header="Skills">
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="SkillSearchBox"
                                         Grid.Column="0"
                                         Style="{StaticResource SkillSearchTextBox}"
                                         Margin="0,0,8,0"
                                         ToolTip="Search skills"
                                         TextChanged="SkillSearchBox_TextChanged"/>

                                <ComboBox x:Name="SkillCategoryFilter"
                                          Grid.Column="1"
                                          Style="{StaticResource SkillCategoryCombo}"
                                          Margin="0,0,8,0"
                                          SelectionChanged="SkillCategoryFilter_SelectionChanged"/>

                                <Button Grid.Column="2"
                                        Content="Expand All"
                                        Margin="0,0,8,0"
                                        Click="ExpandAllSkills_Click"/>

                                <Button Grid.Column="3"
                                        Content="Collapse All"
                                        Click="CollapseAllSkills_Click"/>
                            </Grid>

                            <DockPanel Grid.Row="1"
                                       LastChildFill="True"
                                       Margin="0,0,0,8">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button x:Name="SkillFilterAll"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="all"
                                            Content="All"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterTrained"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="trained"
                                            Content="Trained"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterV"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="5"
                                            Content="Level V"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterIV"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="4"
                                            Content="Level IV"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterIII"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="3"
                                            Content="Level III"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterII"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="2"
                                            Content="Level II"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterI"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="1"
                                            Content="Level I"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterUntrained"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="0"
                                            Content="Untrained"
                                            Click="SkillFilter_Click"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="SkillsCatalogStatusText"
                                               Foreground="#6F9189"
                                               FontSize="9.5"
                                               Margin="12,0,14,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SkillTotalsText"
                                               Text="-"
                                               Foreground="#58D3B4"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="2"
                                    Background="#142125"
                                    BorderBrush="#203531"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skill"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Level"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Trained"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Rank"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Skill Points"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Next Level"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SkillGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      HorizontalContentAlignment="Stretch"
                                                      Margin="0,0,0,2">
                                                <Expander.Header>
                                                    <Border Background="#10253A"
                                                            BorderBrush="#1F4560"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="10,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="240"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="330"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#E7B85A"
                                                                       FontWeight="SemiBold"/>

                                                            <ProgressBar Grid.Column="1"
                                                                         Height="5"
                                                                         Margin="18,0"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Value="{Binding CompletionPercent}"
                                                                         Foreground="#58D3B4"
                                                                         Background="#1A292C"
                                                                         VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SummaryText}"
                                                                       Foreground="#8DA9A2"
                                                                       FontSize="9.5"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Expander.Header>

                                                <ItemsControl ItemsSource="{Binding Skills}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#0D171A"
                                                                    BorderBrush="#15282B"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="10,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="120"/>
                                                                        <ColumnDefinition Width="105"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="190"/>
                                                                        <ColumnDefinition Width="190"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="#DCEAE6"
                                                                               VerticalAlignment="Center"/>

                                                                    <ItemsControl Grid.Column="1"
                                                                                  ItemsSource="{Binding LevelBlocks}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Width="14"
                                                                                        Height="8"
                                                                                        Margin="1,0"
                                                                                        CornerRadius="2">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background"
                                                                                                    Value="#263A3D"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsFilled}"
                                                                                                             Value="True">
                                                                                                    <Setter Property="Background"
                                                                                                            Value="#E7B85A"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding LevelText}"
                                                                               Foreground="#DCEAE6"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding RankText}"
                                                                               Foreground="#8DA9A2"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <TextBlock Grid.Column="4"
                                                                               Text="{Binding SpText}"
                                                                               Foreground="#DCEAE6"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <TextBlock Grid.Column="5"
                                                                               Text="{Binding NextText}"
                                                                               Foreground="{Binding NextForeground}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Skill Queue">

                        <DataGrid x:Name="SkillQueueGrid" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="55"/>
                                <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" Width="*"/>
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="85"/>
                                <DataGridTextColumn Header="Starts" Binding="{Binding Starts}" Width="150"/>
                                <DataGridTextColumn Header="Finishes" Binding="{Binding Finishes}" Width="150"/>
                                <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Wallet">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#101B1E" BorderBrush="#22443E"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="13" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Character wallet"
                                               Foreground="#78958E"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WalletTabBalanceText"
                                               Text="-"
                                               Foreground="#58D3B4"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Margin="14,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="WalletGrid" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="175"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="220"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="135"/>
                                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="135"/>
                                    <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
