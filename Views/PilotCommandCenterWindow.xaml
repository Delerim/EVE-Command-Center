<Window x:Class="EveMultiPreview.Views.PilotCommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EVE Command Center - Pilot Command Center"
        Width="1500" Height="820" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#080E11" Foreground="#EAF7F4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#15312C"/>
            <Setter Property="BorderBrush" Value="#2D5C53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D493F"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#276A5B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="#9BB2AC"/>
            <Setter Property="Background" Value="#101B1E"/>
            <Setter Property="BorderBrush" Value="#253D39"/>
        </Style>

        <!-- Exact copy of the Mining Command Center tab rail/pill templates. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#091215"
                                    BorderBrush="#182D2A"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="5"
                                    Margin="0,0,0,10">
                                <UniformGrid IsItemsHost="True"
                                             Rows="1"
                                             Background="Transparent"
                                             Margin="0"
                                             ClipToBounds="False"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="#0B1518"
                                    BorderBrush="#19332E"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10">
                                <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8FA9A3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="MinHeight" Value="35"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabPill"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabPill"
                                        Property="Background"
                                        Value="#122724"/>
                                <Setter TargetName="TabPill"
                                        Property="BorderBrush"
                                        Value="#294E47"/>
                                <Setter Property="Foreground"
                                        Value="#DCEAE6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabPill"
                                        Property="Background"
                                        Value="#1C5A4F"/>
                                <Setter TargetName="TabPill"
                                        Property="BorderBrush"
                                        Value="#4BB99F"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0B1417"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#0D171A"/>
            <Setter Property="AlternatingRowBackground" Value="#101C1F"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#142125"/>
            <Setter Property="Foreground" Value="#63CDB2"/>
            <Setter Property="BorderBrush" Value="#203531"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#DCEAE6"/>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="#101B1E"/>
            <Setter Property="BorderBrush" Value="#22443E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="PilotListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="245"/>
            <Setter Property="MinHeight" Value="122"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outer"
                                Background="#101B1E"
                                BorderBrush="#294A44"
                                BorderThickness="1"
                                CornerRadius="10"
                                MinHeight="108"
                                Padding="9">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#429881"/>
                                <Setter TargetName="Outer" Property="Background" Value="#132522"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#58D3B4"/>
                                <Setter TargetName="Outer" Property="Background" Value="#16332D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkillFilterButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="#101F22"/>
            <Setter Property="BorderBrush" Value="#274740"/>
        </Style>

        <Style x:Key="AttributeToggleButton"
               TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#91AAA4"/>
            <Setter Property="Background" Value="#101F22"/>
            <Setter Property="BorderBrush" Value="#274740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Dot"
                                           Text="o"
                                           Foreground="#526D67"
                                           Margin="0,0,6,0"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleShell"
                                        Property="BorderBrush"
                                        Value="#4B8A7D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleShell"
                                        Property="Background"
                                        Value="#3A2F16"/>
                                <Setter TargetName="ToggleShell"
                                        Property="BorderBrush"
                                        Value="#C99B42"/>
                                <Setter Property="Foreground"
                                        Value="#F2C96D"/>
                                <Setter TargetName="Dot"
                                        Property="Foreground"
                                        Value="#F2C96D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkillSearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#0C171A"/>
            <Setter Property="BorderBrush" Value="#294A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="SearchShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="SearchShell"
                                        Property="BorderBrush"
                                        Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchShell"
                                        Property="BorderBrush"
                                        Value="#3F7569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#101A1E"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemShell"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemShell"
                                        Property="Background"
                                        Value="#17322D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemShell"
                                        Property="Background"
                                        Value="#1C5A4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkillCategoryCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#0C171A"/>
            <Setter Property="BorderBrush" Value="#294A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="10,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="#EAF7F4"/>
                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               Foreground="#58D3B4"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                                              RelativeSource={RelativeSource TemplatedParent},
                                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Margin="0,5,0,0"
                                        MinWidth="{Binding ActualWidth,
                                                           RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="420"
                                        Background="#101A1E"
                                        BorderBrush="#315E56"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboShell"
                                        Property="BorderBrush"
                                        Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboShell"
                                        Property="BorderBrush"
                                        Value="#3F7569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Border Background="#091114" BorderBrush="#28574E"
            BorderThickness="1" CornerRadius="14">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#12332D" BorderBrush="#2A5F54"
                            BorderThickness="1" CornerRadius="8"
                            Height="30" Padding="10,0" Margin="0,0,12,0">
                        <TextBlock Text="PILOTS" Foreground="#58D3B4"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Pilot Command Center"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="#F1F8F6"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="18" Background="#29423D"
                            Margin="13,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Connect a character to begin"
                               Foreground="#6F9189" FontSize="10"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}"
                            Content="_" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowButton}"
                            Content="X" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0B1518"
                    BorderBrush="#19332E" BorderThickness="1"
                    CornerRadius="12" Padding="10" Margin="0,0,0,10"
                    MinHeight="132">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Width="138"
                            MinHeight="108"
                            Margin="10,0,0,0"
                            VerticalAlignment="Stretch"
                            Click="AddCharacter_Click">
                        <StackPanel>
                            <TextBlock Text="+" FontSize="24"
                                       Foreground="#58D3B4"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Add Character"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="EVE SSO"
                                       Foreground="#78958E" FontSize="9"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ListBox x:Name="PilotList"
                             ItemsSource="{Binding Pilots}"
                             SelectionChanged="PilotList_SelectionChanged"
                             Background="#0B1518"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="108"
                             HorizontalContentAlignment="Left"
                             VerticalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{StaticResource PilotListItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="104">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                            <Border Width="54" Height="54"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    HorizontalAlignment="Left">
                                                <Image Source="{Binding PortraitUrl}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <Border Margin="0,7,0,0"
                                                    Padding="5,3"
                                                    Background="#12332D"
                                                    BorderBrush="#2A5F54"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding QueueText}"
                                                           Foreground="#58D3B4"
                                                           FontSize="8.5"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Top">
                                            <TextBlock Text="{Binding CharacterName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F8F6"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding WalletText}"
                                                       Foreground="#58D3B4"
                                                       FontSize="10.5"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding SpText}"
                                                       Foreground="#9DB5AF"
                                                       FontSize="10"/>
                                            <TextBlock Text="{Binding LocationText}"
                                                       Foreground="#8DA9A2"
                                                       FontSize="9"
                                                       Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ShipText}"
                                                       Foreground="#8DA9A2"
                                                       FontSize="9"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TrainingText}"
                                                       Foreground="#E7B85A"
                                                       FontSize="9.5"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2" Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="WALLET" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="WalletText" Text="-"
                                   Foreground="#58D3B4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL SP" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="TotalSpText" Text="-"
                                   Foreground="#EAF7F4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="CURRENT TRAINING" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="CurrentSkillText" Text="-"
                                   Foreground="#E7B85A" FontSize="13"
                                   FontWeight="SemiBold" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="SkillProgress"
                                     Height="5" Minimum="0" Maximum="100"
                                     Value="0" Margin="0,7,0,0"
                                     Foreground="#58D3B4"
                                     Background="#1A292C"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource SummaryCard}">
                    <StackPanel>
                        <TextBlock Text="QUEUE ENDS" Foreground="#78958E" FontSize="9"/>
                        <TextBlock x:Name="QueueEndsText" Text="-"
                                   Foreground="#EAF7F4" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh" Margin="0,0,8,0"
                                Click="Refresh_Click"/>
                        <Button Content="Disconnect"
                                Background="#342022"
                                BorderBrush="#6B353B"
                                Click="Disconnect_Click"/>
                    </StackPanel>

                    <ToggleButton x:Name="AttributeAlignmentToggle"
                                  Style="{StaticResource AttributeToggleButton}"
                                  Content="HIGHLIGHT OFF-MAP"
                                  IsChecked="True"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,7,0,0"
                                  Click="AttributeAlignmentToggle_Click"
                                  ToolTip="Highlight skills whose primary/secondary attributes are poorly aligned with the character's current attribute map."/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="3"
                        SelectionChanged="PilotTabs_SelectionChanged">
                    <TabItem Header="Skills">
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="SkillSearchBox"
                                         Grid.Column="0"
                                         Style="{StaticResource SkillSearchTextBox}"
                                         Margin="0,0,8,0"
                                         ToolTip="Search skills"
                                         TextChanged="SkillSearchBox_TextChanged"/>

                                <ComboBox x:Name="SkillCategoryFilter"
                                          Grid.Column="1"
                                          Style="{StaticResource SkillCategoryCombo}"
                                          Margin="0,0,8,0"
                                          SelectionChanged="SkillCategoryFilter_SelectionChanged"/>

                                <Button Grid.Column="2"
                                        Content="Expand All"
                                        Margin="0,0,8,0"
                                        Click="ExpandAllSkills_Click"/>

                                <Button Grid.Column="3"
                                        Content="Collapse All"
                                        Click="CollapseAllSkills_Click"/>
                            </Grid>

                            <DockPanel Grid.Row="1"
                                       LastChildFill="True"
                                       Margin="0,0,0,8">
                                <WrapPanel DockPanel.Dock="Left">
                                    <Button x:Name="SkillFilterAll"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="all"
                                            Content="All"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterTrained"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="trained"
                                            Content="Trained"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterV"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="5"
                                            Content="Level V"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterIV"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="4"
                                            Content="Level IV"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterIII"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="3"
                                            Content="Level III"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterII"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="2"
                                            Content="Level II"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterI"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="1"
                                            Content="Level I"
                                            Click="SkillFilter_Click"/>
                                    <Button x:Name="SkillFilterUntrained"
                                            Style="{StaticResource SkillFilterButton}"
                                            Tag="0"
                                            Content="Untrained"
                                            Click="SkillFilter_Click"/>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="SkillsCatalogStatusText"
                                               Foreground="#6F9189"
                                               FontSize="9.5"
                                               Margin="12,0,14,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SkillTotalsText"
                                               Text="-"
                                               Foreground="#58D3B4"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="2"
                                    Background="#142125"
                                    BorderBrush="#203531"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="235"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Skill"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Level"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Trained"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Rank"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Attributes / Rate"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Skill Points"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="6"
                                               Text="Next Level"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SkillGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      HorizontalContentAlignment="Stretch"
                                                      Margin="0,0,0,2">
                                                <Expander.Header>
                                                    <Border Background="#10253A"
                                                            BorderBrush="#1F4560"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="10,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="240"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="330"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#E7B85A"
                                                                       FontWeight="SemiBold"/>

                                                            <ProgressBar Grid.Column="1"
                                                                         Height="5"
                                                                         Margin="18,0"
                                                                         Minimum="0"
                                                                         Maximum="100"
                                                                         Value="{Binding CompletionPercent, Mode=OneWay}"
                                                                         Foreground="#58D3B4"
                                                                         Background="#1A292C"
                                                                         VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SummaryText}"
                                                                       Foreground="#8DA9A2"
                                                                       FontSize="9.5"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </Expander.Header>

                                                <ItemsControl ItemsSource="{Binding Skills}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding RowBackground}"
                                                                    BorderBrush="#15282B"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="10,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="110"/>
                                                                        <ColumnDefinition Width="95"/>
                                                                        <ColumnDefinition Width="70"/>
                                                                        <ColumnDefinition Width="235"/>
                                                                        <ColumnDefinition Width="170"/>
                                                                        <ColumnDefinition Width="170"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="#DCEAE6"
                                                                               VerticalAlignment="Center"/>

                                                                    <ItemsControl Grid.Column="1"
                                                                                  ItemsSource="{Binding LevelBlocks}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Width="14"
                                                                                        Height="8"
                                                                                        Margin="1,0"
                                                                                        CornerRadius="2">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background"
                                                                                                    Value="#263A3D"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding IsFilled}"
                                                                                                             Value="True">
                                                                                                    <Setter Property="Background"
                                                                                                            Value="#E7B85A"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding LevelText}"
                                                                               Foreground="#DCEAE6"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding RankText}"
                                                                               Foreground="#8DA9A2"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <StackPanel Grid.Column="4"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    HorizontalAlignment="Center">
                                                                            <Border Background="#132229"
                                                                                    BorderBrush="{Binding PrimaryAccent}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="5"
                                                                                    Padding="5,2"
                                                                                    Margin="0,0,4,0">
                                                                                <TextBlock Text="{Binding PrimaryBadge}"
                                                                                           Foreground="{Binding PrimaryAccent}"
                                                                                           FontSize="9"
                                                                                           FontWeight="SemiBold"/>
                                                                            </Border>

                                                                            <Border Background="#132229"
                                                                                    BorderBrush="{Binding SecondaryAccent}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="5"
                                                                                    Padding="5,2">
                                                                                <TextBlock Text="{Binding SecondaryBadge}"
                                                                                           Foreground="{Binding SecondaryAccent}"
                                                                                           FontSize="9"
                                                                                           FontWeight="SemiBold"/>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <TextBlock Text="{Binding AlignmentText}"
                                                                                   Foreground="{Binding AlignmentForeground}"
                                                                                   FontSize="8.5"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,3,0,0"/>
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="5"
                                                                               Text="{Binding SpText}"
                                                                               Foreground="#DCEAE6"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>

                                                                    <TextBlock Grid.Column="6"
                                                                               Text="{Binding NextText}"
                                                                               Foreground="{Binding NextForeground}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Skill Queue">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#0E1A1D"
                                    BorderBrush="#25463F"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="420"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock Text="TRAINING PROFILE"
                                                       Foreground="#63CDB2"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RemapSummaryText"
                                                       DockPanel.Dock="Right"
                                                       Foreground="#8FA9A3"
                                                       FontSize="9.5"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>

                                        <ItemsControl x:Name="AttributeItems">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#111F22"
                                                            BorderBrush="{Binding Accent}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="9,7"
                                                            Margin="0,0,6,0">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ShortName}"
                                                                           Foreground="{Binding Accent}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#78958E"
                                                                           FontSize="8.5"
                                                                           Margin="6,1,0,0"/>
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding Total}"
                                                                       Foreground="#F2F8F6"
                                                                       FontSize="20"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,0"/>

                                                            <TextBlock Text="{Binding RawText}"
                                                                       Foreground="#708F88"
                                                                       FontSize="8.5"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#101B1E"
                                            BorderBrush="#203D38"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="10,0,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,7">
                                                <TextBlock x:Name="ImplantAccessText"
                                                           Foreground="#E7B85A"
                                                           FontSize="9.5"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>

                                                <ToggleButton x:Name="ShowAllImplantsToggle"
                                                              DockPanel.Dock="Right"
                                                              Style="{StaticResource AttributeToggleButton}"
                                                              Content="SHOW ALL"
                                                              IsChecked="False"
                                                              Padding="7,3"
                                                              MinHeight="24"
                                                              Margin="8,0,0,0"
                                                              Click="ShowAllImplantsToggle_Click"/>
                                            </DockPanel>

                                            <ItemsControl x:Name="ImplantItems">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#132421"
                                                                BorderBrush="#315E56"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="7,4"
                                                                Margin="0,0,5,5">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#DCEAE6"
                                                                           FontSize="8.5"
                                                                           FontWeight="SemiBold"
                                                                           MaxWidth="180"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding BonusText}"
                                                                           Foreground="#58D3B4"
                                                                           FontSize="8"
                                                                           Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Background="#142125"
                                    BorderBrush="#203531"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="235"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="125"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="#"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Skill / Progress"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Attributes / Alignment"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Starts"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Finishes"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5"
                                               Text="Remaining"
                                               Foreground="#63CDB2"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="SkillQueueGrid">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}"
                                                    BorderBrush="{Binding RowBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="10,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="235"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="125"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Position}"
                                                               Foreground="#78958E"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Skill}"
                                                                       Foreground="#F1F8F6"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LevelText}"
                                                                       Foreground="#E7B85A"
                                                                       FontWeight="SemiBold"
                                                                       Margin="7,0,0,0"/>
                                                            <Border Background="{Binding StatusBackground}"
                                                                    CornerRadius="5"
                                                                    Padding="5,1"
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{Binding StatusForeground}"
                                                                           FontSize="8"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <ProgressBar Height="4"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                     Foreground="#58D3B4"
                                                                     Background="#1A292C"
                                                                     Margin="0,5,22,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center">
                                                            <Border Background="#132229"
                                                                    BorderBrush="{Binding PrimaryAccent}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="5,2"
                                                                    Margin="0,0,4,0">
                                                                <TextBlock Text="{Binding PrimaryBadge}"
                                                                           Foreground="{Binding PrimaryAccent}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                            <Border Background="#132229"
                                                                    BorderBrush="{Binding SecondaryAccent}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="5,2">
                                                                <TextBlock Text="{Binding SecondaryBadge}"
                                                                           Foreground="{Binding SecondaryAccent}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding AlignmentText}"
                                                                   Foreground="{Binding AlignmentForeground}"
                                                                   FontSize="8.5"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Starts}"
                                                               Foreground="#9DB5AF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding Finishes}"
                                                               Foreground="#9DB5AF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding Remaining}"
                                                               Foreground="#E7B85A"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="ShipAssetsTab"
                             Header="Ship &amp; Assets">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="0.9*"/>
                                <RowDefinition Height="1.1*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#101B1E"
                                    BorderBrush="#22443E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="CURRENT SHIP"
                                                   Foreground="#78958E"
                                                   FontSize="9"/>
                                        <TextBlock x:Name="CurrentShipDetailText"
                                                   Text="-"
                                                   Foreground="#58D3B4"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock x:Name="CurrentShipItemText"
                                                   Text=""
                                                   Foreground="#78958E"
                                                   FontSize="9"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock x:Name="ShipAssetsStatusText"
                                                   Text="Open this tab to sync ship and asset data."
                                                   Foreground="#E7B85A"
                                                   FontSize="9.5"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="View Current Fit"
                                                Margin="0,0,8,0"
                                                Click="ViewCurrentFit_Click"/>
                                        <Button Content="Refresh Ship Data"
                                                Click="RefreshShipAssets_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1"
                                  Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#0D171A"
                                        BorderBrush="#1D3732"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9"
                                        Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="CURRENT EQUIPMENT"
                                                       Foreground="#63CDB2"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="CurrentEquipmentCountText"
                                                       DockPanel.Dock="Right"
                                                       Foreground="#78958E"
                                                       FontSize="9"/>
                                        </DockPanel>

                                        <DataGrid x:Name="CurrentShipModulesGrid"
                                                  Grid.Row="1"
                                                  RowHeight="30">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Slot"
                                                                    Binding="{Binding Slot}"
                                                                    Width="95"/>
                                                <DataGridTextColumn Header="Module / Drone"
                                                                    Binding="{Binding Name}"
                                                                    Width="*"/>
                                                <DataGridTextColumn Header="Qty"
                                                                    Binding="{Binding Quantity}"
                                                                    Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="#0D171A"
                                        BorderBrush="#1D3732"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9"
                                        Margin="5,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="SAVED FITTINGS"
                                                       Foreground="#63CDB2"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="FittingCountText"
                                                       DockPanel.Dock="Right"
                                                       Foreground="#78958E"
                                                       FontSize="9"/>
                                        </DockPanel>

                                        <DataGrid x:Name="SavedFittingsGrid"
                                                  Grid.Row="1"
                                                  RowHeight="30">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header=""
                                                                        Width="62">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="VIEW"
                                                                    Padding="6,1"
                                                                    MinHeight="22"
                                                                    FontSize="8.5"
                                                                    Click="ViewSavedFit_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Fit"
                                                                    Binding="{Binding Name}"
                                                                    Width="180"/>
                                                <DataGridTextColumn Header="Ship"
                                                                    Binding="{Binding Ship}"
                                                                    Width="150"/>
                                                <DataGridTextColumn Header="Items"
                                                                    Binding="{Binding Items}"
                                                                    Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="#0D171A"
                                    BorderBrush="#1D3732"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="PERSONAL ASSETS"
                                                   Foreground="#63CDB2"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                        <TextBlock x:Name="AssetCountText"
                                                   DockPanel.Dock="Right"
                                                   Foreground="#78958E"
                                                   FontSize="9"/>
                                    </DockPanel>

                                    <DataGrid x:Name="PersonalAssetsGrid"
                                              Grid.Row="1"
                                              RowHeight="29">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Item"
                                                                Binding="{Binding Name}"
                                                                Width="*"/>
                                            <DataGridTextColumn Header="Qty"
                                                                Binding="{Binding Quantity}"
                                                                Width="80"/>
                                            <DataGridTextColumn Header="Location"
                                                                Binding="{Binding Location}"
                                                                Width="240"/>
                                            <DataGridTextColumn Header="Flag"
                                                                Binding="{Binding Flag}"
                                                                Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Wallet">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#101B1E"
                                    BorderBrush="#22443E"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="13"
                                    Margin="0,0,0,9">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="CHARACTER WALLET"
                                                   Foreground="#78958E"
                                                   FontSize="9"/>
                                        <TextBlock x:Name="WalletTabBalanceText"
                                                   Text="-"
                                                   Foreground="#58D3B4"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock x:Name="WalletMarketSummaryText"
                                               DockPanel.Dock="Right"
                                               Foreground="#8FA9A3"
                                               FontSize="9.5"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <TabControl Grid.Row="1">
                                <TabItem Header="Overview">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Style="{StaticResource SummaryCard}">
                                            <StackPanel>
                                                <TextBlock Text="TODAY INCOME"
                                                           Foreground="#78958E"
                                                           FontSize="9"/>
                                                <TextBlock x:Name="WalletTodayIncomeText"
                                                           Text="-"
                                                           Foreground="#58D3B4"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Style="{StaticResource SummaryCard}">
                                            <StackPanel>
                                                <TextBlock Text="TODAY SPENT"
                                                           Foreground="#78958E"
                                                           FontSize="9"/>
                                                <TextBlock x:Name="WalletTodaySpentText"
                                                           Text="-"
                                                           Foreground="#E87979"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="0"
                                                Grid.Column="2"
                                                Style="{StaticResource SummaryCard}">
                                            <StackPanel>
                                                <TextBlock Text="TODAY NET"
                                                           Foreground="#78958E"
                                                           FontSize="9"/>
                                                <TextBlock x:Name="WalletTodayNetText"
                                                           Text="-"
                                                           Foreground="#9DB5AF"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Grid.Column="0"
                                                Style="{StaticResource SummaryCard}"
                                                Margin="0,10,10,0">
                                            <StackPanel>
                                                <TextBlock Text="7 DAY INCOME"
                                                           Foreground="#78958E"
                                                           FontSize="9"/>
                                                <TextBlock x:Name="WalletWeekIncomeText"
                                                           Text="-"
                                                           Foreground="#58D3B4"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{StaticResource SummaryCard}"
                                                Margin="0,10,10,0">
                                            <StackPanel>
                                                <TextBlock Text="7 DAY SPENT"
                                                           Foreground="#78958E"
                                                           FontSize="9"/>
                                                <TextBlock x:Name="WalletWeekSpentText"
                                                           Text="-"
                                                           Foreground="#E87979"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Grid.Column="2"
                                                Style="{StaticResource SummaryCard}"
                                                Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="7 DAY NET"
                                                           Foreground="#78958E"
                                                           FontSize="9"/>
                                                <TextBlock x:Name="WalletWeekNetText"
                                                           Text="-"
                                                           Foreground="#9DB5AF"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Journal">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="WalletJournalCountText"
                                                   Foreground="#78958E"
                                                   FontSize="9.5"
                                                   Margin="4,0,0,7"/>

                                        <DataGrid x:Name="WalletJournalGrid"
                                                  Grid.Row="1">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background"
                                                            Value="{Binding RowBackground}"/>
                                                </Style>
                                            </DataGrid.RowStyle>

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date"
                                                                    Binding="{Binding Date}"
                                                                    Width="165"/>
                                                <DataGridTextColumn Header="Type"
                                                                    Binding="{Binding Type}"
                                                                    Width="220"/>

                                                <DataGridTemplateColumn Header="Amount"
                                                                        Width="145">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Amount}"
                                                                       Foreground="{Binding AmountForeground}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Balance"
                                                                    Binding="{Binding Balance}"
                                                                    Width="145"/>
                                                <DataGridTextColumn Header="Reason"
                                                                    Binding="{Binding Reason}"
                                                                    Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Transactions">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="WalletTransactionCountText"
                                                   Foreground="#78958E"
                                                   FontSize="9.5"
                                                   Margin="4,0,0,7"/>

                                        <DataGrid x:Name="WalletTransactionsGrid"
                                                  Grid.Row="1">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background"
                                                            Value="{Binding RowBackground}"/>
                                                </Style>
                                            </DataGrid.RowStyle>

                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date"
                                                                    Binding="{Binding Date}"
                                                                    Width="165"/>

                                                <DataGridTemplateColumn Header="Side"
                                                                        Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Direction}"
                                                                       Foreground="{Binding AmountForeground}"
                                                                       FontWeight="Bold"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Item"
                                                                    Binding="{Binding Item}"
                                                                    Width="*"/>
                                                <DataGridTextColumn Header="Qty"
                                                                    Binding="{Binding Quantity}"
                                                                    Width="85"/>
                                                <DataGridTextColumn Header="Unit Price"
                                                                    Binding="{Binding UnitPrice}"
                                                                    Width="145"/>

                                                <DataGridTemplateColumn Header="Total"
                                                                        Width="145">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Total}"
                                                                       Foreground="{Binding AmountForeground}"
                                                                       FontWeight="SemiBold"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="PLEX">
                                    <Grid Margin="0,4,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0"
                                              Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock Text="PLEX BOUGHT"
                                                               Foreground="#78958E"
                                                               FontSize="8.5"/>
                                                    <TextBlock x:Name="PlexBoughtText"
                                                               Text="-"
                                                               Foreground="#E87979"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock Text="PLEX SOLD"
                                                               Foreground="#78958E"
                                                               FontSize="8.5"/>
                                                    <TextBlock x:Name="PlexSoldText"
                                                               Text="-"
                                                               Foreground="#58D3B4"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock Text="AVG BUY"
                                                               Foreground="#78958E"
                                                               FontSize="8.5"/>
                                                    <TextBlock x:Name="PlexAverageBuyText"
                                                               Text="-"
                                                               Foreground="#E87979"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="3"
                                                    Style="{StaticResource SummaryCard}">
                                                <StackPanel>
                                                    <TextBlock Text="AVG SELL"
                                                               Foreground="#78958E"
                                                               FontSize="8.5"/>
                                                    <TextBlock x:Name="PlexAverageSellText"
                                                               Text="-"
                                                               Foreground="#58D3B4"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="4"
                                                    Style="{StaticResource SummaryCard}"
                                                    Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="PLEX NET ISK"
                                                               Foreground="#78958E"
                                                               FontSize="8.5"/>
                                                    <TextBlock x:Name="PlexNetText"
                                                               Text="-"
                                                               Foreground="#9DB5AF"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock x:Name="WalletPlexCountText"
                                                       Foreground="#78958E"
                                                       FontSize="9.5"
                                                       Margin="4,0,0,7"/>

                                            <DataGrid x:Name="WalletPlexGrid"
                                                      Grid.Row="1">
                                                <DataGrid.RowStyle>
                                                    <Style TargetType="DataGridRow">
                                                        <Setter Property="Background"
                                                                Value="{Binding RowBackground}"/>
                                                    </Style>
                                                </DataGrid.RowStyle>

                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Date"
                                                                        Binding="{Binding Date}"
                                                                        Width="170"/>

                                                    <DataGridTemplateColumn Header="Side"
                                                                            Width="70">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Direction}"
                                                                           Foreground="{Binding AmountForeground}"
                                                                           FontWeight="Bold"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn Header="Qty"
                                                                        Binding="{Binding Quantity}"
                                                                        Width="100"/>
                                                    <DataGridTextColumn Header="Unit Price"
                                                                        Binding="{Binding UnitPrice}"
                                                                        Width="160"/>

                                                    <DataGridTemplateColumn Header="Total"
                                                                            Width="160">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Total}"
                                                                           Foreground="{Binding AmountForeground}"
                                                                           FontWeight="SemiBold"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
