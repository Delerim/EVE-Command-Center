<Window x:Class="EveCommandCenter.Views.SkillPlannerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Skill plans" Width="1220" Height="850" MinWidth="1000" MinHeight="650" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterOwner">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#0C2529"/><Setter Property="AlternatingRowBackground" Value="#102D31"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#245058"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C5750"/><Setter Property="Foreground" Value="#DDF6F4"/></Trigger></Style.Triggers></Style>
</ResourceDictionary></Window.Resources>
<DockPanel Margin="18">
<StackPanel DockPanel.Dock="Top">
<TextBlock x:Name="Heading" FontSize="26" FontWeight="Bold" Foreground="#55D7D2"/>
<TextBlock x:Name="AttributesText" Margin="0,8" Foreground="#9FD2D2"/>
<Border Background="#102D31" Padding="12" Margin="0,0,0,12"><TextBlock TextWrapping="Wrap" Text="Attribute priority puts faster-training skills first while preserving prerequisites. With fixed attributes, order does not change total training time. Plans are local: ESI cannot reorder your live queue. Copy a plan, then import and apply it in EVE. Estimates assume normal full-rate training, unchanged attributes and no temporary accelerators; your saved skill snapshot may lag active training."/></Border>
<WrapPanel Margin="0,0,0,10"><TextBox x:Name="PlanName" Text="My skill plan" Width="200" Margin="0,0,8,0"/><Button Content="SAVE PLAN" Click="Save_Click"/><ComboBox x:Name="SavedPlans" Width="190" Margin="8,0"/><Button Content="LOAD" Click="Load_Click"/><Button Content="COPY LIVE QUEUE" Click="Queue_Click" Margin="8,0"/><Button Content="CLEAR PLAN" Click="Clear_Click"/></WrapPanel>
</StackPanel>
<TextBlock DockPanel.Dock="Bottom" x:Name="Status" TextWrapping="Wrap" Foreground="#9FD2D2" Margin="0,10,0,0"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.4*" MinWidth="480"/></Grid.ColumnDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="SKILL PROFILES" Foreground="#55D7D2" FontWeight="Bold"/><ComboBox x:Name="Profiles" Margin="0,10" SelectionChanged="Profile_Changed"/><TextBlock Text="Targets are level V. Mining profile covers Exhumer operation and mining drones; ore-specific crystals, reprocessing and fleet command skills can be added separately below." TextWrapping="Wrap" Foreground="#9FD2D2" Margin="0,0,0,10"/><Button Content="ADD MISSING PROFILE SKILLS" Click="Profile_Click" Margin="0,0,0,10"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="CUSTOM TARGET" Foreground="#55D7D2" FontWeight="Bold"/><ComboBox x:Name="Skill" IsEditable="True" IsTextSearchEnabled="True" DisplayMemberPath="Name" Margin="0,8"/><WrapPanel><ComboBox x:Name="Level" Width="65" SelectedIndex="4"><ComboBoxItem>I</ComboBoxItem><ComboBoxItem>II</ComboBoxItem><ComboBoxItem>III</ComboBoxItem><ComboBoxItem>IV</ComboBoxItem><ComboBoxItem>V</ComboBoxItem></ComboBox><Button Content="ADD TARGET" Click="Add_Click" Margin="8,0"/></WrapPanel></StackPanel>
<DataGrid x:Name="ProfileGrid"><DataGrid.Columns><DataGridTextColumn Header="SKILL" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="TRAINED" Binding="{Binding Trained}" Width="75"/><DataGridTemplateColumn Header="TARGET V" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
</DockPanel><GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#245058"/>
<DockPanel Grid.Column="2" Margin="12,0,0,0"><StackPanel DockPanel.Dock="Top"><TextBlock Text="TRAINING PLAN" Foreground="#55D7D2" FontWeight="Bold"/><WrapPanel Margin="0,10"><Button Content="ATTRIBUTE PRIORITY" Click="Optimize_Click"/><Button Content="COPY FOR EVE" Click="Copy_Click" Margin="8,0"/><Button Content="REMOVE TARGET" Click="Remove_Click"/></WrapPanel><TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="#55D7D2" Margin="0,0,0,10"/></StackPanel>
<TextBlock DockPanel.Dock="Bottom" x:Name="Guidance" TextWrapping="Wrap" Foreground="#9FD2D2" Margin="0,10,0,0"/>
<DataGrid x:Name="Steps"><DataGrid.Columns><DataGridTextColumn Header="SKILL" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="LEVEL" Binding="{Binding Target}" Width="50"/><DataGridTextColumn Header="ATTRIBUTES" Binding="{Binding Attributes}" Width="100"/><DataGridTextColumn Header="SP LEFT" Binding="{Binding RemainingSp, StringFormat=N0}" Width="90"/><DataGridTextColumn Header="SP/MIN" Binding="{Binding Rate, StringFormat=F1}" Width="65"/><DataGridTextColumn Header="TIME" Binding="{Binding Duration}" Width="100"/></DataGrid.Columns></DataGrid>
</DockPanel></Grid></DockPanel></Window>
