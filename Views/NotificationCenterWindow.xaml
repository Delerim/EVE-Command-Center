<Window x:Class="EveCommandCenter.Views.NotificationCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EVE Command Center | Notifications" Width="1000" Height="720" MinWidth="750" MinHeight="500" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="NOTIFICATION CENTRE" FontSize="25" FontWeight="Bold" Foreground="#55D7D2"/><Button Content="MARK ALL READ" Click="Read_Click" HorizontalAlignment="Right"/></DockPanel><TextBlock x:Name="Summary" Margin="0,12" Foreground="#9FC5C7"/><WrapPanel Margin="0,0,0,16"><Button Content="CURRENT PI ISSUES" Click="Current_Click" Margin="0,0,8,0"/><Button Content="ALL / POPUP HISTORY" Click="History_Click"/></WrapPanel><TextBlock Text="Existing PI issues appear even if no popup fired. Reading an issue does not resolve it. History retains up to 300 entries for 30 days; new popups continue normally." Foreground="#91A4AD" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Rows"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#102D31" BorderBrush="{Binding Color}" BorderThickness="3,0,0,0" CornerRadius="6" Padding="16" Margin="0,0,0,10"><DockPanel><Button Content="OPEN" Tag="{Binding Source}" Click="Open_Click" DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#9FC5C7" Margin="0,7"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Source}" Foreground="{Binding Color}" Margin="0,0,12,0"/><TextBlock Text="{Binding State}" Foreground="{Binding Color}" Margin="0,0,12,0"/><TextBlock Text="{Binding Time}" Foreground="#91A4AD"/></StackPanel></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</DockPanel></Window>
