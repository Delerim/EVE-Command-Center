<UserControl x:Class="EveCommandCenter.Views.PilotSyncView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/><ResourceDictionary Source="IndustryWorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="SyncSwitch" TargetType="CheckBox"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Width="32" Height="18" CornerRadius="9" Background="#30454A" BorderBrush="#638087" BorderThickness="1"><Ellipse x:Name="Knob" Width="12" Height="12" Fill="#B8CBCE" HorizontalAlignment="Left" Margin="2,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#27695D"/><Setter TargetName="Track" Property="BorderBrush" Value="#76D7CB"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="#C4FFF4"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#D6FFFA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <StackPanel Margin="4">
  <TextBlock Text="Sync &amp; dashboard" FontSize="20" FontWeight="SemiBold" Foreground="#55D7D2"/>
  <TextBlock Text="Choose automatic sync for each pilot. Wallet includes balance, purchases, sales and wallet activity. Market includes open orders and order history. Saved data is kept when sync is off." TextWrapping="Wrap" Foreground="#91B9BB" Margin="0,8,0,12"/>
  <TabControl BorderBrush="#29494F" BorderThickness="1" Background="#07181B"><TabItem Header="Automatic sync"><DataGrid x:Name="SyncRows" BorderBrush="#29494F" BorderThickness="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Height="330" SelectionChanged="Row_Selected"><DataGrid.Columns>
   <DataGridTemplateColumn Header="Pilot" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Portrait}" Width="26" Height="26" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Wallet" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Wallet" IsChecked="{Binding Preference.Wallet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Market" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Market" IsChecked="{Binding Preference.Market, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Industry" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Industry" IsChecked="{Binding Preference.Industry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="PI" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="PI" IsChecked="{Binding Preference.Planetary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Pilot info" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Pilot info" IsChecked="{Binding Preference.Pilot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Clones" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Clones" IsChecked="{Binding Preference.Clones, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid></TabItem>
  <TabItem Header="Dashboard visibility"><StackPanel><TextBlock Text="Independent of sync. Hiding a pilot does not stop imports or remove saved history." Margin="8" TextWrapping="Wrap"/><DataGrid x:Name="VisibilityRows" BorderBrush="#29494F" BorderThickness="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Height="290"><DataGrid.Columns>
   <DataGridTextColumn Header="Pilot" Binding="{Binding Name}" IsReadOnly="True" Width="220"/>
   <DataGridTemplateColumn Header="Market orders" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Market orders" IsChecked="{Binding Preference.ShowMarket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Wallet &amp; trades" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Wallet &amp; trades" IsChecked="{Binding Preference.ShowWallet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTemplateColumn Header="Industry jobs" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SyncSwitch}" ToolTip="Industry jobs" IsChecked="{Binding Preference.ShowIndustry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
  </DataGrid.Columns></DataGrid></StackPanel></TabItem></TabControl>
  <WrapPanel Margin="0,10"><Button Content="Save sync settings" Click="Save_Click"/><Button Content="Check sync status" Click="Status_Click" Margin="8,0"/></WrapPanel>
  <TextBlock x:Name="SyncMessage" Foreground="#76D7CB" TextWrapping="Wrap"/>
  <Border Background="#091B20" CornerRadius="8" Padding="12" Margin="0,10,0,0"><TextBlock x:Name="SyncDetail" TextWrapping="Wrap" Foreground="#91B9BB" Text="Select a pilot to see permissions and sync status."/></Border>
  <TextBlock Text="Changes apply on the next cycle; a sync already running may finish. Refreshes respect EVE cache and rate limits. Moon and corporation-contract readers remain in the setup sections below; public prices and local mining logs are separate." Foreground="#91B9BB" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </StackPanel>
</UserControl>
