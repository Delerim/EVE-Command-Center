<Window x:Class="EveCommandCenter.Views.PlanetaryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EVE Command Center | Planetary Industry" Width="1450" Height="950" MinWidth="1050" MinHeight="650" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#0C2529"/><Setter Property="AlternatingRowBackground" Value="#102D31"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#245058"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/></Style>
<DataTemplate x:Key="StatusCell"><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate>
<DataTemplate x:Key="NameCell"><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
</ResourceDictionary></Window.Resources>
<DockPanel Margin="18">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="PLANETARY INDUSTRY" FontSize="26" FontWeight="Bold" Foreground="#55D7D2"/>
<TextBlock Text="All pilots | extraction programs | factory supply | shared stockpile" Foreground="#8FB2B5" Margin="0,6,0,14"/>
<WrapPanel Margin="0,0,0,12"><ComboBox x:Name="Pilot" Width="230" DisplayMemberPath="CharacterName"/><Button Content="LINK PI PERMISSION" Click="Link_Click" Margin="8,0"/><Button Content="REFRESH WHEN DUE" Click="Refresh_Click"/><TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="16,0" Foreground="#55D7D2" FontWeight="SemiBold"/></WrapPanel>
<Border Background="#102D31" Padding="10" CornerRadius="6" Margin="0,0,0,12"><TextBlock Text="ESI updates colony contents when you view the colony in game. Timers and input runway are estimates; extractor totals use nominal yield, not an extraction ledger. Factory projections exclude future routed production and assume continuously running consumers." TextWrapping="Wrap" Foreground="#9FC5C7"/></Border>
</StackPanel>
<TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,10,0,0"/>
<TabControl x:Name="Tabs" Background="#07181B" BorderBrush="#245058">
<TabItem Header="OVERVIEW"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="130"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="100"/></Grid.RowDefinitions>
<DataGrid x:Name="Colonies" SelectionChanged="Colony_Selected" AlternationCount="2"><DataGrid.Columns><DataGridTemplateColumn Header="PLANET" CellTemplate="{StaticResource NameCell}" Width="1.3*"/><DataGridTextColumn Header="PILOT / TYPE" Binding="{Binding Detail}" Width="1.4*"/><DataGridTextColumn Header="FACILITIES" Binding="{Binding Quantity}" Width="*"/><DataGridTemplateColumn Header="ATTENTION" CellTemplate="{StaticResource StatusCell}" Width="*"/><DataGridTextColumn Header="NEXT ACTION (EST.)" Binding="{Binding Remaining}" Width="*"/><DataGridTextColumn Header="COLONY UPDATED" Binding="{Binding Next}" Width="1.4*"/></DataGrid.Columns></DataGrid>
<GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#245058" ResizeDirection="Rows"/>
<DockPanel Grid.Row="2"><TextBlock Text="EXTRACTION | current programs combined across pilots" DockPanel.Dock="Top" Foreground="#55D7D2" Margin="0,10"/><DataGrid x:Name="Production"><DataGrid.Columns><DataGridTemplateColumn Header="RESOURCE" CellTemplate="{StaticResource NameCell}" Width="*"/><DataGridTextColumn Header="CURRENT NOMINAL RATE" Binding="{Binding Rate}" Width="*"/><DataGridTextColumn Header="PROJECTED SINCE PROGRAM START" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="BASIS" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel>
</Grid></TabItem>
<TabItem Header="COLONY DETAILS"><DockPanel Margin="10"><TextBlock x:Name="DetailTitle" Text="Select a planet in Overview to inspect its extractors, factories and storage." DockPanel.Dock="Top" Margin="0,0,0,10" Foreground="#55D7D2"/>
<DataGrid x:Name="Pins" AlternationCount="2"><DataGrid.Columns><DataGridTemplateColumn Header="FACILITY / PRODUCT" CellTemplate="{StaticResource NameCell}" Width="1.2*"/><DataGridTemplateColumn Header="STATUS" CellTemplate="{StaticResource StatusCell}" Width="*"/><DataGridTextColumn Header="CONTENTS / INPUT PER CYCLE" Binding="{Binding Quantity}" Width="2*"/><DataGridTextColumn Header="RATE / CAPACITY" Binding="{Binding Rate}" Width="1.5*"/><DataGridTextColumn Header="NEXT CYCLE" Binding="{Binding Next}" Width="*"/><DataGridTextColumn Header="RESTART / REFILL" Binding="{Binding Remaining}" Width="1.5*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="STOCKPILE"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="STOCKPILE OWNER" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StockPilot" Width="200" DisplayMemberPath="CharacterName"/><ComboBox x:Name="Container" Width="540" DisplayMemberPath="Label" Margin="8,0"/><Button Content="USE SELECTION" Click="Stock_Click"/></WrapPanel><TextBlock x:Name="StockStatus" Foreground="#8FB2B5" Margin="0,10" TextWrapping="Wrap"/></StackPanel>
<DataGrid x:Name="StockGrid" AlternationCount="2"><DataGrid.Columns><DataGridTemplateColumn Header="ITEM" CellTemplate="{StaticResource NameCell}" Width="2*"/><DataGridTextColumn Header="CATEGORY" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="UNITS" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="VOLUME" Binding="{Binding Rate}" Width="*"/><DataGridTextColumn Header="SNAPSHOT" Binding="{Binding Next}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="FACTORY REFILLS"><DockPanel Margin="10"><TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Text="Balanced full-launchpad targets from directly routed factory inputs. Existing cargo consumes capacity. Stock is allocated once across this list; downstream production is not assumed. Amounts are snapshot-based, so check the colony before hauling." TextWrapping="Wrap" Foreground="#9FC5C7"/>
<DataGrid x:Name="Refills" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="PILOT / PLANET" Binding="{Binding Colony}" Width="2*"/><DataGridTextColumn Header="LAUNCHPAD" Binding="{Binding Pin}" Width="*"/><DataGridTemplateColumn Header="INPUT" CellTemplate="{StaticResource NameCell}" Width="1.5*"/><DataGridTextColumn Header="ON PLANET" Binding="{Binding Current, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="FULL TARGET" Binding="{Binding Target, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="TO HAUL" Binding="{Binding Need, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="FROM STOCK" Binding="{Binding Allocated, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="SHORTFALL" Binding="{Binding Missing, StringFormat=N0}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="LINK STATUS"><TextBox x:Name="Links" IsReadOnly="True" TextWrapping="Wrap" Margin="12" VerticalScrollBarVisibility="Auto"/></TabItem>
</TabControl></DockPanel></Window>