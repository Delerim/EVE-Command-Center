<Window x:Class="EveCommandCenter.Views.PlanetaryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EVE Command Center | Planetary Industry" Width="1450" Height="950" MinWidth="1050" MinHeight="650" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#0C2529"/><Setter Property="AlternatingRowBackground" Value="#102D31"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#245058"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/></Style>
<DataTemplate x:Key="StatusCell"><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate>
<DataTemplate x:Key="NameCell"><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
<Style TargetType="Expander"><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,4"/></Style>
<DataTemplate x:Key="GroupHeader"><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="32" Height="32" Margin="4,0,12,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/><TextBlock Text="{Binding Summary}" Foreground="{Binding Color}" Margin="0,4,0,0"/></StackPanel></StackPanel></DataTemplate>
<DataTemplate x:Key="PilotGroup"><Border Background="#102D31" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><Expander Header="{Binding}" HeaderTemplate="{StaticResource GroupHeader}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Expanded="Expansion_Changed" Collapsed="Expansion_Changed"><ItemsControl ItemsSource="{Binding Planets}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#07181B" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="12,8,0,0"><StackPanel><DockPanel><TextBlock Text="{Binding Row.Status}" Foreground="{Binding Row.Color}" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><Image Source="{Binding PlanetIcon}" Width="40" Height="40" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Row.Name}" FontSize="17" FontWeight="Bold" Foreground="#55D7D2"/><TextBlock Text="{Binding Row.Colony.PlanetType}" Foreground="#8FB2B5"/></StackPanel></StackPanel></DockPanel><TextBlock Text="{Binding Facilities}" Margin="0,6"/><TextBlock Text="{Binding Row.Remaining, StringFormat=Next action (estimated): {0}}" Foreground="#9FC5C7"/><TextBlock Text="{Binding Row.Next}" Foreground="#8FB2B5"/><TextBlock Text="{Binding Products}" TextWrapping="Wrap" Foreground="#9FC5C7" Margin="0,8"/><Expander Header="FACILITIES, STORAGE AND CYCLE DETAILS" IsExpanded="{Binding Expanded, Mode=TwoWay}" Expanded="Expansion_Changed" Collapsed="Expansion_Changed"><DataGrid ItemsSource="{Binding Pins}" MinHeight="80"><DataGrid.Columns><DataGridTemplateColumn Header="FACILITY / PRODUCT" CellTemplate="{StaticResource NameCell}" Width="1.3*"/><DataGridTemplateColumn Header="STATUS" CellTemplate="{StaticResource StatusCell}" Width="*"/><DataGridTextColumn Header="CONTENTS / INPUTS" Binding="{Binding Quantity}" Width="1.5*"/><DataGridTextColumn Header="RATE" Binding="{Binding Rate}" Width="1.5*"/><DataGridTextColumn Header="NEXT CYCLE" Binding="{Binding Next}" Width="*"/><DataGridTextColumn Header="RESTART / REFILL" Binding="{Binding Remaining}" Width="1.3*"/></DataGrid.Columns></DataGrid></Expander></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></Border></DataTemplate>
<DataTemplate x:Key="RefillGroup"><Border Background="#102D31" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><Expander Header="{Binding}" HeaderTemplate="{StaticResource GroupHeader}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Expanded="Expansion_Changed" Collapsed="Expansion_Changed"><ItemsControl ItemsSource="{Binding Planets}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#07181B" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="12,8,0,0"><StackPanel><DockPanel><TextBlock Text="{Binding Row.Status}" Foreground="{Binding Row.Color}" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><Image Source="{Binding PlanetIcon}" Width="40" Height="40" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Row.Name}" FontSize="17" FontWeight="Bold" Foreground="#55D7D2"/><TextBlock Text="{Binding Row.Colony.PlanetType}" Foreground="#8FB2B5"/></StackPanel></StackPanel></DockPanel><TextBlock Text="{Binding Facilities}" Margin="0,6"/><TextBlock Text="{Binding Row.Remaining, StringFormat=Next action (estimated): {0}}" Foreground="#9FC5C7"/><TextBlock Text="{Binding Row.Next}" Foreground="#8FB2B5"/><TextBlock Text="{Binding RefillSummary}" Foreground="#FFD166" Margin="0,8"/><DataGrid ItemsSource="{Binding Refills}" MinHeight="70"><DataGrid.Columns><DataGridTemplateColumn Header="T1 INPUT" CellTemplate="{StaticResource NameCell}" Width="*"/><DataGridTextColumn Header="LAUNCHPAD" Binding="{Binding Pin}" Width="*"/><DataGridTextColumn Header="ON PLANET" Binding="{Binding Current, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="FULL TARGET" Binding="{Binding Target, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="TO HAUL" Binding="{Binding Need, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="FROM STOCK" Binding="{Binding Allocated, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="SHORTFALL" Binding="{Binding Missing, StringFormat=N0}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></Border></DataTemplate>
</ResourceDictionary></Window.Resources>
<DockPanel Margin="18">
<StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="PLANETARY INDUSTRY" FontSize="26" FontWeight="Bold" Foreground="#55D7D2"/><Button Content="NOTIFICATIONS" Click="Notifications_Click" HorizontalAlignment="Right"/></DockPanel>
<TextBlock Text="All pilots | extraction programs | factory supply | shared stockpile" Foreground="#8FB2B5" Margin="0,6,0,14"/>
<WrapPanel Margin="0,0,0,12"><CheckBox x:Name="PiAlerts" Content="DESKTOP ALERTS" VerticalAlignment="Center" Margin="0,0,12,0" Click="PiAlerts_Click"/><ComboBox x:Name="Pilot" Width="230" DisplayMemberPath="CharacterName"/><Button Content="LINK PI PERMISSION" Click="Link_Click" Margin="8,0"/><Button Content="REFRESH WHEN DUE" Click="Refresh_Click"/><TextBlock x:Name="Summary" VerticalAlignment="Center" Margin="16,0" Foreground="#55D7D2" FontWeight="SemiBold"/></WrapPanel>
<Border Background="#102D31" Padding="10" CornerRadius="6" Margin="0,0,0,12"><TextBlock Text="ESI updates colony contents when you view the colony in game. Timers and input runway are estimates; extractor totals use nominal yield, not an extraction ledger. Factory projections exclude future routed production and assume continuously running consumers." TextWrapping="Wrap" Foreground="#9FC5C7"/></Border>
</StackPanel>
<TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,10,0,0"/>
<TabControl x:Name="Tabs" Background="#07181B" BorderBrush="#245058">
<TabItem Header="OVERVIEW"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="2*" MinHeight="180"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="100"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Colonies" ItemTemplate="{StaticResource PilotGroup}"/></ScrollViewer>
<GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="#245058" ResizeDirection="Rows"/>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*" MinWidth="480"/></Grid.ColumnDefinitions>
<Border BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="10"><DockPanel><TextBlock Text="EXTRACTION | raw resources" DockPanel.Dock="Top" Foreground="#55D7D2" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid x:Name="Production"><DataGrid.Columns><DataGridTemplateColumn Header="RESOURCE" CellTemplate="{StaticResource NameCell}" Width="*"/><DataGridTextColumn Header="NOMINAL RATE" Binding="{Binding Rate}" Width="*"/><DataGridTextColumn Header="PROJECTED TOTAL" Binding="{Binding Quantity}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#245058" ResizeDirection="Columns"/>
<Border Grid.Column="2" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="10"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="FACTORY OUTPUT | all planets combined" Foreground="#55D7D2" FontWeight="Bold"/><TextBlock Text="Capacity is configured units/h, not guaranteed output. Collection uses stored snapshots; material routed onward stays reserved." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,5,0,8"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="FactorySummary"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{Binding Color}" BorderThickness="2,0,0,0" Background="#102D31" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="{Binding Color}" FontWeight="Bold"/><TextBlock Text="{Binding Summary}" Foreground="#DDF6F4" Margin="0,4,0,8"/><ItemsControl ItemsSource="{Binding Products}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,6,0"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding RateText}" Foreground="#9FC5C7" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding StoredText}"/><TextBlock Text="{Binding ReservedText}" Foreground="#8FB2B5" FontSize="10"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding CollectText}" Foreground="#80BFFF" FontWeight="Bold" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</DockPanel></Border></Grid>
</Grid></TabItem>
<TabItem Header="EXTRACTORS"><DockPanel Margin="10"><TextBlock DockPanel.Dock="Top" Text="EXTRACTOR PROGRAMS | per pilot and planet. Countdown estimates update locally every 30 seconds. Restart dates are local time; yield is nominal, not stored ore." TextWrapping="Wrap" Foreground="#9FC5C7" Margin="0,0,0,10"/>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Extractors"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#102D31" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8"><Expander Header="{Binding}" HeaderTemplate="{StaticResource GroupHeader}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Expanded="ExtractorExpansion_Changed" Collapsed="ExtractorExpansion_Changed"><ItemsControl ItemsSource="{Binding Planets}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#07181B" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="12,8,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Image Source="{Binding PlanetIcon}" Width="40" Height="40" Margin="0,0,10,8"/><StackPanel><TextBlock Text="{Binding Row.Name}" FontSize="17" FontWeight="Bold" Foreground="#55D7D2"/><TextBlock Text="{Binding Products}" Foreground="#8FB2B5"/></StackPanel></StackPanel><DataGrid ItemsSource="{Binding Pins}" MinHeight="65"><DataGrid.Columns><DataGridTemplateColumn Header="RESOURCE / HEADS" CellTemplate="{StaticResource NameCell}" Width="1.5*"/><DataGridTemplateColumn Header="STATUS" CellTemplate="{StaticResource StatusCell}" Width="*"/><DataGridTextColumn Header="CYCLE LENGTH" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="NEXT CYCLE (EST.)" Binding="{Binding Next}" Width="*"/><DataGridTextColumn Header="PROGRAM LEFT" Binding="{Binding Remaining}" Width="*"/><DataGridTextColumn Header="RESET AT (LOCAL)" Binding="{Binding ResetAt}" Width="1.3*"/><DataGridTextColumn Header="NOMINAL YIELD" Binding="{Binding Rate}" Width="1.3*"/></DataGrid.Columns></DataGrid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></TabItem>
<TabItem Header="STOCKPILE"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="STOCKPILE OWNER" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StockPilot" Width="200" DisplayMemberPath="CharacterName"/><ComboBox x:Name="Container" Width="540" DisplayMemberPath="Label" Margin="8,0"/><Button Content="USE SELECTION" Click="Stock_Click"/></WrapPanel><TextBlock x:Name="StockStatus" Foreground="#8FB2B5" Margin="0,10" TextWrapping="Wrap"/></StackPanel>
<DataGrid x:Name="StockGrid" AlternationCount="2"><DataGrid.Columns><DataGridTemplateColumn Header="ITEM" CellTemplate="{StaticResource NameCell}" Width="2*"/><DataGridTextColumn Header="CATEGORY" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="UNITS" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="VOLUME" Binding="{Binding Rate}" Width="*"/><DataGridTemplateColumn Header="JITA BUY / UNIT" CellTemplate="{StaticResource StatusCell}" Width="*"/><DataGridTextColumn Header="EST. JITA BUY VALUE" Binding="{Binding Remaining}" Width="*"/><DataGridTextColumn Header="PRICE CHECKED" Binding="{Binding Next}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="FACTORY REFILLS"><DockPanel Margin="10"><TextBlock x:Name="RefillSummary" DockPanel.Dock="Top" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="#9FC5C7"/>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Refills" ItemTemplate="{StaticResource RefillGroup}"/></ScrollViewer></DockPanel></TabItem>
<TabItem Header="LINK STATUS"><TextBox x:Name="Links" IsReadOnly="True" TextWrapping="Wrap" Margin="12" VerticalScrollBarVisibility="Auto"/></TabItem>
</TabControl></DockPanel></Window>