<Window x:Class="EveMultiPreview.Views.PilotFitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Command Center - Fit Viewer"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080E11"
        Foreground="#EAF7F4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#15312C"/>
            <Setter Property="BorderBrush" Value="#2D5C53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <DataTemplate x:Key="RingSlotTemplate">
            <StackPanel Margin="3"
                        ToolTip="{Binding Name}">
                <Border Width="48"
                        Height="48"
                        CornerRadius="9"
                        Background="#111D20"
                        BorderBrush="{Binding SlotAccent}"
                        BorderThickness="2"
                        ClipToBounds="True">
                    <Image Source="{Binding IconUrl}"
                           Stretch="Uniform"
                           Margin="2"/>
                </Border>

                <TextBlock Text="{Binding Slot}"
                           Foreground="{Binding SlotAccent}"
                           FontSize="7.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DetailRowTemplate">
            <Border Background="#0E191C"
                    BorderBrush="#1C312E"
                    BorderThickness="0,0,0,1"
                    Padding="5,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="26"
                            Height="26"
                            CornerRadius="5"
                            Background="#132229"
                            BorderBrush="{Binding SlotAccent}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Image Source="{Binding IconUrl}"
                               Stretch="Uniform"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Slot}"
                               Foreground="{Binding SlotAccent}"
                               FontSize="8.5"
                               FontWeight="SemiBold"
                               Margin="6,0,4,0"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Name}"
                               Foreground="#E8F2EF"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding Quantity}"
                               Foreground="#78958E"
                               FontSize="9"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="InfoCard"
               TargetType="Border">
            <Setter Property="Background" Value="#0D181B"/>
            <Setter Property="BorderBrush" Value="#23413B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <Style x:Key="DetailSection"
               TargetType="Border">
            <Setter Property="Background" Value="#0A1316"/>
            <Setter Property="BorderBrush" Value="#1C332F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Border Background="#091114"
            BorderBrush="#28574E"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#12332D"
                            BorderBrush="#2A5F54"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Margin="0,0,12,0">
                        <TextBlock Text="FIT"
                                   Foreground="#58D3B4"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>

                    <StackPanel>
                        <TextBlock x:Name="FitNameText"
                                   Text="Fit Viewer"
                                   Foreground="#F1F8F6"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ShipNameText"
                                   Text="-"
                                   Foreground="#58D3B4"
                                   FontSize="9.5"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="X"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="660"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- EVE/Pyfa-inspired fitting canvas -->
                <Border Grid.Column="0"
                        Background="#071013"
                        BorderBrush="#1E3A35"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <!-- Large circular fitting backdrop -->
                            <Ellipse Width="510"
                                     Height="510"
                                     Fill="#0A1417"
                                     Stroke="#29433F"
                                     StrokeThickness="2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <Ellipse Width="430"
                                     Height="430"
                                     Fill="#091215"
                                     Stroke="#16302B"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                            <Image x:Name="ShipRenderImage"
                                   Width="390"
                                   Height="390"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                            <!-- HIGH slots across upper arc -->
                            <ItemsControl x:Name="HighRingItems"
                                          ItemTemplate="{StaticResource RingSlotTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          Margin="0,25,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- MID slots down right side -->
                            <ItemsControl x:Name="MidRingItems"
                                          ItemTemplate="{StaticResource RingSlotTemplate}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,22,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- LOW slots across lower arc -->
                            <ItemsControl x:Name="LowRingItems"
                                          ItemTemplate="{StaticResource RingSlotTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,22">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- RIGS down left side -->
                            <ItemsControl x:Name="RigRingItems"
                                          ItemTemplate="{StaticResource RingSlotTemplate}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="22,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- centre badge -->
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,95"
                                    Background="#C90B1518"
                                    BorderBrush="#315E56"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="11,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="EHP "
                                               Foreground="#78958E"
                                               FontSize="9"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="EhpValueText"
                                               Text="--"
                                               Foreground="#8EC9E8"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="   |   "
                                               Foreground="#35534D"
                                               FontSize="10"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Text="Modules "
                                               Foreground="#78958E"
                                               FontSize="9"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="ModuleCountText"
                                               Text="0"
                                               Foreground="#F1F8F6"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Drone/fighter tray -->
                        <Border x:Name="DroneTray"
                                Grid.Row="1"
                                Background="#0C1719"
                                BorderBrush="#22443E"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8"
                                Margin="8,4,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="DRONES"
                                           Foreground="#58D3B4"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ItemsControl x:Name="DroneRingItems"
                                              Grid.Column="1"
                                              ItemTemplate="{StaticResource RingSlotTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Stats / detailed fitted modules -->
                <Border Grid.Column="2"
                        Background="#0A1316"
                        BorderBrush="#213E39"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="11">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="FIT DETAILS"
                                   Foreground="#63CDB2"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="2,0,0,8"/>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource InfoCard}">
                                <StackPanel>
                                    <TextBlock Text="SHIELD"
                                               Foreground="#64C7FF"
                                               FontSize="8"/>
                                    <TextBlock x:Name="ShieldHpText"
                                               Text="--"
                                               Foreground="#EAF7F4"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource InfoCard}">
                                <StackPanel>
                                    <TextBlock Text="ARMOR"
                                               Foreground="#D693FF"
                                               FontSize="8"/>
                                    <TextBlock x:Name="ArmorHpText"
                                               Text="--"
                                               Foreground="#EAF7F4"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource InfoCard}"
                                    Margin="0">
                                <StackPanel>
                                    <TextBlock Text="HULL"
                                               Foreground="#E7B85A"
                                               FontSize="8"/>
                                    <TextBlock x:Name="HullHpText"
                                               Text="--"
                                               Foreground="#EAF7F4"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="EhpNoteText"
                                           Text=""
                                           Foreground="#78958E"
                                           FontSize="8.5"
                                           TextWrapping="Wrap"
                                           Margin="2,0,2,8"/>

                                <Border x:Name="HighDetailSection"
                                        Style="{StaticResource DetailSection}">
                                    <StackPanel>
                                        <TextBlock Text="HIGH"
                                                   Foreground="#E7B85A"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Margin="1,0,0,4"/>
                                        <ItemsControl x:Name="HighDetailItems"
                                                      ItemTemplate="{StaticResource DetailRowTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="MidDetailSection"
                                        Style="{StaticResource DetailSection}">
                                    <StackPanel>
                                        <TextBlock Text="MID"
                                                   Foreground="#64C7FF"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Margin="1,0,0,4"/>
                                        <ItemsControl x:Name="MidDetailItems"
                                                      ItemTemplate="{StaticResource DetailRowTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="LowDetailSection"
                                        Style="{StaticResource DetailSection}">
                                    <StackPanel>
                                        <TextBlock Text="LOW"
                                                   Foreground="#D693FF"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Margin="1,0,0,4"/>
                                        <ItemsControl x:Name="LowDetailItems"
                                                      ItemTemplate="{StaticResource DetailRowTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="RigDetailSection"
                                        Style="{StaticResource DetailSection}">
                                    <StackPanel>
                                        <TextBlock Text="RIGS"
                                                   Foreground="#FF8FA6"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Margin="1,0,0,4"/>
                                        <ItemsControl x:Name="RigDetailItems"
                                                      ItemTemplate="{StaticResource DetailRowTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="DroneDetailSection"
                                        Style="{StaticResource DetailSection}">
                                    <StackPanel>
                                        <TextBlock Text="DRONES / FIGHTERS"
                                                   Foreground="#58D3B4"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Margin="1,0,0,4"/>
                                        <ItemsControl x:Name="DroneDetailItems"
                                                      ItemTemplate="{StaticResource DetailRowTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="OtherDetailSection"
                                        Style="{StaticResource DetailSection}">
                                    <StackPanel>
                                        <TextBlock Text="OTHER"
                                                   Foreground="#8DA9A2"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Margin="1,0,0,4"/>
                                        <ItemsControl x:Name="OtherDetailItems"
                                                      ItemTemplate="{StaticResource DetailRowTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="DescriptionText"
                                           Text=""
                                           Foreground="#78958E"
                                           FontSize="8.5"
                                           TextWrapping="Wrap"
                                           Margin="2,2,2,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
