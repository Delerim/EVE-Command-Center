<Window x:Class="EveMultiPreview.Views.PilotFitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Command Center - Fit Viewer"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080E11"
        Foreground="#EAF7F4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#15312C"/>
            <Setter Property="BorderBrush" Value="#2D5C53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0B1417"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowBackground" Value="#0D171A"/>
            <Setter Property="AlternatingRowBackground" Value="#101C1F"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#142125"/>
            <Setter Property="Foreground" Value="#63CDB2"/>
            <Setter Property="BorderBrush" Value="#203531"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Border Background="#091114"
            BorderBrush="#28574E"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#12332D"
                            BorderBrush="#2A5F54"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Margin="0,0,12,0">
                        <TextBlock Text="FIT"
                                   Foreground="#58D3B4"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="Fit Viewer"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#F1F8F6"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="X"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="#101B1E"
                    BorderBrush="#22443E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="13"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="FitNameText"
                                   Text="-"
                                   Foreground="#E7B85A"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ShipNameText"
                                   Text="-"
                                   Foreground="#58D3B4"
                                   FontSize="13"
                                   Margin="0,3,0,0"/>
                        <TextBlock x:Name="DescriptionText"
                                   Text=""
                                   Foreground="#78958E"
                                   FontSize="9.5"
                                   TextWrapping="Wrap"
                                   MaxHeight="48"
                                   Margin="0,5,20,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#132421"
                            BorderBrush="#315E56"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="MODULES"
                                       Foreground="#78958E"
                                       FontSize="8.5"/>
                            <TextBlock x:Name="ModuleCountText"
                                       Text="0"
                                       Foreground="#F1F8F6"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <DataGrid x:Name="ModulesGrid"
                      Grid.Row="2">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Slot"
                                            Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#132229"
                                        BorderBrush="{Binding SlotAccent}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="6,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Slot}"
                                               Foreground="{Binding SlotAccent}"
                                               FontSize="9"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Module / Item"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Qty"
                                        Binding="{Binding Quantity}"
                                        Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
