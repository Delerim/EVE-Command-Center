<Window x:Class="EveMultiPreview.Views.PilotFitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Command Center - Fit Viewer"
        Width="1060"
        Height="760"
        MinWidth="850"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#080E11"
        Foreground="#EAF7F4"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#15312C"/>
            <Setter Property="BorderBrush" Value="#2D5C53"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <DataTemplate x:Key="ModuleRowTemplate">
            <Border Background="#0E191C"
                    BorderBrush="#1C312E"
                    BorderThickness="0,0,0,1"
                    Padding="7,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="30"
                            Height="30"
                            CornerRadius="5"
                            Background="#132229"
                            BorderBrush="{Binding SlotAccent}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Image Source="{Binding IconUrl}"
                               Stretch="Uniform"/>
                    </Border>

                    <Border Grid.Column="1"
                            Background="#132229"
                            BorderBrush="{Binding SlotAccent}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2"
                            Margin="6,0,8,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Slot}"
                                   Foreground="{Binding SlotAccent}"
                                   FontSize="9"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Name}"
                               Foreground="#E8F2EF"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="3"
                               Text="{Binding Quantity}"
                               Foreground="#78958E"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SectionCard"
               TargetType="Border">
            <Setter Property="Background" Value="#0B1417"/>
            <Setter Property="BorderBrush" Value="#213D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StatCard"
               TargetType="Border">
            <Setter Property="Background" Value="#102022"/>
            <Setter Property="BorderBrush" Value="#264B44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
    </Window.Resources>

    <Border Background="#091114"
            BorderBrush="#28574E"
            BorderThickness="1"
            CornerRadius="14">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#12332D"
                            BorderBrush="#2A5F54"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Margin="0,0,12,0">
                        <TextBlock Text="FIT"
                                   Foreground="#58D3B4"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>

                    <StackPanel>
                        <TextBlock x:Name="FitNameText"
                                   Text="Fit Viewer"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#F1F8F6"/>

                        <TextBlock x:Name="ShipNameText"
                                   Text="-"
                                   Foreground="#58D3B4"
                                   FontSize="9.5"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="X"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#0B1518"
                        BorderBrush="#213E39"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="320"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="SHIP"
                                   Foreground="#78958E"
                                   FontSize="9"
                                   FontWeight="Bold"/>

                        <Border Grid.Row="1"
                                Background="#071013"
                                BorderBrush="#1E3A35"
                                BorderThickness="1"
                                CornerRadius="160"
                                Margin="10"
                                ClipToBounds="True">
                            <Image x:Name="ShipRenderImage"
                                   Stretch="Uniform"
                                   Margin="8"/>
                        </Border>

                        <UniformGrid Grid.Row="2"
                                     Columns="2"
                                     Margin="0,7,0,0">
                            <Border Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="EHP"
                                               Foreground="#78958E"
                                               FontSize="8.5"/>
                                    <TextBlock x:Name="EhpValueText"
                                               Text="--"
                                               Foreground="#8EC9E8"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCard}"
                                    Margin="0">
                                <StackPanel>
                                    <TextBlock Text="MODULE ROWS"
                                               Foreground="#78958E"
                                               FontSize="8.5"/>
                                    <TextBlock x:Name="ModuleCountText"
                                               Text="0"
                                               Foreground="#F1F8F6"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="3"
                                Background="#0D1A1C"
                                BorderBrush="#1D3732"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="BUFFER"
                                           Foreground="#78958E"
                                           FontSize="8.5"/>

                                <TextBlock x:Name="BufferText"
                                           Text="Shield -- | Armor -- | Hull --"
                                           Foreground="#B8CBC6"
                                           FontSize="9.5"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock x:Name="EhpNoteText"
                                           Text=""
                                           Foreground="#78958E"
                                           FontSize="8.5"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DescriptionText"
                                   Grid.Row="4"
                                   Text=""
                                   Foreground="#78958E"
                                   FontSize="9"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="#091315"
                        BorderBrush="#213E39"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border x:Name="HighSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="HIGH SLOTS"
                                               Foreground="#E7B85A"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="2,0,0,6"/>
                                    <ItemsControl x:Name="HighItems"
                                                  ItemTemplate="{StaticResource ModuleRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="MidSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="MID SLOTS"
                                               Foreground="#64C7FF"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="2,0,0,6"/>
                                    <ItemsControl x:Name="MidItems"
                                                  ItemTemplate="{StaticResource ModuleRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="LowSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="LOW SLOTS"
                                               Foreground="#D693FF"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="2,0,0,6"/>
                                    <ItemsControl x:Name="LowItems"
                                                  ItemTemplate="{StaticResource ModuleRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="RigSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="RIGS"
                                               Foreground="#FF8FA6"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="2,0,0,6"/>
                                    <ItemsControl x:Name="RigItems"
                                                  ItemTemplate="{StaticResource ModuleRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DroneSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="DRONES / FIGHTERS"
                                               Foreground="#58D3B4"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="2,0,0,6"/>
                                    <ItemsControl x:Name="DroneItems"
                                                  ItemTemplate="{StaticResource ModuleRowTemplate}"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="OtherSection"
                                    Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="OTHER"
                                               Foreground="#8DA9A2"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Margin="2,0,0,6"/>
                                    <ItemsControl x:Name="OtherItems"
                                                  ItemTemplate="{StaticResource ModuleRowTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
