<Window x:Class="EveMultiPreview.Views.MiningDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE MultiPreview - Mining Dashboard"
        Width="1500" Height="820" MinWidth="1120" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0E1118" Foreground="#E6EDF3">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E1118"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#3B4654"/>
            <Setter Property="CaretBrush" Value="#E6EDF3"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="6,0,18,0"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#161B22"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0E1118"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#21262D"/>
            <Setter Property="RowBackground" Value="#0E1118"/>
            <Setter Property="AlternatingRowBackground" Value="#131923"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#D2A85A"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#31445A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#31445A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Explicit selected-state colours.  This fixes the white selected tab
             that Windows' default WPF theme was applying over our pale text. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D2A85A"/>
                    <Setter Property="Foreground" Value="#0E1118"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#273241"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#D2A85A"/>
                    <Setter Property="Foreground" Value="#0E1118"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Mining Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="#D2A85A"/>
                <TextBlock Text="Stable BASE excludes critical-success spikes. ACTUAL includes them. Idle watchdog tracks missing pulls."
                           Margin="0,3,0,0" Foreground="#8B949E"/>
            </StackPanel>
            <TextBlock x:Name="LastRefreshText" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                       Foreground="#8B949E" Text="Public ESI market data"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Markets:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="JitaCheck" Content="Jita 4-4"/>
                    <CheckBox x:Name="AmarrCheck" Content="Amarr"/>

                    <TextBlock Text="Market price:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MarketPriceModeCombo">
                        <ComboBoxItem Content="Lowest sell" Tag="sell"/>
                        <ComboBoxItem Content="Highest buy" Tag="buy"/>
                    </ComboBox>

                    <Separator Width="1" Height="24" Background="#30363D" Margin="0,0,18,0"/>

                    <TextBlock Text="Corp buyback:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox x:Name="BuybackPercentText" Width="58" Margin="6,0,3,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="% of" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="BuybackMarketCombo" MinWidth="75">
                        <ComboBoxItem Content="Jita" Tag="Jita"/>
                        <ComboBoxItem Content="Amarr" Tag="Amarr"/>
                    </ComboBox>
                    <ComboBox x:Name="BuybackPriceModeCombo">
                        <ComboBoxItem Content="Lowest sell" Tag="sell"/>
                        <ComboBoxItem Content="Highest buy" Tag="buy"/>
                    </ComboBox>
                </WrapPanel>

                <Separator Margin="0,9,0,9" Background="#30363D"/>

                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Idle alarm:" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="IdleWatchdogCheck" Content="Enabled"/>
                    <TextBlock Text="Alert after" VerticalAlignment="Center"/>
                    <TextBox x:Name="IdleSecondsText" Width="58" Margin="6,0,6,0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="seconds without a mining pull" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <CheckBox x:Name="IdleSoundCheck" Content="Play alert sound"/>
                    <TextBlock Text="Uses MultiPreview's existing warning flash, badge, Alert Hub and sound system."
                               Foreground="#8B949E" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="#0E1118" BorderBrush="#30363D">
            <TabItem Header="Overview">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,8">
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="FLEET BASE" Foreground="#8B949E" FontSize="11"/>
                                <TextBlock x:Name="SummaryBaseText" Text="—" Foreground="#D2A85A" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="FLEET ACTUAL" Foreground="#8B949E" FontSize="11"/>
                                <TextBlock x:Name="SummaryActualText" Text="—" Foreground="#D2A85A" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="SESSION VOLUME" Foreground="#8B949E" FontSize="11"/>
                                <TextBlock x:Name="SummarySessionM3Text" Text="—" Foreground="#D2A85A" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="BEST MARKET" Foreground="#8B949E" FontSize="11"/>
                                <TextBlock x:Name="SummaryBestValueText" Text="—" Foreground="#D2A85A" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="CORP BUYBACK" Foreground="#8B949E" FontSize="11"/>
                                <TextBlock x:Name="SummaryBuybackText" Text="—" Foreground="#D2A85A" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="CRITICALS" Foreground="#8B949E" FontSize="11"/>
                                <TextBlock x:Name="SummaryCritText" Text="—" Foreground="#D2A85A" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Character breakdown" Foreground="#D2A85A" Margin="0,0,5,0">
                            <DataGrid x:Name="OverviewCharacterGrid" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="150"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                    <DataGridTextColumn Header="Current ore" Binding="{Binding Ore}" Width="170"/>
                                    <DataGridTextColumn Header="Session m³" Binding="{Binding SessionM3Text}" Width="105"/>
                                    <DataGridTextColumn Header="Jita" Binding="{Binding JitaValueText}" Width="95"/>
                                    <DataGridTextColumn Header="Amarr" Binding="{Binding AmarrValueText}" Width="95"/>
                                    <DataGridTextColumn Header="Best" Binding="{Binding BestValueText}" Width="95"/>
                                    <DataGridTextColumn Header="Corp" Binding="{Binding CorpValueText}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Ore breakdown" Foreground="#D2A85A" Margin="5,0,0,0">
                            <DataGrid x:Name="OverviewOreGrid" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="*"/>
                                    <DataGridTextColumn Header="Units" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="95"/>
                                    <DataGridTextColumn Header="m³" Binding="{Binding VolumeM3Text}" Width="95"/>
                                    <DataGridTextColumn Header="Best" Binding="{Binding BestValueText}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Live Mining">
                <DataGrid x:Name="LiveGrid" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82"/>
                        <DataGridTextColumn Header="Last pull" Binding="{Binding LastPull}" Width="82"/>
                        <DataGridTextColumn Header="Current ore" Binding="{Binding Ore}" Width="175"/>
                        <DataGridTextColumn Header="BASE m³/s" Binding="{Binding BaseM3PerSec, StringFormat={}{0:N1}}" Width="95"/>
                        <DataGridTextColumn Header="ACTUAL m³/s" Binding="{Binding ActualM3PerSecText}" Width="105"/>
                        <DataGridTextColumn Header="Crits" Binding="{Binding Crits}" Width="95"/>
                        <DataGridTextColumn Header="Session m³" Binding="{Binding SessionM3, StringFormat={}{0:N0}}" Width="105"/>
                        <DataGridTextColumn Header="Jita ISK/h" Binding="{Binding JitaIskPerHourText}" Width="105"/>
                        <DataGridTextColumn Header="Amarr ISK/h" Binding="{Binding AmarrIskPerHourText}" Width="105"/>
                        <DataGridTextColumn Header="Best ISK/h" Binding="{Binding BestIskPerHourText}" Width="105"/>
                        <DataGridTextColumn Header="Corp session" Binding="{Binding CorpSessionText}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Market / Ore">
                <DataGrid x:Name="MarketGrid" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="220"/>
                        <DataGridTextColumn Header="Units" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="110"/>
                        <DataGridTextColumn Header="Volume m³" Binding="{Binding VolumeM3Text}" Width="115"/>
                        <DataGridTextColumn Header="Jita / unit" Binding="{Binding JitaUnitText}" Width="115"/>
                        <DataGridTextColumn Header="Amarr / unit" Binding="{Binding AmarrUnitText}" Width="115"/>
                        <DataGridTextColumn Header="Best market" Binding="{Binding BestMarket}" Width="105"/>
                        <DataGridTextColumn Header="Jita session" Binding="{Binding JitaValueText}" Width="120"/>
                        <DataGridTextColumn Header="Amarr session" Binding="{Binding AmarrValueText}" Width="120"/>
                        <DataGridTextColumn Header="Best session" Binding="{Binding BestValueText}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Corp Buyback">
                <DataGrid x:Name="BuybackGrid" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="240"/>
                        <DataGridTextColumn Header="Units" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="115"/>
                        <DataGridTextColumn Header="Reference / unit" Binding="{Binding ReferenceUnitText}" Width="135"/>
                        <DataGridTextColumn Header="Gross market" Binding="{Binding GrossText}" Width="135"/>
                        <DataGridTextColumn Header="Buyback rate" Binding="{Binding RateText}" Width="105"/>
                        <DataGridTextColumn Header="Corp payout" Binding="{Binding PayoutText}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="2,9,0,0" Foreground="#8B949E"
                   Text="Prices: public ESI station orders, cached for 5 minutes. No EVE login or ESI character token is used."/>
    </Grid>
</Window>

