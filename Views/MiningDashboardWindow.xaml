                            <ComboBox x:Name="MarketOreFilterCombo" MinWidth="165">
                                <ComboBoxItem Content="All high-sec" Tag="myhs"/>
                                <ComboBoxItem Content="Moon - R4" Tag="r4"/>
                                <ComboBoxItem Content="Amarr belts" Tag="amarrbelt"/>
                                <ComboBoxItem Content="High-sec anomaly - Omber / Kernite" Tag="omberkernite"/>
                                <ComboBoxItem Content="Escalation - Mordunium" Tag="mordunium"/>
                            </ComboBox>
                            <TextBlock Text="Filters the market decision tables only."
                                       Foreground="#78958E"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="1"
                                   Margin="4,1,4,8"
                                   Foreground="#78958E"
                                   FontSize="10.5"
                                   Text="Live Jita 4-4 / Amarr station orders. Historical timing uses ESI regional history (The Forge / Domain)."/>

                        <DataGrid Grid.Row="2" x:Name="MarketGrid" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="180"/>
                                <DataGridTextColumn Header="Today units" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="95"/>
                                <DataGridTextColumn Header="Jita sell" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding JitaSellText}" Width="95"/>
                                <DataGridTextColumn Header="Jita buy" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding JitaBuyText}" Width="95"/>
                                <DataGridTextColumn Header="Amarr sell" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding AmarrSellText}" Width="95"/>
                                <DataGridTextColumn Header="Amarr buy" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding AmarrBuyText}" Width="95"/>
                                <DataGridTextColumn Header="Best sell" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding BestSellText}" Width="100"/>
                                <DataGridTextColumn Header="Best market" Binding="{Binding BestMarket}" Width="90"/>
                                <DataGridTextColumn Header="30d avg" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding Average30Text}" Width="95"/>
                                <DataGridTemplateColumn Header="Advice" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Signal}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#78958E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Signal}" Value="SELL">
                                                                <Setter Property="Foreground" Value="#76E39A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Signal}" Value="HOLD">
                                                                <Setter Property="Foreground" Value="#58D3B4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Signal}" Value="WAIT">
                                                                <Setter Property="Foreground" Value="#E7B85A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Why" Binding="{Binding SignalReason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="WhatToMineTab" Header="What should I mine?">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="4,0,4,7">
                            <TextBlock Text="SOURCE FILTER" Foreground="#6FAE9D" FontSize="9.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"/>
                            <ComboBox x:Name="WhatToMineOreFilterCombo" MinWidth="165">
                                <ComboBoxItem Content="All high-sec" Tag="myhs"/>
                                <ComboBoxItem Content="Moon - R4" Tag="r4"/>
                                <ComboBoxItem Content="Amarr belts" Tag="amarrbelt"/>
                                <ComboBoxItem Content="High-sec anomaly - Omber / Kernite" Tag="omberkernite"/>
                                <ComboBoxItem Content="Escalation - Mordunium" Tag="mordunium"/>
                            </ComboBox>
                            <TextBlock Text="Sorted by current best sell ISK/m3. Liquidity is shown separately so thin markets are obvious."
                                       Foreground="#78958E"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,7">
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="TOP VALUE ORE" Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="WhatToMineTopOreText" Text="-" Foreground="#58D3B4"
                                               FontSize="17" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="TOP VALUE" Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="WhatToMineTopValueText" Text="-" Foreground="#58D3B4"
                                               FontSize="17" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="TODAY BB OPPORTUNITY COST" Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="WhatToMineOpportunityText" Text="-" Foreground="#E7B85A"
                                               FontSize="17" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="FLEET CONTINUITY TODAY" Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="WhatToMineContinuityText" Text="-" Foreground="#58D3B4"
                                               FontSize="17" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DataGrid Grid.Row="2" x:Name="WhatToMineGrid" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding Rank}" Width="40"/>
                                <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="175"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="95"/>
                                <DataGridTextColumn Header="Best hub" Binding="{Binding BestMarket}" Width="75"/>
                                <DataGridTextColumn Header="Sell / unit" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding BestSellText}" Width="95"/>
                                <DataGridTextColumn Header="ISK/m3" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding BestIskM3Text}" Width="90"/>
                                <DataGridTextColumn Header="Corp BB/m3" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding CorpBbIskM3Text}" Width="95"/>
                                <DataGridTextColumn Header="BB gap/m3" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding BbGapText}" Width="115"/>
                                <DataGridTextColumn Header="30d avg" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding Average30Text}" Width="95"/>
                                <DataGridTextColumn Header="30d m3/day" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding AvgDailyM3Text}" Width="105"/>
                                <DataGridTextColumn Header="Your load/day" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding MarketLoadText}" Width="95"/>
                                <DataGridTemplateColumn Header="Advice" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Advice}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#78958E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Advice}" Value="SELL">
                                                                <Setter Property="Foreground" Value="#76E39A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Advice}" Value="HOLD">
                                                                <Setter Property="Foreground" Value="#58D3B4"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Advice}" Value="WAIT">
                                                                <Setter Property="Foreground" Value="#E7B85A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Corp Buyback">
                    <DataGrid x:Name="BuybackGrid" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="240"/>
                            <DataGridTextColumn Header="Units today" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="115"/>
                            <DataGridTextColumn Header="Reference / unit" Binding="{Binding ReferenceUnitText}" Width="135"/>
                            <DataGridTextColumn Header="Gross market" Binding="{Binding GrossText}" Width="135"/>
                            <DataGridTextColumn Header="Buyback rate" Binding="{Binding RateText}" Width="105"/>
                            <DataGridTextColumn Header="Corp payout" Binding="{Binding PayoutText}" Width="145"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem x:Name="HistoryTab" Header="History">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,7">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Range" Foreground="#58D3B4" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Button x:Name="HistoryTodayButton" Content="Today"/>
                                    <Button x:Name="HistoryYesterdayButton" Content="Yesterday"/>
                                    <Button x:Name="HistoryThisWeekButton" Content="This Week"/>
                                    <Button x:Name="HistoryLastWeekButton" Content="Last Week"/>
                                    <Button x:Name="HistoryThisMonthButton" Content="This Month"/>
                                    <Button x:Name="HistoryLastMonthButton" Content="Last Month"/>
                                    <Button x:Name="History30Button" Content="30 Days"/>
                                    <Button x:Name="History90Button" Content="90 Days"/>
                                    <Button x:Name="HistoryYearButton" Content="1 Year"/>
                                    <Button x:Name="HistoryRefreshButton" Content="Refresh"/>
                                </WrapPanel>
                                <Grid Margin="3,7,3,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HistoryRangeText"
                                               Grid.Column="0"
                                               Foreground="#DCEAE6"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HistoryBuildText"
                                               Grid.Column="2"
                                               Foreground="#78958E"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,7">
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="VOLUME" Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="HistoryVolumeText" Text="-" Foreground="#58D3B4"
                                               FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="PROFIT EST." Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="HistoryProfitText" Text="-" Foreground="#58D3B4"
                                               FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="CORP BB EST." Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="HistoryBuybackText" Text="-" Foreground="#58D3B4"
                                               FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SummaryCard}">
                                <StackPanel>
                                    <TextBlock Text="CRITICALS" Foreground="#78958E" FontSize="10"/>
                                    <TextBlock x:Name="HistoryCritText" Text="-" Foreground="#58D3B4"
                                               FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DataGrid Grid.Row="2" x:Name="HistoryGrid" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mining day" Binding="{Binding Day}" Width="105"/>
                                <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="150"/>
                                <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="190"/>
                                <DataGridTextColumn Header="Units" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding UnitsText}" Width="105"/>
                                <DataGridTextColumn Header="m3" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding VolumeText}" Width="105"/>
                                <DataGridTextColumn Header="Crits" CellStyle="{StaticResource CenterGridCell}" Binding="{Binding CritText}" Width="105"/>
                                <DataGridTextColumn Header="Profit est." CellStyle="{StaticResource CenterGridCell}" Binding="{Binding ProfitText}" Width="115"/>
                                <DataGridTextColumn Header="BB est." Binding="{Binding BuybackText}" Width="115"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="3"
                    Background="#091316"
                    BorderBrush="#18302C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Margin="0,10,0,0">
                <TextBlock Foreground="#637E78"
                           FontSize="9.5"
                           Text="Mining day 04:00 local - 03:59 next day  |  Historical quantities are exact  |  Historical ISK uses the currently selected market prices."/>
            </Border>
        </Grid>
    </Border>
</Window>
