<Window x:Class="EveMultiPreview.Views.MiningDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE MultiPreview - Mining Dashboard"
        Width="1500" Height="820" MinWidth="1120" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0D1417" Foreground="#EAF7F4">
    <Window.Resources>
        <SolidColorBrush x:Key="Teal" Color="#39C6A4"/>
        <SolidColorBrush x:Key="Panel" Color="#131C20"/>
        <SolidColorBrush x:Key="Panel2" Color="#182328"/>
        <SolidColorBrush x:Key="GridLine" Color="#26363B"/>
        <SolidColorBrush x:Key="Muted" Color="#809A95"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF7F4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F171A"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
            <Setter Property="CaretBrush" Value="#EAF7F4"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Keep ComboBoxes conventional/light so the selected value is always
             readable. The previous dark style inherited Windows' white selection
             chrome and produced white-on-white text. -->
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="6,0,18,0"/>
            <Setter Property="Foreground" Value="#10201D"/>
            <Setter Property="Background" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="Background" Value="#131C20"/>
            <Setter Property="Padding" Value="7,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#247A68"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2B8F7B"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B3D38"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#286B5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1417"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#26363B"/>
            <Setter Property="RowBackground" Value="#0D1417"/>
            <Setter Property="AlternatingRowBackground" Value="#111B1F"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#162226"/>
            <Setter Property="Foreground" Value="#58D3B4"/>
            <Setter Property="BorderBrush" Value="#26363B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#245E55"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#245E55"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Full custom tab template: avoids Windows drawing a white selected tab. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#CFE4DF"/>
            <Setter Property="Background" Value="#121B1F"/>
            <Setter Property="BorderBrush" Value="#2C4843"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1F4B43"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2B8F7B"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#58D3B4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="#131C20"/>
            <Setter Property="BorderBrush" Value="#2A665B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#58D3B4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Mining Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="#58D3B4"/>
                <TextBlock Text="Stable BASE excludes crit spikes. ACTUAL includes them. TODAY persists across restarts until the 04:00 mining-day rollover."
                           Margin="0,3,0,0" Foreground="#809A95"/>
            </StackPanel>
            <TextBlock x:Name="LastRefreshText" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                       Foreground="#809A95" Text="Public ESI market data"/>
        </DockPanel>

        <Border Grid.Row="1" Background="#131C20" BorderBrush="#2A665B" BorderThickness="1"
                CornerRadius="7" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Markets:" FontWeight="SemiBold" Foreground="#58D3B4"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="JitaCheck" Content="Jita 4-4"/>
                    <CheckBox x:Name="AmarrCheck" Content="Amarr"/>

                    <TextBlock Text="Market price:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MarketPriceModeCombo">
                        <ComboBoxItem Content="Lowest sell" Tag="sell"/>
                        <ComboBoxItem Content="Highest buy" Tag="buy"/>
                    </ComboBox>

                    <TextBlock Text="Corp buyback:" FontWeight="SemiBold" Foreground="#58D3B4"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="BuybackPercentText" Width="58" Margin="6,0,3,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="% of" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="BuybackMarketCombo" MinWidth="78">
                        <ComboBoxItem Content="Jita" Tag="Jita"/>
                        <ComboBoxItem Content="Amarr" Tag="Amarr"/>
                    </ComboBox>
                    <ComboBox x:Name="BuybackPriceModeCombo">
                        <ComboBoxItem Content="Lowest sell" Tag="sell"/>
                        <ComboBoxItem Content="Highest buy" Tag="buy"/>
                    </ComboBox>
                </WrapPanel>

                <Separator Margin="0,9,0,9" Background="#2A665B"/>

                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Mining alarms:" FontWeight="SemiBold" Foreground="#58D3B4"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="IdleWatchdogCheck" Content="No-pull"/>
                    <TextBlock Text="after" VerticalAlignment="Center"/>
                    <TextBox x:Name="IdleSecondsText" Width="54" Margin="6,0,6,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <CheckBox x:Name="YieldDropCheck" Content="Yield drop"/>
                    <TextBlock Text=">" VerticalAlignment="Center"/>
                    <TextBox x:Name="YieldDropPercentText" Width="44" Margin="6,0,3,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="%" VerticalAlignment="Center"/>
                    <TextBlock Text="for" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox x:Name="YieldDropSecondsText" Width="44" Margin="6,0,3,0"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <CheckBox x:Name="IdleSoundCheck" Content="Sound"/>

                    <TextBlock Text="Overview:" FontWeight="SemiBold" Foreground="#58D3B4"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox x:Name="AutoOverviewCheck" Content="Auto-show on launch"/>
                    <CheckBox x:Name="TileWallCheck"
                              Content="Use tile wall instead of individual mining boxes (restart)"/>
                    <Button x:Name="ToggleOverviewButton" Content="Show / hide tile wall"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="#0D1417" BorderBrush="#39796C">
            <TabItem Header="Overview">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,8">
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="FLEET BASE" Foreground="#809A95" FontSize="11"/>
                                <TextBlock x:Name="SummaryBaseText" Text="â€”" Foreground="#58D3B4"
                                           FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="FLEET ACTUAL" Foreground="#809A95" FontSize="11"/>
                                <TextBlock x:Name="SummaryActualText" Text="â€”" Foreground="#58D3B4"
                                           FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="TODAY VOLUME" Foreground="#809A95" FontSize="11"/>
                                <TextBlock x:Name="SummarySessionM3Text" Text="â€”" Foreground="#58D3B4"
                                           FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="BEST MARKET TODAY" Foreground="#809A95" FontSize="11"/>
                                <TextBlock x:Name="SummaryBestValueText" Text="â€”" Foreground="#58D3B4"
                                           FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="CORP BUYBACK TODAY" Foreground="#809A95" FontSize="11"/>
                                <TextBlock x:Name="SummaryBuybackText" Text="â€”" Foreground="#58D3B4"
                                           FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SummaryCard}">
                            <StackPanel>
                                <TextBlock Text="TODAY CRITICALS" Foreground="#809A95" FontSize="11"/>
                                <TextBlock x:Name="SummaryCritText" Text="â€”" Foreground="#58D3B4"
                                           FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Character breakdown" Margin="0,0,5,0">
                            <DataGrid x:Name="OverviewCharacterGrid" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="150"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="88"/>
                                    <DataGridTextColumn Header="Current ore" Binding="{Binding Ore}" Width="170"/>
                                    <DataGridTextColumn Header="Today mÂ³" Binding="{Binding SessionM3Text}" Width="105"/>
                                    <DataGridTextColumn Header="Jita" Binding="{Binding JitaValueText}" Width="95"/>
                                    <DataGridTextColumn Header="Amarr" Binding="{Binding AmarrValueText}" Width="95"/>
                                    <DataGridTextColumn Header="Best" Binding="{Binding BestValueText}" Width="95"/>
                                    <DataGridTextColumn Header="Corp" Binding="{Binding CorpValueText}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Today's ore breakdown" Margin="5,0,0,0">
                            <DataGrid x:Name="OverviewOreGrid" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="*"/>
                                    <DataGridTextColumn Header="Units" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="95"/>
                                    <DataGridTextColumn Header="mÂ³" Binding="{Binding VolumeM3Text}" Width="95"/>
                                    <DataGridTextColumn Header="Best" Binding="{Binding BestValueText}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Live Mining">
                <DataGrid x:Name="LiveGrid" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Character" Binding="{Binding Character}" Width="150"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Last pull" Binding="{Binding LastPull}" Width="82"/>
                        <DataGridTextColumn Header="Current ore" Binding="{Binding Ore}" Width="175"/>
                        <DataGridTextColumn Header="BASE mÂ³/s" Binding="{Binding BaseM3PerSec, StringFormat={}{0:N1}}" Width="95"/>
                        <DataGridTextColumn Header="ACTUAL mÂ³/s" Binding="{Binding ActualM3PerSecText}" Width="105"/>
                        <DataGridTextColumn Header="Today crits" Binding="{Binding Crits}" Width="105"/>
                        <DataGridTextColumn Header="Today mÂ³" Binding="{Binding SessionM3, StringFormat={}{0:N0}}" Width="105"/>
                        <DataGridTextColumn Header="Jita ISK/h" Binding="{Binding JitaIskPerHourText}" Width="105"/>
                        <DataGridTextColumn Header="Amarr ISK/h" Binding="{Binding AmarrIskPerHourText}" Width="105"/>
                        <DataGridTextColumn Header="Best ISK/h" Binding="{Binding BestIskPerHourText}" Width="105"/>
                        <DataGridTextColumn Header="Corp today" Binding="{Binding CorpSessionText}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Market / Ore">
                <DataGrid x:Name="MarketGrid" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="220"/>
                        <DataGridTextColumn Header="Units today" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="110"/>
                        <DataGridTextColumn Header="Volume mÂ³" Binding="{Binding VolumeM3Text}" Width="115"/>
                        <DataGridTextColumn Header="Jita / unit" Binding="{Binding JitaUnitText}" Width="115"/>
                        <DataGridTextColumn Header="Amarr / unit" Binding="{Binding AmarrUnitText}" Width="115"/>
                        <DataGridTextColumn Header="Best market" Binding="{Binding BestMarket}" Width="105"/>
                        <DataGridTextColumn Header="Jita today" Binding="{Binding JitaValueText}" Width="120"/>
                        <DataGridTextColumn Header="Amarr today" Binding="{Binding AmarrValueText}" Width="120"/>
                        <DataGridTextColumn Header="Best today" Binding="{Binding BestValueText}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Corp Buyback">
                <DataGrid x:Name="BuybackGrid" AlternationCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ore" Binding="{Binding Ore}" Width="240"/>
                        <DataGridTextColumn Header="Units today" Binding="{Binding Units, StringFormat={}{0:N0}}" Width="115"/>
                        <DataGridTextColumn Header="Reference / unit" Binding="{Binding ReferenceUnitText}" Width="135"/>
                        <DataGridTextColumn Header="Gross market" Binding="{Binding GrossText}" Width="135"/>
                        <DataGridTextColumn Header="Buyback rate" Binding="{Binding RateText}" Width="105"/>
                        <DataGridTextColumn Header="Corp payout" Binding="{Binding PayoutText}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Margin="2,9,0,0" Foreground="#809A95"
                   Text="Mining day: 04:00 local â†’ 03:59 next day. Data is stored locally in MiningData/*.jsonl. Prices: public ESI, cached 5 minutes."/>
    </Grid>
</Window>
