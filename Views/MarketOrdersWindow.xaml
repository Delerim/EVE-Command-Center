<Window x:Class="EveCommandCenter.Views.MarketOrdersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EVE Command Center | Market" Width="1480" Height="960" Background="#07181B" Foreground="#DDF6F4">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B9D8D8"/></Style>
 </ResourceDictionary></Window.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="MARKET COMMAND CENTER" FontSize="26" Foreground="#55D7D2" FontWeight="Bold"/>
   <TextBlock Text="Personal open orders • cached observations, not a spending or profit ledger" Margin="0,6,0,12"/>
   <Expander Header="CHOOSE MARKET CHARACTERS" Foreground="#74D6C9" IsExpanded="True">
    <StackPanel><ItemsControl x:Name="Characters"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay}" Foreground="#DDF6F4" Margin="4,8,16,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
   </Expander>
   <WrapPanel Margin="0,10"><Button x:Name="RefreshButton" Content="SAVE SELECTION / REFRESH WHEN DUE" Click="Refresh_Click"/><TextBox x:Name="Search" Width="230" Margin="12,0" TextChanged="Search_Changed" ToolTip="Filter item name, order ID or character"/></WrapPanel>
   <Border Background="#102D31" BorderBrush="#74D6C9" BorderThickness="0,2,0,0" Padding="12"><TextBlock x:Name="Totals" FontSize="16" TextWrapping="Wrap"/></Border>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#FFD166" Margin="0,10"/>
   <TabControl x:Name="SideTabs" SelectionChanged="Side_Changed" Background="#07181B" BorderBrush="#245058"><TabItem Header="OPEN BUY ORDERS" Tag="buy"/><TabItem Header="OPEN SELL ORDERS" Tag="sell"/></TabControl>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="Refresh respects ESI's cache (normally 20 minutes). Location IDs are shown where names are unavailable. Corporation orders are excluded. Order disappearance is not treated as a fill; history, transactions and project attribution follow in later increments." TextWrapping="Wrap" Margin="0,10"/>
  <DataGrid x:Name="Orders" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" MinRowHeight="42" Background="#07181B" RowBackground="#0C2529" AlternatingRowBackground="#102D31" Foreground="#DDF6F4" BorderBrush="#245058" HeadersVisibility="Column">
   <DataGrid.Columns>
    <DataGridTextColumn Header="ITEM" Binding="{Binding Order.Name}" Width="2*"/>
    <DataGridTextColumn Header="CHARACTER" Binding="{Binding Owner}" Width="150"/>
    <DataGridTextColumn Header="PRICE / UNIT" Binding="{Binding Order.Price, StringFormat=N2}" Width="120"/>
    <DataGridTextColumn Header="ORIGINAL" Binding="{Binding Order.Total, StringFormat=N0}" Width="90"/>
    <DataGridTextColumn Header="REMAINING" Binding="{Binding Order.Remaining, StringFormat=N0}" Width="100"/>
    <DataGridTextColumn Header="REMAINING VALUE" Binding="{Binding Order.RemainingValue, StringFormat=N2}" Width="140"/>
    <DataGridTextColumn Header="LOCATION" Binding="{Binding Order.LocationId}" Width="115"/>
    <DataGridTextColumn Header="EXPIRES" Binding="{Binding Order.Expiry}" Width="150"/>
    <DataGridTextColumn Header="ORDER ID" Binding="{Binding Order.OrderId}" Width="110"/>
    <DataGridTextColumn Header="SNAPSHOT" Binding="{Binding Freshness}" Width="180"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
