 <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="13,8"/><Setter Property="Background" Value="#1B3B3F"/><Setter Property="Foreground" Value="#E5F1F2"/><Setter Property="BorderBrush" Value="#3B6268"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#2A555A"/><Setter TargetName="Shell" Property="BorderBrush" Value="#76D7CB"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#35746C"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#A2F5E8"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="#0A1B1F"/><Setter Property="Foreground" Value="#E5F1F2"/><Setter Property="CaretBrush" Value="#A2F5E8"/><Setter Property="BorderBrush" Value="#355258"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Shell" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#76D7CB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#57858C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="WorkspaceCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="3"/><Setter Property="MinWidth" Value="150"/><Setter Property="MinHeight" Value="34"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C6DDDE"/><Setter Property="Margin" Value="8"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style TargetType="TabItem"><Setter Property="Foreground" Value="#9FB9BC"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Shell" CornerRadius="7,7,0,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1C343A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#1A393D"/><Setter TargetName="Shell" Property="BorderBrush" Value="#76D7CB"/><Setter Property="Foreground" Value="#ECFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#A2F5E8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="Background" Value="#0C1F23"/><Setter Property="Foreground" Value="#E5F1F2"/><Setter Property="RowBackground" Value="#10282C"/><Setter Property="AlternatingRowBackground" Value="#122C30"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="MinRowHeight" Value="44"/><Setter Property="FontSize" Value="12"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#223C42"/><Setter Property="BorderBrush" Value="#28454A"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1B363B"/><Setter Property="Foreground" Value="#A8C4C8"/><Setter Property="Padding" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="Padding" Value="9,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D9EAEC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGridRow"><Setter Property="Background" Value="#10282C"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#23464D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#28645D"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#76D7CB"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Shell" Background="#10282C" BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="6" Margin="2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#23464D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Shell" Property="Background" Value="#245950"/><Setter TargetName="Shell" Property="BorderBrush" Value="#76D7CB"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#A2F5E8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Expander"><Setter Property="Foreground" Value="#AAC7CA"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton x:Name="HeaderToggle" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left" Cursor="Hand"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderShell" CornerRadius="5" Background="Transparent" Padding="4,8"><DockPanel><Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="#8AB6BA" StrokeThickness="1.5" Margin="0,0,10,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></DockPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderShell" Property="Background" Value="#1D3B42"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderShell" Property="Background" Value="#245950"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Body" Visibility="Collapsed"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="ComponentTreeItem" TargetType="TreeViewItem">
  <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding Selected, Mode=OneWay}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem"><StackPanel>
   <Border x:Name="Row" Background="Transparent" CornerRadius="7" Margin="2" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="3,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ToggleButton x:Name="Expand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Width="22" Height="28"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="#8AB6BA" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch"/>
   </Grid></Border><ItemsPresenter x:Name="Children" Margin="18,0,0,0"/></StackPanel><ControlTemplate.Triggers>
    <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#1D3B42"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#245950"/><Setter TargetName="Row" Property="BorderBrush" Value="#76D7CB"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#B5FFF2"/></Trigger>
    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expand" Property="Visibility" Value="Hidden"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>