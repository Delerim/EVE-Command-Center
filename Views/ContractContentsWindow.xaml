<Window x:Class="EveCommandCenter.Views.ContractContentsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EVE Command Center - Contract contents" Width="1060" Height="750" MinWidth="860" MinHeight="560"
 Background="#07181B" Foreground="#EAF7F7" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="CONTRACT CONTENTS" Foreground="#55D7D2" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="IssuerText" FontSize="26" Foreground="#EAF7F7" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock x:Name="TitleText" Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <Border x:Name="CheckBorder" Grid.Row="1" Background="#0C2529" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
   <StackPanel><TextBlock x:Name="ResultText" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="ChecksText" Foreground="#EAF7F7" Margin="0,6,0,0"/><TextBlock x:Name="ReasonText" Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="LocationText" Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
  </Border>
  <DockPanel Grid.Row="2" Margin="0,0,0,12"><TextBox x:Name="ItemSearchBox" Width="300" TextChanged="Search_Changed" ToolTip="Search items"/><TextBlock x:Name="TotalsText" Foreground="#74D6C9" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
  <DataGrid x:Name="ItemsGrid" Grid.Row="3" AlternationCount="2">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image Source="{Binding Icon}" Width="36" Height="36" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="2*"/>
    <DataGridTextColumn Header="QUANTITY" Binding="{Binding Quantity, StringFormat=N0}" Width="*"/>
    <DataGridTextColumn Header="DIRECTION" Binding="{Binding Direction}" Width="*"/>
    <DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="*"/>
    <DataGridTextColumn Header="VOLUME m3" Binding="{Binding Volume, StringFormat=N2}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0">
   <TextBlock x:Name="StatusText" Text="Loading contract contents..." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <DockPanel><Button x:Name="RetryButton" Content="RETRY CONTENTS" Click="Retry_Click"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="VIEW JANICE" Click="Janice_Click" Margin="0,0,8,0"/><Button Content="OPEN IN GAME" Click="Game_Click" Background="#17656A" BorderBrush="#55D7D2"/></StackPanel></DockPanel>
  </StackPanel>
 </Grid>
</Window>
