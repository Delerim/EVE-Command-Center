<Window x:Class="EveMultiPreview.Views.MiningFleetOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mining Overview"
        Width="1780" Height="182" MinWidth="600" MinHeight="142"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#17312D"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#F20B1416" BorderBrush="#2C6D60" BorderThickness="1"
            CornerRadius="8" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,6"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="MINER OVERVIEW"
                           Foreground="#F1F7F5"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Background="#14352F"
                        BorderBrush="#2F7466"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="LIVE + TODAY"
                               Foreground="#58D3B4"
                               FontWeight="SemiBold"
                               FontSize="11.5"/>
                </Border>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="DayText"
                               Foreground="#7EA99F"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Left"/>

                    <Border x:Name="PlexMarketBorder"
                            Background="#101D20"
                            BorderBrush="#315E67"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,2"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Loading PLEX market...">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="PLEX"
                                       Foreground="#8EC9E8"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="BUY "
                                       Foreground="#718D87"
                                       FontSize="10.5"/>

                            <TextBlock x:Name="PlexBuyText"
                                       Text="--"
                                       Foreground="#EAF7F4"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="  |  SELL "
                                       Foreground="#718D87"
                                       FontSize="10.5"/>

                            <TextBlock x:Name="PlexSellText"
                                       Text="--"
                                       Foreground="#EAF7F4"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,2,0">
                    <Button Content="MINING"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Click="OpenMiningCommandCenter_Click"
                            ToolTip="Open Mining Command Center"/>

                    <Button Content="PILOTS"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="4,0,0,0"
                            Click="OpenPilotCommandCenter_Click"
                            ToolTip="Open Pilot Command Center"/>

                    <Button x:Name="OrderButton"
                            Content="ORDER"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="4,0,0,0"
                            Click="OrderMode_Click"
                            MouseRightButtonUp="OrderButton_MouseRightButtonUp"
                            ToolTip="Click to enable tile reordering, drag tiles left/right, then click DONE. Right-click to reset."/>
                </StackPanel>

                <TextBlock x:Name="UpdatedText"
                           Grid.Column="5"
                           Foreground="#6F8F88"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0"
                           TextAlignment="Right"/>

                <Button Grid.Column="6"
                        Content="X"
                        Width="25"
                        Height="21"
                        Click="Close_Click"
                        Margin="5,0,0,0"/>
            </Grid>

            <ScrollViewer x:Name="MinerScroll"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl x:Name="MinerItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding CardWidth}" MinHeight="128"
                                    VerticalAlignment="Top"
                                    CornerRadius="7" BorderThickness="1.5"
                                    Padding="8,6" Margin="0,0,6,0"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tile_PreviewMouseMove"
                                    DragOver="Tile_DragOver"
                                    Drop="Tile_Drop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#39796C"/>
                                        <Setter Property="Background" Value="#111D1C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="MINING">
                                                <Setter Property="BorderBrush" Value="#38BE91"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                <Setter Property="BorderBrush" Value="#D8A84A"/>
                                                <Setter Property="Background" Value="#2A2418"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                <Setter Property="BorderBrush" Value="#EF963E"/>
                                                <Setter Property="Background" Value="#332019"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="IDLE">
                                                <Setter Property="BorderBrush" Value="#E85C66"/>
                                                <Setter Property="Background" Value="#351B20"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="MUTED">
                                                <Setter Property="BorderBrush" Value="#647D84"/>
                                                <Setter Property="Background" Value="#162124"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="15"
                                                ClipToBounds="True"
                                                Background="#142321"
                                                BorderBrush="#315E56"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding PortraitUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="5,0,0,0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Ore}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="#58D3B4"
                                                           FontSize="11.5"
                                                           Margin="5,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OreToolTip}"/>

                                                <TextBlock Text="{Binding Character}"
                                                           Foreground="#F4F8F7"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <TextBlock Text="{Binding ShipText}"
                                                       Foreground="#8DA9A2"
                                                       FontSize="9.5"
                                                       Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ShipToolTip}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="BASE"/>
                                            <TextBlock Text="{Binding BaseText}" Foreground="#FFFFFF"
                                                       FontWeight="Bold" FontSize="13.5"
                                                       ToolTip="{Binding BaseToolTip}"/>
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="PROFIT"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ValueText}" Foreground="#58D3B4"
                                                       FontWeight="SemiBold" FontSize="12.5"
                                                       ToolTip="{Binding ProfitToolTip}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="REAL"/>
                                            <TextBlock Text="{Binding ActualText}" Foreground="#EAF7F4"
                                                       FontWeight="Bold" FontSize="13.5"
                                                       ToolTip="{Binding RealToolTip}"/>
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="BB"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding BuybackText}" Foreground="#58D3B4"
                                                       FontWeight="SemiBold" FontSize="12.5"
                                                       ToolTip="{Binding BuybackToolTip}"/>
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Grid.Row="2" Margin="0,3,0,0"
                                               ToolTip="{Binding CritToolTip}">
                                        <TextBlock Text="CRIT " Foreground="#718D87" FontSize="10.5"/>
                                        <TextBlock Text="{Binding CritText}" Foreground="#C8D8D4" FontSize="11.5"/>
                                    </DockPanel>

                                    <Grid Grid.Row="3"
                                          Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Foreground="#7FDCC5"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LaserToolTip}">
                                            <Run Text="{Binding LaserPrimaryText}"
                                                 Foreground="#7FDCC5"/>
                                            <Run Text="{Binding LaserPrimaryCrystal}"
                                                 Foreground="#64C7FF"
                                                 FontWeight="Bold"/>
                                            <Run Text="{Binding LaserSecondaryText}"
                                                 Foreground="#7FDCC5"/>
                                            <Run Text="{Binding LaserSecondaryCrystal}"
                                                 Foreground="#64C7FF"
                                                 FontWeight="Bold"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding EhpText}"
                                                   Foreground="#8EC9E8"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding EhpToolTip}"/>
                                    </Grid>

                                    <Grid Grid.Row="4" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusToolTip}"
                                                   Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#38BE91"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                            <Setter Property="Foreground" Value="#D8A84A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                            <Setter Property="Foreground" Value="#EF963E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="IDLE">
                                                            <Setter Property="Foreground" Value="#E85C66"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="WAITING">
                                                            <Setter Property="Foreground" Value="#718D87"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="MUTED">
                                                            <Setter Property="Foreground" Value="#91A8AE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Content="{Binding BoostButtonText}"
                                                    Tag="{Binding Character}"
                                                    Click="OrcaBoostToggle_Click"
                                                    ToolTip="{Binding BoostToolTip}"
                                                    FontSize="8.5"
                                                    MinHeight="21"
                                                    MinWidth="52"
                                                    Padding="5,1"
                                                    Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Background" Value="#172126"/>
                                                        <Setter Property="Foreground" Value="#8DA9A2"/>
                                                        <Setter Property="BorderBrush" Value="#41535A"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Cursor" Value="Hand"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDroneMining}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding BoostMode}" Value="HARM">
                                                                <Setter Property="Background" Value="#183B38"/>
                                                                <Setter Property="Foreground" Value="#80E4D5"/>
                                                                <Setter Property="BorderBrush" Value="#49A89B"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding BoostMode}" Value="EXT">
                                                                <Setter Property="Background" Value="#183447"/>
                                                                <Setter Property="Foreground" Value="#8EC9E8"/>
                                                                <Setter Property="BorderBrush" Value="#5599BC"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding BoostMode}" Value="BOTH">
                                                                <Setter Property="Background" Value="#40351D"/>
                                                                <Setter Property="Foreground" Value="#F2D27A"/>
                                                                <Setter Property="BorderBrush" Value="#A98D42"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="{Binding AlarmButtonText}"
                                                    Tag="{Binding Character}"
                                                    Click="AlarmToggle_Click"
                                                    ToolTip="{Binding AlarmToolTip}"
                                                    IsEnabled="{Binding AlarmEnabled}"
                                                    FontSize="9.5"
                                                    MinWidth="50"
                                                    MinHeight="21"
                                                    Padding="6,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#17312D"/>
                                                        <Setter Property="Foreground" Value="#58D3B4"/>
                                                        <Setter Property="BorderBrush" Value="#39796C"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Cursor" Value="Hand"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlarmMuted}" Value="True">
                                                                <Setter Property="Background" Value="#2A2020"/>
                                                                <Setter Property="Foreground" Value="#E7A5A5"/>
                                                                <Setter Property="BorderBrush" Value="#8D5555"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsDroneMining}" Value="True">
                                                                <Setter Property="Background" Value="#14384A"/>
                                                                <Setter Property="Foreground" Value="#BCE9FF"/>
                                                                <Setter Property="BorderBrush" Value="#5AA4C8"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
