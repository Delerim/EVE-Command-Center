<Window x:Class="EveMultiPreview.Views.MiningFleetOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mining Overview"
        Width="1780" Height="165" MinWidth="600" MinHeight="125"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#17312D"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#F20B1416" BorderBrush="#2C6D60" BorderThickness="1"
            CornerRadius="8" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,6"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="MINER OVERVIEW"
                           Foreground="#F1F7F5"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Background="#14352F"
                        BorderBrush="#2F7466"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="LIVE + TODAY"
                               Foreground="#58D3B4"
                               FontWeight="SemiBold"
                               FontSize="9.5"/>
                </Border>

                <TextBlock x:Name="DayText"
                           Grid.Column="3"
                           Foreground="#7EA99F"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Left"/>

                <TextBlock x:Name="UpdatedText"
                           Grid.Column="4"
                           Foreground="#6F8F88"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0"
                           TextAlignment="Right"/>

                <Button Grid.Column="5"
                        Content="X"
                        Width="25"
                        Height="21"
                        Click="Close_Click"
                        Margin="5,0,0,0"/>
            </Grid>

            <ScrollViewer x:Name="MinerScroll"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl x:Name="MinerItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding CardWidth}" Height="112"
                                    VerticalAlignment="Top"
                                    CornerRadius="7" BorderThickness="1.5"
                                    Padding="8,6" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#39796C"/>
                                        <Setter Property="Background" Value="#111D1C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="MINING">
                                                <Setter Property="BorderBrush" Value="#38BE91"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                <Setter Property="BorderBrush" Value="#D8A84A"/>
                                                <Setter Property="Background" Value="#2A2418"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                <Setter Property="BorderBrush" Value="#EF963E"/>
                                                <Setter Property="Background" Value="#332019"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="IDLE">
                                                <Setter Property="BorderBrush" Value="#E85C66"/>
                                                <Setter Property="Background" Value="#351B20"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="MUTED">
                                                <Setter Property="BorderBrush" Value="#647D84"/>
                                                <Setter Property="Background" Value="#162124"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <TextBlock Text="{Binding Character}" Foreground="#F4F8F7"
                                                   FontWeight="SemiBold" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Ore}" DockPanel.Dock="Right"
                                                   Foreground="#58D3B4" FontSize="9.5"
                                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="#718D87" FontSize="8.5" Text="BASE"/>
                                            <TextBlock Text="{Binding BaseText}" Foreground="#FFFFFF"
                                                       FontWeight="Bold" FontSize="11.5"/>
                                            <TextBlock Foreground="#718D87" FontSize="8.5" Text="PROFIT"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ValueText}" Foreground="#58D3B4"
                                                       FontWeight="SemiBold" FontSize="10.5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Foreground="#718D87" FontSize="8.5" Text="REAL"/>
                                            <TextBlock Text="{Binding ActualText}" Foreground="#EAF7F4"
                                                       FontWeight="Bold" FontSize="11.5"/>
                                            <TextBlock Foreground="#718D87" FontSize="8.5" Text="BB"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding BuybackText}" Foreground="#58D3B4"
                                                       FontWeight="SemiBold" FontSize="10.5"/>
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock Text="CRIT " Foreground="#718D87" FontSize="8.5"/>
                                        <TextBlock Text="{Binding CritText}" Foreground="#C8D8D4" FontSize="9.5"/>
                                    </DockPanel>

                                    <Grid Grid.Row="3" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusText}"
                                                   FontSize="9"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#38BE91"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                            <Setter Property="Foreground" Value="#D8A84A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                            <Setter Property="Foreground" Value="#EF963E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="IDLE">
                                                            <Setter Property="Foreground" Value="#E85C66"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="WAITING">
                                                            <Setter Property="Foreground" Value="#718D87"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="MUTED">
                                                            <Setter Property="Foreground" Value="#91A8AE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="1"
                                                Content="{Binding AlarmButtonText}"
                                                Tag="{Binding Character}"
                                                Click="AlarmToggle_Click"
                                                ToolTip="{Binding AlarmToolTip}"
                                                FontSize="7.5"
                                                MinWidth="57"
                                                Height="18"
                                                Padding="5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#17312D"/>
                                                    <Setter Property="Foreground" Value="#58D3B4"/>
                                                    <Setter Property="BorderBrush" Value="#39796C"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlarmMuted}" Value="True">
                                                            <Setter Property="Background" Value="#2A2020"/>
                                                            <Setter Property="Foreground" Value="#E7A5A5"/>
                                                            <Setter Property="BorderBrush" Value="#8D5555"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
