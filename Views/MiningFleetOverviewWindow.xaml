<Window x:Class="EveMultiPreview.Views.MiningFleetOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mining Tile Wall"
        Width="1500" Height="390" MinWidth="500" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#20302F"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#F20C1517" BorderBrush="#39796C" BorderThickness="1"
            CornerRadius="8" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MINER OVERVIEW Â· LIVE + TODAY"
                               Foreground="#EAF7F4" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="DayText" Margin="10,0,0,0"
                               Foreground="#58D3B4" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="Ã—" Width="27" Height="24"
                        Click="Close_Click" Margin="8,0,0,0"/>
                <TextBlock x:Name="UpdatedText" DockPanel.Dock="Right"
                           Foreground="#7F9B96" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MinerItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="214" MinHeight="170"
                                    CornerRadius="8" BorderThickness="2"
                                    Padding="10,8" Margin="0,0,8,8"
                                    Background="#14201F">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#39796C"/>
                                        <Setter Property="Background" Value="#14201F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="MINING">
                                                <Setter Property="BorderBrush" Value="#3EBF91"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                <Setter Property="BorderBrush" Value="#D7A84B"/>
                                                <Setter Property="Background" Value="#30291A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                <Setter Property="BorderBrush" Value="#F09A43"/>
                                                <Setter Property="Background" Value="#3A241B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="IDLE âš ">
                                                <Setter Property="BorderBrush" Value="#F06060"/>
                                                <Setter Property="Background" Value="#442025"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="WAITING">
                                                <Setter Property="BorderBrush" Value="#50625F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <TextBlock Text="{Binding Character}"
                                               Foreground="#F4F8F7"
                                               FontWeight="SemiBold" FontSize="13"/>

                                    <TextBlock Text="{Binding Ore}"
                                               Foreground="#58D3B4"
                                               FontSize="11" Margin="0,2,0,5"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="BASE" Foreground="#7F9B96" FontSize="10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BaseText}"
                                                   Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>

                                        <TextBlock Grid.Row="1" Text="REAL" Foreground="#7F9B96" FontSize="10"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActualText}"
                                                   Foreground="#EAF7F4" FontSize="12"/>

                                        <TextBlock Grid.Row="2" Text="CRIT" Foreground="#7F9B96" FontSize="10"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CritText}"
                                                   Foreground="#C9D8D5" FontSize="11"/>

                                        <TextBlock Grid.Row="3" Text="PROFIT" Foreground="#7F9B96" FontSize="10"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ValueText}"
                                                   Foreground="#58D3B4" FontSize="11" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="4" Text="BB" Foreground="#7F9B96" FontSize="10"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BuybackText}"
                                                   Foreground="#58D3B4" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>

                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11" Margin="0,5,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#3EBF91"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                        <Setter Property="Foreground" Value="#D7A84B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                        <Setter Property="Foreground" Value="#F09A43"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="IDLE âš ">
                                                        <Setter Property="Foreground" Value="#F06060"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="WAITING">
                                                        <Setter Property="Foreground" Value="#77817F"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
