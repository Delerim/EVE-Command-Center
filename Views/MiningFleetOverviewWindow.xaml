<Window x:Class="EveCommandCenter.Views.MiningFleetOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EveCommandCenter.Views"
        Title="Character Overview"
        Width="1780" Height="182" MinWidth="600" MinHeight="142"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#17312D"/>
            <Setter Property="Foreground" Value="#EAF7F4"/>
            <Setter Property="BorderBrush" Value="#39796C"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#F20B1416" BorderBrush="#2C6D60" BorderThickness="1"
            CornerRadius="8" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="OverviewHeader" Grid.Row="0" Margin="2,0,0,6"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="CHARACTER OVERVIEW"
                           Foreground="#F1F7F5"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <Border x:Name="LiveBadge" Grid.Column="1"
                        Background="#14352F"
                        BorderBrush="#2F7466"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="7,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="LIVE + TODAY"
                               Foreground="#58D3B4"
                               FontWeight="SemiBold"
                               FontSize="11.5"/>
                </Border>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="DayText"
                               Foreground="#7EA99F"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextAlignment="Left"/>

                    <Border x:Name="PlexMarketBorder"
                            Background="#101D20"
                            BorderBrush="#315E67"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,2"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Loading PLEX market...">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="PLEX"
                                       Foreground="#8EC9E8"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="BUY "
                                       Foreground="#718D87"
                                       FontSize="10.5"/>

                            <TextBlock x:Name="PlexBuyText"
                                       Text="--"
                                       Foreground="#EAF7F4"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="  |  SELL "
                                       Foreground="#718D87"
                                       FontSize="10.5"/>

                            <TextBlock x:Name="PlexSellText"
                                       Text="--"
                                       Foreground="#EAF7F4"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="FullActions" Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,2,0">
                    <Button Content="COMBINE PREVIEWS" Height="21" FontSize="10" Click="Combine_Click" Margin="0,0,5,0"/><Button Content="OMEGA" Height="21" FontSize="10" Margin="4,0,0,0" Click="OpenOmega_Click"/>
                    <Button Content="NOTICES" Height="21" Padding="7,1" FontSize="10" Margin="4,0" Click="Notifications_Click"/>
                    <Button x:Name="RockToggle" Content="ROCKS OFF" Height="21" Padding="7,1" FontSize="10" Margin="4,0" Click="RockToggle_Click" ToolTip="Toggle estimated per-laser rock tracking"/>
                    <Button Content="MINING"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Click="OpenMiningCommandCenter_Click"
                            ToolTip="Open Mining Command Center"/>

                    <Button Content="PILOTS"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="4,0,0,0"
                            Click="OpenPilotCommandCenter_Click"
                            ToolTip="Open Pilot Command Center"/>

                    <Button x:Name="MoonsButton" Visibility="Collapsed" Content="MOONS"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="4,0,0,0"
                            Click="OpenMoonReport_Click"
                            ToolTip="Open Moon Report"/>
                    <Button x:Name="ContractsButton" Visibility="Collapsed" Content="CONTRACTS" MinWidth="72" Height="21" Padding="7,1" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0" Click="OpenContracts_Click" ToolTip="Corporation contracts and buyback checks"/>
                    <Button Content="INDUSTRY" Height="21" FontSize="10" Margin="4,0,0,0" Click="OpenIndustry_Click"/>
                    <Button Content="PI" Height="21" FontSize="10" Margin="4,0,0,0" Click="OpenPlanetary_Click" ToolTip="Planetary industry across all linked pilots"/>
                    <Button Content="SETTINGS" Height="21" FontSize="10" Margin="18,0,4,0" Click="OpenClientSettings_Click"/>
                    <Button Content="PREVIEW SETTINGS" Height="21" FontSize="10" Margin="4,0,4,0" Click="OpenPreviewSettings_Click"/>
                    <Button Content="CLOUD"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="4,0,0,0"
                            Click="OpenCloudBackup_Click"
                            ToolTip="Google Drive backup and restore"/>
                    <Button x:Name="OrderButton"
                            Content="ORDER CLIENTS"
                            MinWidth="58"
                            Height="21"
                            Padding="7,1"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Margin="4,0,0,0"
                            Click="OrderMode_Click"
                            MouseRightButtonUp="OrderButton_MouseRightButtonUp"
                            ToolTip="Click to enable tile reordering, drag tiles left/right, then click DONE. Right-click to reset."/>
                </StackPanel>

                <StackPanel x:Name="CompactActions" Grid.Column="4" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="ModeButton" Content="MODE: CHARACTERS" Height="23" FontSize="10" Click="Mode_Click" ToolTip="Choose character, mining, PvE or PvP cards"><Button.ContextMenu><ContextMenu>
                        <MenuItem Header="Characters - previews" Tag="CHARACTERS" Click="OverviewMode_Click"/>
                        <MenuItem Header="Mining - yield and alarms" Tag="MINING" Click="OverviewMode_Click"/>
                        <MenuItem Header="PvE - damage and bounties" Tag="PVE" Click="OverviewMode_Click"/>
                        <MenuItem Header="PvP - pressure and recent tackle" Tag="PVP" Click="OverviewMode_Click"/>
                    </ContextMenu></Button.ContextMenu></Button>
                    <Button x:Name="LivePreviewButton" Content="PREVIEW: SNAPSHOT" Height="23" FontSize="10" Margin="5,0,0,0" Click="LivePreview_Click" ToolTip="Live/snapshot setting for Character mode. Minimized clients retain the last available snapshot."/>
                    <Button Content="TOOLS" Height="23" FontSize="10" Margin="5,0" Click="Tools_Click"><Button.ContextMenu><ContextMenu>
                        <MenuItem Header="Mining" Click="OpenMiningCommandCenter_Click"/><MenuItem Header="Pilots" Click="OpenPilotCommandCenter_Click"/><MenuItem Header="Planetary Industry" Click="OpenPlanetary_Click"/><MenuItem Header="Industry" Click="OpenIndustry_Click"/><MenuItem Header="Omega" Click="OpenOmega_Click"/><MenuItem Header="Notifications" Click="Notifications_Click"/><MenuItem Header="Moons" Click="OpenMoonReport_Click"/><MenuItem Header="Contracts" Click="OpenContracts_Click"/><Separator/><MenuItem Header="Settings" Click="OpenClientSettings_Click"/><MenuItem Header="Preview settings" Click="OpenPreviewSettings_Click"/><MenuItem Header="Cloud backup" Click="OpenCloudBackup_Click"/><MenuItem Header="Reorder characters" Click="OrderMode_Click"/><MenuItem Header="Toggle rock tracking" Click="RockToggle_Click"/>
                    </ContextMenu></Button.ContextMenu></Button>
                    <Button Content="SEPARATE PREVIEWS" Height="23" FontSize="10" Click="Combine_Click" ToolTip="Restore the independent preview windows"/>
                </StackPanel>
                <TextBlock x:Name="UpdatedText"
                           Grid.Column="5"
                           Foreground="#6F8F88"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0"
                           TextAlignment="Right"/>

                <Button Grid.Column="6"
                        Content="X"
                        Width="25"
                        Height="21"
                        Click="Close_Click"
                        Margin="5,0,0,0"/>
            </Grid>

            <ScrollViewer x:Name="MinerScroll"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <ItemsControl x:Name="MinerItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding CardWidth}" MinHeight="{Binding CardMinHeight}"
                                    VerticalAlignment="Top"
                                    CornerRadius="7" BorderThickness="1.5"
                                    Padding="8,6" Margin="0,0,6,0"
                                    AllowDrop="True" ToolTip="{Binding StatusToolTip}"
                                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown" MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                                    PreviewMouseMove="Tile_PreviewMouseMove"
                                    DragOver="Tile_DragOver"
                                    Drop="Tile_Drop">
                                <Border.Triggers><EventTrigger RoutedEvent="MouseLeftButtonDown"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.65" Duration="0:0:0.08" AutoReverse="True"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#39796C"/>
                                        <Setter Property="Background" Value="#111D1C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanSwitch}" Value="True"><Setter Property="Cursor" Value="Hand"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="#80BFFF"/><Setter Property="Background" Value="#19313D"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#80BFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.75"/></Setter.Value></Setter></DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#8CEEE2" BlurRadius="9" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter></Trigger>
                                            <DataTrigger Binding="{Binding Status}" Value="PVP"><Setter Property="BorderBrush" Value="#AE91E8"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="PVE"><Setter Property="BorderBrush" Value="#78BCD3"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="MINING">
                                                <Setter Property="BorderBrush" Value="#38BE91"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                <Setter Property="BorderBrush" Value="#D8A84A"/>
                                                <Setter Property="Background" Value="#2A2418"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                <Setter Property="BorderBrush" Value="#EF963E"/>
                                                <Setter Property="Background" Value="#332019"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="IDLE">
                                                <Setter Property="BorderBrush" Value="#E85C66"/>
                                                <Setter Property="Background" Value="#351B20"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="MUTED">
                                                <Setter Property="BorderBrush" Value="#647D84"/>
                                                <Setter Property="Background" Value="#162124"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <Border Grid.RowSpan="8"
                                            Margin="-5,-3,-5,-3"
                                            CornerRadius="6"
                                            BorderThickness="2"
                                            Background="Transparent"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="20">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Opacity" Value="0.55"/>
                                                <Setter Property="BorderBrush" Value="#66BFD9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlertPending}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlertSeverity}" Value="warning">
                                                        <Setter Property="BorderBrush" Value="#E0AE4F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlertSeverity}" Value="critical">
                                                        <Setter Property="BorderBrush" Value="#EF6673"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlertSeverity}" Value="info">
                                                        <Setter Property="BorderBrush" Value="#66BFD9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlertActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="AlertPulseStoryboard">
                                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0.35" To="1"
                                                                                     Duration="0:0:0.45"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="AlertPulseStoryboard"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Grid.Row="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            MinWidth="18"
                                            Height="18"
                                            Padding="4,0"
                                            Margin="0,-4,-4,0"
                                            CornerRadius="9"
                                            BorderThickness="1"
                                            IsHitTestVisible="False"
                                            Panel.ZIndex="30">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Background" Value="#D9233942"/>
                                                <Setter Property="BorderBrush" Value="#66BFD9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlertPending}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlertSeverity}" Value="warning">
                                                        <Setter Property="Background" Value="#D93A2F18"/>
                                                        <Setter Property="BorderBrush" Value="#E0AE4F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlertSeverity}" Value="critical">
                                                        <Setter Property="Background" Value="#D9411820"/>
                                                        <Setter Property="BorderBrush" Value="#EF6673"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AlertBadgeText}"
                                                   Foreground="#FFFFFF"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="15"
                                                ClipToBounds="True"
                                                Background="#142321"
                                                BorderBrush="#315E56"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <Image Source="{Binding PortraitUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="5,0,0,0">
                                            <DockPanel>
                                                <TextBlock Visibility="{Binding MiningVisibility}" Text="{Binding Ore}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="#58D3B4"
                                                           FontSize="11.5"
                                                           Margin="5,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OreToolTip}"/>

                                                <TextBlock Text="{Binding Character}"
                                                           Foreground="#F4F8F7"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,1,0,0">
                                                <TextBlock Text="{Binding SystemText}"
                                                           DockPanel.Dock="Right"
                                                           FontSize="9.5"
                                                           Margin="6,0,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SystemText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#65B9D6"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SystemTransitionActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFD75E"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard Name="SystemJumpStoryboard">
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="0.30"
                                                                                                 To="1"
                                                                                                 Duration="0:0:0.24"
                                                                                                 AutoReverse="True"
                                                                                                 RepeatBehavior="3x"
                                                                                                 FillBehavior="Stop"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ShipText}"
                                                           Foreground="#8DA9A2"
                                                           FontSize="9.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ShipToolTip}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Visibility="{Binding MiningVisibility}" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="BASE"/>
                                            <TextBlock Text="{Binding BaseText}" Foreground="#FFFFFF"
                                                       FontWeight="Bold" FontSize="13.5"
                                                       ToolTip="{Binding BaseToolTip}"/>
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="PROFIT"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding ValueText}" Foreground="#58D3B4"
                                                       FontWeight="SemiBold" FontSize="12.5"
                                                       ToolTip="{Binding ProfitToolTip}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="REAL"/>
                                            <TextBlock Text="{Binding ActualText}" Foreground="#EAF7F4"
                                                       FontWeight="Bold" FontSize="13.5"
                                                       ToolTip="{Binding RealToolTip}"/>
                                            <TextBlock Foreground="#718D87" FontSize="10.5" Text="BB"
                                                       Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding BuybackText}" Foreground="#58D3B4"
                                                       FontWeight="SemiBold" FontSize="12.5"
                                                       ToolTip="{Binding BuybackToolTip}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Visibility="{Binding MiningVisibility}"
                                          Grid.Row="2"
                                          Margin="0,3,0,0"
                                          ToolTip="{Binding CritToolTip}">
                                        <Border CornerRadius="3"
                                                BorderThickness="1"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CritPulse}" Value="True">
                                                            <Setter Property="Background" Value="#443B2F0C"/>
                                                            <Setter Property="BorderBrush" Value="#E6C34F"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard Name="CritPullPulseStoryboard">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="0.58"
                                                                                         To="1"
                                                                                         Duration="0:0:0.28"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="CritPullPulseStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <DockPanel LastChildFill="False">
                                            <TextBlock FontSize="10.5"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="CRIT "/>
                                                        <Setter Property="Foreground" Value="#718D87"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CritPulse}" Value="True">
                                                                <Setter Property="Text" Value="&#9733; CRIT "/>
                                                                <Setter Property="Foreground" Value="#FFD75E"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding CritText}"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#C8D8D4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CritPulse}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFD75E"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding CritM3Text}"
                                                       FontSize="10.5"
                                                       Margin="2,0,0,0"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding CritToolTip}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8FB2B5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CritPulse}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFD75E"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </Grid>

                                    <Grid Visibility="{Binding MiningVisibility}" Grid.Row="3"
                                          Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Foreground="#7FDCC5"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LaserToolTip}">
                                            <Run Text="{Binding LaserPrimaryText}"
                                                 Foreground="#7FDCC5"/>
                                            <Run Text="{Binding LaserPrimaryCrystal}"
                                                 Foreground="#64C7FF"
                                                 FontWeight="Bold"/>
                                            <Run Text="{Binding LaserSecondaryText}"
                                                 Foreground="#7FDCC5"/>
                                            <Run Text="{Binding LaserSecondaryCrystal}"
                                                 Foreground="#64C7FF"
                                                 FontWeight="Bold"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding EhpText}"
                                                   Foreground="#8EC9E8"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding EhpToolTip}"/>
                                    </Grid>

                                    <Grid Visibility="{Binding MiningVisibility}" Grid.Row="4" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusToolTip}"
                                                   Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#38BE91"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="LATE">
                                                            <Setter Property="Foreground" Value="#D8A84A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="DEGRADED">
                                                            <Setter Property="Foreground" Value="#EF963E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="IDLE">
                                                            <Setter Property="Foreground" Value="#E85C66"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="WAITING">
                                                            <Setter Property="Foreground" Value="#718D87"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="MUTED">
                                                            <Setter Property="Foreground" Value="#91A8AE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Button Content="{Binding BoostButtonText}"
                                                    Tag="{Binding Character}"
                                                    Click="OrcaBoostToggle_Click"
                                                    ToolTip="{Binding BoostToolTip}"
                                                    FontSize="8.5"
                                                    MinHeight="21"
                                                    MinWidth="52"
                                                    Padding="5,1"
                                                    Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Background" Value="#172126"/>
                                                        <Setter Property="Foreground" Value="#8DA9A2"/>
                                                        <Setter Property="BorderBrush" Value="#41535A"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Cursor" Value="Hand"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDroneMining}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding BoostMode}" Value="HARM">
                                                                <Setter Property="Background" Value="#183B38"/>
                                                                <Setter Property="Foreground" Value="#80E4D5"/>
                                                                <Setter Property="BorderBrush" Value="#49A89B"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding BoostMode}" Value="EXT">
                                                                <Setter Property="Background" Value="#183447"/>
                                                                <Setter Property="Foreground" Value="#8EC9E8"/>
                                                                <Setter Property="BorderBrush" Value="#5599BC"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding BoostMode}" Value="BOTH">
                                                                <Setter Property="Background" Value="#40351D"/>
                                                                <Setter Property="Foreground" Value="#F2D27A"/>
                                                                <Setter Property="BorderBrush" Value="#A98D42"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Content="{Binding AlarmButtonText}"
                                                    Tag="{Binding Character}"
                                                    Click="AlarmToggle_Click"
                                                    ToolTip="{Binding AlarmToolTip}"
                                                    IsEnabled="{Binding AlarmEnabled}"
                                                    FontSize="9.5"
                                                    MinWidth="50"
                                                    MinHeight="21"
                                                    Padding="6,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#17312D"/>
                                                        <Setter Property="Foreground" Value="#58D3B4"/>
                                                        <Setter Property="BorderBrush" Value="#39796C"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Cursor" Value="Hand"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlarmMuted}" Value="True">
                                                                <Setter Property="Background" Value="#2A2020"/>
                                                                <Setter Property="Foreground" Value="#E7A5A5"/>
                                                                <Setter Property="BorderBrush" Value="#8D5555"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding IsDroneMining}" Value="True">
                                                                <Setter Property="Background" Value="#14384A"/>
                                                                <Setter Property="Foreground" Value="#BCE9FF"/>
                                                                <Setter Property="BorderBrush" Value="#5AA4C8"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="5" Margin="0,6,0,0" Visibility="{Binding RockVisibility}">
                                        <Button Content="SET ROCKS (EST.)" Tag="{Binding Character}" Click="SetRocks_Click" FontSize="9" Padding="3,1" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding Rock1Text}" Foreground="#74D6C9" FontSize="10" Margin="0,3,0,1" ToolTip="{Binding Rock1Note}"/>
                                        <ProgressBar Height="3" Value="{Binding Rock1Percent}" Maximum="100" Foreground="#74D6C9" Background="#243B3B"/>
                                        <TextBlock Text="{Binding Rock2Text}" Foreground="#9EBFFF" FontSize="10" Margin="0,3,0,1" ToolTip="{Binding Rock2Note}"/>
                                        <ProgressBar Height="3" Value="{Binding Rock2Percent}" Maximum="100" Foreground="#9EBFFF" Background="#243B3B"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="7" Height="115" Margin="0,5,0,0" Visibility="{Binding CombatVisibility}" ToolTip="{Binding CombatToolTip}">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="DPS OUT / 30s" Foreground="#74D6C9" FontSize="9"/><TextBlock Text="{Binding CombatOut}" Foreground="#EAF7F4" FontWeight="Bold" FontSize="16"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Text="DPS IN / 30s" Foreground="#EBAAA2" FontSize="9"/><TextBlock Text="{Binding CombatIn}" Foreground="#FFE1DB" FontWeight="Bold" FontSize="16"/></StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding CombatSummary}" Foreground="#8DCCED" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CombatDetail}" Foreground="#C2CED0" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CombatNotice}" Foreground="#FFD166" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CombatHint}" Foreground="#78928E" FontSize="9" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Row="6" Visibility="{Binding PreviewVisibility}" Margin="0,5,0,0" Height="115" Background="#071013" ClipToBounds="True">
                                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="0,0,0,32"/>
                                        <local:OverviewLivePreview x:Name="LiveSurface" SourceHwnd="{Binding SourceHwnd}" Enabled="{Binding LivePreview}" Margin="0,0,0,32"/>

                                        <Border Background="#E0071013"
                                                VerticalAlignment="Bottom"
                                                Height="32"
                                                Padding="4,2"
                                                IsHitTestVisible="False">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <DockPanel Grid.Row="0">
                                                    <TextBlock Text="{Binding PreviewFpsText}"
                                                               DockPanel.Dock="Right"
                                                               Foreground="#E78282"
                                                               FontSize="8.5"
                                                               Margin="6,0,0,0"/>
                                                    <TextBlock FontSize="8.5"
                                                               Foreground="#A9CFC6"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding PreviewNote}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LivePreview}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding StateText, ElementName=LiveSurface}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding PreviewTelemetryText}"
                                                           Foreground="#75D1BC"
                                                           FontSize="8.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>

                                        <Border VerticalAlignment="Top"
                                                HorizontalAlignment="Right"
                                                Background="#D019313D"
                                                Padding="3,1"
                                                Margin="2"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="ACTIVE" Foreground="#9FD0FF" FontSize="8"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
