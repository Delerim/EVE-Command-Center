<Window x:Class="EveCommandCenter.Views.IndustryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EVE Command Center | Industry" Width="1480" Height="960" MinWidth="1100" MinHeight="700" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#0C2529"/><Setter Property="AlternatingRowBackground" Value="#102D31"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#245058"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C5750"/><Setter Property="Foreground" Value="#DDF6F4"/></Trigger></Style.Triggers></Style>
<DataTemplate x:Key="Item"><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></DataTemplate>
<DataTemplate x:Key="Status"><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap" FontWeight="Bold"/></DataTemplate>
</ResourceDictionary></Window.Resources>
<DockPanel Margin="18"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="INDUSTRY COMMAND CENTER" Foreground="#55D7D2" FontSize="26" FontWeight="Bold"/><CheckBox Foreground="#DDF6F4" x:Name="Alerts" Content="DESKTOP ALERTS" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Alerts_Click"/></DockPanel><TextBlock Text="Manufacturing | Research | Invention | Blueprint and material planning" Foreground="#8FB2B5" Margin="0,5,0,12"/>
<ListBox Foreground="#DDF6F4" x:Name="Pilots" SelectionChanged="Pilot_Selected" Background="#07181B" BorderBrush="#245058" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="#102D31" Padding="10" CornerRadius="6" Width="210"><StackPanel Orientation="Horizontal"><Image Source="{Binding Portrait}" Width="44" Height="44" Margin="0,0,10,0"/><StackPanel><TextBlock Text="{Binding Name}" Foreground="#DDF6F4" FontWeight="Bold"/><TextBlock Text="{Binding Summary}" Foreground="#74D6C9" Margin="0,5,0,0" FontSize="11"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
<WrapPanel Margin="0,12"><Button Content="RECONNECT - ALL FEATURES" Click="Link_Click"/><Button Content="REFRESH WHEN DUE" Click="Refresh_Click" Margin="8,0"/><TextBlock x:Name="Snapshot" Foreground="#8FB2B5" VerticalAlignment="Center"/></WrapPanel>
<Border Background="#102D31" CornerRadius="6" Padding="14" Margin="0,0,0,12"><TextBlock x:Name="Dashboard" Foreground="#55D7D2" FontSize="16" TextWrapping="Wrap"/></Border><UniformGrid Columns="4" Margin="0,0,0,12"><Border Background="#102D31" BorderBrush="#74D6C9" BorderThickness="0,3,0,0" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="MANUFACTURING" Foreground="#74D6C9"/><TextBlock x:Name="ManufacturingStat" FontSize="22" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#102D31" BorderBrush="#80BFFF" BorderThickness="0,3,0,0" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="RESEARCH / COPYING" Foreground="#80BFFF"/><TextBlock x:Name="ResearchStat" FontSize="22" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#102D31" BorderBrush="#D4A5FF" BorderThickness="0,3,0,0" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="INVENTION / REACTIONS" Foreground="#D4A5FF"/><TextBlock x:Name="InventionStat" FontSize="22" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#102D31" BorderBrush="#FFD166" BorderThickness="0,3,0,0" Padding="12"><StackPanel><TextBlock Text="READY TO DELIVER" Foreground="#FFD166"/><TextBlock x:Name="ReadyStat" FontSize="22" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid></StackPanel>
<TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,10,0,0"/>
<TabControl x:Name="IndustryTabs" Background="#07181B" BorderBrush="#245058">
<TabItem Header="JOBS"><DataGrid x:Name="Jobs" Margin="10"><DataGrid.Columns><DataGridTemplateColumn Header="PRODUCT / BLUEPRINT" CellTemplate="{StaticResource Item}" Width="2*"/><DataGridTextColumn Header="ACTIVITY" Binding="{Binding Activity}" Width="*"/><DataGridTemplateColumn Header="STATUS" CellTemplate="{StaticResource Status}" Width="1.5*"/><DataGridTextColumn Header="RUNS" Binding="{Binding Runs}" Width="*"/><DataGridTextColumn Header="FINISHES" Binding="{Binding End}" Width="*"/><DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem Header="BLUEPRINTS &amp; MATERIAL PLANNER"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBox x:Name="Search" Width="280" ToolTip="Search blueprint or product"/><TextBlock Text=" Runs " VerticalAlignment="Center"/><TextBox x:Name="Runs" Text="1" Width="60"/><CheckBox Foreground="#DDF6F4" x:Name="AllRecipes" Content="All recipes" Margin="12,0" VerticalAlignment="Center"/><CheckBox Foreground="#DDF6F4" x:Name="ReadyOnly" Content="Ready only" Margin="0,0,12,0" VerticalAlignment="Center"/><Button Content="SCAN RECIPES" Click="Scan_Click"/></WrapPanel><TextBlock x:Name="ScanStatus" Margin="0,8" Foreground="#8FB2B5" TextWrapping="Wrap"/></StackPanel>
<Grid><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="130"/><RowDefinition Height="8"/><RowDefinition Height="1.3*" MinHeight="180"/></Grid.RowDefinitions><DataGrid x:Name="Recipes" SelectionChanged="Recipe_Selected"><DataGrid.Columns><DataGridTemplateColumn Header="BLUEPRINT" CellTemplate="{StaticResource Item}" Width="2*"/><DataGridTextColumn Header="ACTIVITY" Binding="{Binding Activity}" Width="*"/><DataGridTextColumn Header="OWNERSHIP / EFFICIENCY" Binding="{Binding Blueprint}" Width="2*"/><DataGridTemplateColumn Header="READINESS" CellTemplate="{StaticResource Status}" Width="*"/></DataGrid.Columns></DataGrid><GridSplitter Grid.Row="1" Height="8" Background="#245058" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>
<DockPanel Grid.Row="2"><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock x:Name="PlanTitle" Foreground="#55D7D2" FontSize="18" FontWeight="Bold"/><Button Content="LOAD JITA QUOTES" Click="Quote_Click" HorizontalAlignment="Right"/></DockPanel><TextBlock x:Name="PlanDetail" TextWrapping="Wrap" Margin="0,8" Foreground="#9FC5C7"/></StackPanel><DataGrid x:Name="Materials"><DataGrid.Columns><DataGridTemplateColumn Header="MATERIAL" CellTemplate="{StaticResource Item}" Width="2*"/><DataGridTextColumn Header="REQUIRED" Binding="{Binding Required, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="OWNED" Binding="{Binding Owned, StringFormat=N0}" Width="*"/><DataGridTemplateColumn Header="TO BUY" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Missing, StringFormat=N0}" Foreground="{Binding Color}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="EST. PURCHASE" Binding="{Binding Cost}" Width="1.5*"/></DataGrid.Columns></DataGrid></DockPanel></Grid></DockPanel></TabItem>
<TabItem Header="SKILLS &amp; BONUSES"><DockPanel Margin="14"><TextBlock DockPanel.Dock="Top" Text="Active skills and recipe requirements. Manufacturing estimates apply Industry, Advanced Industry and blueprint TE; specialized construction skills, implants and facility effects are not yet included in planner times. Live job finish times come directly from ESI." Foreground="#9FC5C7" TextWrapping="Wrap" Margin="0,0,0,12"/><DataGrid x:Name="Skills"><DataGrid.Columns><DataGridTextColumn Header="SKILL" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="ACTIVE LEVEL" Binding="{Binding Level}" Width="*"/><DataGridTextColumn Header="RELEVANCE" Binding="{Binding Role}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
</TabControl></DockPanel></Window>
