<Window x:Class="EveCommandCenter.Views.IndustryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EveCommandCenter.Views" Title="EVE Command Center | Industry" Width="1480" Height="960" MinWidth="1100" MinHeight="700" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterScreen">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="IndustryWorkspaceTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style TargetType="DataGrid"><Setter Property="FontSize" Value="12"/><Setter Property="MinRowHeight" Value="42"/><Setter Property="AlternationCount" Value="2"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="RowBackground" Value="#0C2529"/><Setter Property="AlternatingRowBackground" Value="#102D31"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#245058"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C5750"/><Setter Property="Foreground" Value="#DDF6F4"/></Trigger></Style.Triggers></Style>
<DataTemplate x:Key="Item"><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></DataTemplate>
<DataTemplate x:Key="Status"><Border BorderBrush="{Binding Color}" BorderThickness="2,0,0,0" Padding="8,3" Margin="3"><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"/></Border></DataTemplate>
<DataTemplate x:Key="RecipeItem"><DockPanel Margin="4"><Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,8,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Activity}" Foreground="{Binding ActivityColor}" FontSize="10" Margin="0,3,0,0"/></StackPanel></DockPanel></DataTemplate>
<DataTemplate x:Key="Activity"><TextBlock Text="{Binding Activity}" Foreground="{Binding ActivityColor}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6"/></DataTemplate>
<DataTemplate x:Key="BlueprintKind"><TextBlock Text="{Binding Blueprint}" Foreground="{Binding BlueprintColor}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6"/></DataTemplate>
</ResourceDictionary></Window.Resources>
<DockPanel Margin="18"><StackPanel x:Name="LiveIndustryHeader" DockPanel.Dock="Top">
 <DockPanel Margin="0,0,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Reconnect" Click="Link_Click"/><Button Content="Refresh Industry" Click="Refresh_Click"/><CheckBox x:Name="Alerts" Content="Alerts" Click="Alerts_Click"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="Industry command center" Foreground="#DDF6F4" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Snapshot" Foreground="#8FB2B5" FontSize="11"/></StackPanel></DockPanel>
<ListBox Foreground="#DDF6F4" x:Name="Pilots" SelectionChanged="Pilot_Selected" Background="#07181B" BorderBrush="#245058" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Background="Transparent" Padding="2" CornerRadius="6" Width="184"><StackPanel Orientation="Horizontal"><Image Source="{Binding Portrait}" Width="32" Height="32" Margin="0,0,10,0"/><StackPanel><TextBlock Text="{Binding Name}" Foreground="#DDF6F4" FontWeight="Bold"/><TextBlock Text="{Binding Summary}" Foreground="#74D6C9" Margin="0,3,0,0" FontSize="10"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
 <DockPanel Margin="0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="Manufacturing " Foreground="#74D6C9"/><TextBlock x:Name="ManufacturingStat" Margin="0,0,18,0" FontWeight="Bold"/><TextBlock Text="Research " Foreground="#80BFFF"/><TextBlock x:Name="ResearchStat" Margin="0,0,18,0" FontWeight="Bold"/><TextBlock Text="Invention " Foreground="#D4A5FF"/><TextBlock x:Name="InventionStat" Margin="0,0,18,0" FontWeight="Bold"/><TextBlock Text="Ready " Foreground="#FFD166"/><TextBlock x:Name="ReadyStat" FontWeight="Bold"/></StackPanel><TextBlock x:Name="Dashboard" Foreground="#93B7BB" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel>
<TabControl x:Name="ActivityTabs" SelectedIndex="1" Height="36" Background="#07181B" BorderThickness="0" SelectionChanged="Activity_Selected">
<TabItem Header="All activities" Tag="all"/><TabItem Header="Manufacturing" Tag="manufacturing" Foreground="#74D6C9"/><TabItem Header="ME research" Tag="research_material" Foreground="#80BFFF"/><TabItem Header="TE research" Tag="research_time" Foreground="#78DCE8"/><TabItem Header="Copying" Tag="copying" Foreground="#B8A1FF"/><TabItem Header="Invention" Tag="invention" Foreground="#E3A3EF"/><TabItem Header="Reactions" Tag="reaction" Foreground="#FFBE85"/>
</TabControl><TextBlock x:Name="ActivityContext" Margin="4,0,0,3" Foreground="#8FB2B5" FontSize="11"/></StackPanel>
<TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,10,0,0"/>
<TabControl x:Name="IndustryTabs" Background="#07181B" BorderBrush="#245058">
<TabItem x:Name="ProductionTab" Header="PRODUCTION QUEUE"><local:IndustryWorkspaceView x:Name="ProductionWorkspace"/></TabItem>
<TabItem x:Name="JobsTab" Header="JOBS"><DataGrid x:Name="Jobs" Margin="10"><DataGrid.Columns><DataGridTemplateColumn Header="PRODUCT / BLUEPRINT" CellTemplate="{StaticResource Item}" Width="2*"/><DataGridTemplateColumn Header="ACTIVITY" CellTemplate="{StaticResource Activity}" Width="*"/><DataGridTemplateColumn Header="STATUS" CellTemplate="{StaticResource Status}" Width="1.5*"/><DataGridTextColumn Header="RUNS" Binding="{Binding Runs}" Width="*"/><DataGridTemplateColumn Header="TIME LEFT" Width="1.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding TimeLeft}" Foreground="{Binding Color}"/><ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Foreground="{Binding ActivityColor}" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="FINISHES" Binding="{Binding End}" Width="*"/><DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
<TabItem x:Name="BlueprintPlannerTab" Header="BLUEPRINTS &amp; MATERIAL PLANNER"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBox x:Name="Search" Width="280" ToolTip="Search blueprint or product"/><TextBlock Text=" Runs " VerticalAlignment="Center"/><TextBox x:Name="Runs" Text="1" Width="60"/><CheckBox Foreground="#DDF6F4" x:Name="AllRecipes" Content="All recipes" Margin="12,0" VerticalAlignment="Center"/><CheckBox Foreground="#DDF6F4" x:Name="ReadyOnly" Content="Ready only" Margin="0,0,12,0" VerticalAlignment="Center"/><Button Content="SCAN RECIPES" Click="Scan_Click"/></WrapPanel><TextBlock x:Name="ScanStatus" Margin="0,8" Foreground="#8FB2B5" TextWrapping="Wrap"/></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" MinWidth="430"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="390"/></Grid.ColumnDefinitions><DataGrid x:Name="Recipes" SelectionChanged="Recipe_Selected"><DataGrid.Columns><DataGridTemplateColumn Header="BLUEPRINT / ACTIVITY" CellTemplate="{StaticResource RecipeItem}" Width="2*"/><DataGridTemplateColumn Header="OWNERSHIP / EFFICIENCY" CellTemplate="{StaticResource BlueprintKind}" Width="1.3*"/><DataGridTemplateColumn Header="READINESS" CellTemplate="{StaticResource Status}" Width="*"/></DataGrid.Columns></DataGrid><GridSplitter Grid.Column="1" Width="6" Background="#245058" HorizontalAlignment="Center" ResizeDirection="Columns"/>
<DockPanel Grid.Column="2" Margin="10,0,0,0"><StackPanel DockPanel.Dock="Top"><Border Background="#102D31" CornerRadius="6" Padding="14"><DockPanel><Button DockPanel.Dock="Right" Content="ADD TO QUEUE" Click="QueueRecipe_Click" Margin="5" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="LOAD JITA QUOTES" Click="Quote_Click" Margin="10,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="PlanActivity" FontSize="11" Margin="0,0,0,6"/><TextBlock x:Name="PlanTitle" Foreground="#DDF6F4" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="PlanState" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></DockPanel></Border></StackPanel><TabControl x:Name="PlanTabs" Background="#07181B" BorderBrush="#245058" Foreground="#DDF6F4"><TabItem Header="MATERIALS"><DataGrid x:Name="Materials"><DataGrid.Columns><DataGridTemplateColumn Header="MATERIAL" CellTemplate="{StaticResource Item}" Width="2*"/><DataGridTextColumn Header="REQUIRED" Binding="{Binding Required, StringFormat=N0}" Width="*"/><DataGridTextColumn Header="OWNED" Binding="{Binding Owned, StringFormat=N0}" Width="*"/><DataGridTemplateColumn Header="TO BUY" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Missing, StringFormat=N0}" Foreground="{Binding Color}" FontWeight="Bold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="EST. PURCHASE" Binding="{Binding Cost}" Width="1.5*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="OUTPUT"><ScrollViewer VerticalScrollBarVisibility="Auto"><Expander IsExpanded="True" Header="OUTPUT &amp; TIME ESTIMATES" Margin="0,8" Foreground="#9FC5C7"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="PlanDetail" TextWrapping="Wrap" Margin="0,8" Foreground="#9FC5C7"/></ScrollViewer></Expander></ScrollViewer></TabItem><TabItem Header="REQUIRED SKILLS"><DockPanel Margin="10"><TextBlock DockPanel.Dock="Top" Text="Recipe requirements for the selected pilot. Missing levels are highlighted." TextWrapping="Wrap" Margin="0,0,0,10"/><DataGrid x:Name="RequiredSkills"><DataGrid.Columns><DataGridTextColumn Header="SKILL" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="TRAINED" Binding="{Binding Trained}" Width="*"/><DataGridTextColumn Header="NEEDED" Binding="{Binding Needed}" Width="*"/><DataGridTemplateColumn Header="STATUS" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="PROFITABILITY"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="JOB COST ASSUMPTIONS" FontWeight="Bold" Foreground="#FFD166" Margin="0,0,0,10"/><TextBlock Text="Enter costs allocated to this job, including only the BPC runs consumed. For your own copies include copying costs; enter 0 for no cost. Installation includes facility and SCC charges." TextWrapping="Wrap" Margin="0,0,0,8"/>
<WrapPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="BPC / blueprint cost (ISK)"/><TextBox x:Name="CopyCost" Width="180"/></StackPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="Job start / installation (ISK)"/><TextBox x:Name="JobCost" Width="180"/></StackPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="Sales tax %"/><TextBox x:Name="SaleTax" Width="100"/></StackPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="Broker fee %"/><TextBox x:Name="BrokerFee" Width="100"/></StackPanel></WrapPanel><CheckBox x:Name="InstantSale" Content="Sell immediately to existing buy orders (no sale broker fee)" Margin="0,8"/><Button Content="SAVE &amp; CALCULATE" Click="Calculate_Click" HorizontalAlignment="Left"/><TextBlock x:Name="ProfitHint" TextWrapping="Wrap" Margin="0,10" Foreground="#9FC5C7"/>
<ItemsControl x:Name="ProfitRows"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#102D31" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="{Binding Color}" BorderThickness="2,0,0,0"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding ProfitText}" Foreground="{Binding Color}" FontSize="22" Margin="0,8"/><TextBlock Text="Estimated net profit"/><TextBlock Text="{Binding Breakdown}" Margin="0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding Note}" Foreground="#9FC5C7" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Jita best quotes, not guaranteed fills. Buy orders may take time. No order depth, relisting fees or price movement simulated. Manufacturing/reaction output only; research and BPC outputs are not valued as market items. Recalculate job costs when changing runs." TextWrapping="Wrap" Foreground="#9FC5C7"/></StackPanel></ScrollViewer></TabItem></TabControl></DockPanel></Grid></DockPanel></TabItem>
<TabItem Header="SKILLS &amp; BONUSES"><DockPanel Margin="14"><TextBlock DockPanel.Dock="Top" Text="Active skills and recipe requirements. Manufacturing estimates apply Industry, Advanced Industry and blueprint TE; specialized construction skills, implants and facility effects are not yet included in planner times. Live job finish times come directly from ESI." Foreground="#9FC5C7" TextWrapping="Wrap" Margin="0,0,0,12"/><DataGrid x:Name="Skills"><DataGrid.Columns><DataGridTextColumn Header="SKILL" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="ACTIVE LEVEL" Binding="{Binding Level}" Width="*"/><DataGridTextColumn Header="RELEVANCE" Binding="{Binding Role}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
</TabControl></DockPanel></Window>
