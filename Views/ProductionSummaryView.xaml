<UserControl x:Class="EveCommandCenter.Views.ProductionSummaryView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary Source="IndustryWorkspaceTheme.xaml"/></UserControl.Resources>
 <Border Background="#091B20" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
  <StackPanel>
   <DockPanel LastChildFill="True">
    <Button Content="Open production materials" DockPanel.Dock="Right" Click="Open_Click"/>
    <StackPanel><TextBlock Text="Production materials" FontSize="16" FontWeight="SemiBold" Foreground="#DDF6F4"/>
     <TextBlock x:Name="SummaryText" Text="Saved material plans" Foreground="#91B9BB" Margin="0,5,0,0"/>
    </StackPanel>
   </DockPanel>
   <WrapPanel Margin="0,12,0,6">
    <Border Background="#142F30" CornerRadius="6" Padding="10,6" Margin="0,0,8,6"><TextBlock x:Name="CoveredText" Foreground="#76D7CB"/></Border>
    <Border Background="#332A22" CornerRadius="6" Padding="10,6" Margin="0,0,8,6"><TextBlock x:Name="MissingText" Foreground="#EDAD83"/></Border>
    <Border Background="#203038" CornerRadius="6" Padding="10,6" Margin="0,0,8,6"><TextBlock x:Name="ReviewText" Foreground="#A5BBC1"/></Border>
   </WrapPanel>
   <TextBlock x:Name="DetailText" Foreground="#91B9BB" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <DataGrid x:Name="DashboardMaterialGaps" MaxHeight="310" MinHeight="80" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="Material" SortMemberPath="Name" Width="2*" MinWidth="200">
      <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="6,5"><Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="Available" Binding="{Binding AvailableLabel}" SortMemberPath="Available" Width="120" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
     <DataGridTextColumn Header="Reserved here" Binding="{Binding Reserved, StringFormat=N0}" Width="120" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
     <DataGridTextColumn Header="Missing stock" Binding="{Binding MissingLabel}" SortMemberPath="Missing" Width="145" HeaderStyle="{StaticResource QuantityHeader}">
      <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource QuantityText}"><Setter Property="Foreground" Value="{Binding Color}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
     </DataGridTextColumn>
     <DataGridTextColumn Header="Required" Binding="{Binding Required, StringFormat=N0}" Width="120" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
     <DataGridTextColumn Header="Stock check" Binding="{Binding Status}" Width="160"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Color}"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTextColumn Header="Projects" Binding="{Binding Projects}" Width="*" MinWidth="140"/>
    </DataGrid.Columns>
   </DataGrid>
  </StackPanel>
 </Border>
</UserControl>
