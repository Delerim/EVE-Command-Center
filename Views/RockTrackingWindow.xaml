<Window x:Class="EveCommandCenter.Views.RockTrackingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rock tracking" Width="760" Height="540" MinWidth="680" MinHeight="450" Background="#07181B" Foreground="#DDF6F4" WindowStartupLocation="CenterOwner">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Margin="20"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Heading" Foreground="#55D7D2" FontSize="23" FontWeight="Bold"/><TextBlock Text="ESTIMATED ROCK REMAINING" Foreground="#FFD166" Margin="0,10,0,6"/><TextBlock Text="Enter the current scanned volume in m3, not ore units. Logs do not identify lasers: matching ore is split by yield share (1 + 1 = 50/50). Configure both lasers. Critical bonus yield is excluded. Residue, mining drones, other miners and target changes can make estimates inaccurate. Rescan regularly." TextWrapping="Wrap" Foreground="#9FC5C7" Margin="0,0,0,16"/></StackPanel>
<TextBlock x:Name="Status" DockPanel.Dock="Bottom" Foreground="#FFD166" TextWrapping="Wrap" Margin="0,14,0,0"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#102D31" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="LASER 1" Foreground="#74D6C9" FontWeight="Bold"/><TextBlock Text="Ore name (exact variant)" Margin="0,12,0,4"/><TextBox x:Name="Ore1"/><WrapPanel Margin="0,12,0,4"><StackPanel><TextBlock Text="Current volume m3"/><TextBox x:Name="Volume1" Width="150" Margin="0,4,8,0"/></StackPanel><StackPanel><TextBlock Text="Yield share"/><TextBox x:Name="Share1" Width="65" Text="1" Margin="0,4,0,0"/></StackPanel></WrapPanel><WrapPanel Margin="0,12"><Button Content="SET / NEW ROCK" Tag="0" Click="Set_Click" Margin="0,0,8,0"/><Button Content="PAUSE" Tag="0" Click="Pause_Click"/></WrapPanel><TextBlock x:Name="Left1" Foreground="#74D6C9" TextWrapping="Wrap"/></StackPanel></Border>
<Border Grid.Column="2" Background="#102D31" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="LASER 2" Foreground="#9EBFFF" FontWeight="Bold"/><TextBlock Text="Ore name (exact variant)" Margin="0,12,0,4"/><TextBox x:Name="Ore2"/><WrapPanel Margin="0,12,0,4"><StackPanel><TextBlock Text="Current volume m3"/><TextBox x:Name="Volume2" Width="150" Margin="0,4,8,0"/></StackPanel><StackPanel><TextBlock Text="Yield share"/><TextBox x:Name="Share2" Width="65" Text="1" Margin="0,4,0,0"/></StackPanel></WrapPanel><WrapPanel Margin="0,12"><Button Content="SET / NEW ROCK" Tag="1" Click="Set_Click" Margin="0,0,8,0"/><Button Content="PAUSE" Tag="1" Click="Pause_Click"/></WrapPanel><TextBlock x:Name="Left2" Foreground="#9EBFFF" TextWrapping="Wrap"/></StackPanel></Border>
</Grid></DockPanel></Window>
