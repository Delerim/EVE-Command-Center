<Window x:Class="EveCommandCenter.Views.MoonReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EVE Command Center | Moon Operations" Width="1600" Height="1040" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#07181B" Foreground="#EAF7F7" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Panel" Color="#0C2529"/><SolidColorBrush x:Key="Line" Color="#245058"/><SolidColorBrush x:Key="Muted" Color="#8FB2B5"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="Background" Value="#12383D"/><Setter Property="BorderBrush" Value="#2C6269"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#EAF7F4"/><Setter Property="Background" Value="#101A1E"/><Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemShell" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#17322D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#1C5A4F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EAF7F4"/><Setter Property="Background" Value="#0C171A"/><Setter Property="BorderBrush" Value="#294A44"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><Border x:Name="ComboShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="10,0,4,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="#EAF7F4"/><TextBlock Grid.Column="1" Text="▾" Foreground="#58D3B4" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
     <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="420" Background="#101A1E" BorderBrush="#315E56" BorderThickness="1" CornerRadius="9" Padding="4"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="#3F7569"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="#58D3B4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0A1F23"/><Setter Property="Foreground" Value="#EAF7F7"/><Setter Property="BorderBrush" Value="#2C6269"/><Setter Property="CaretBrush" Value="#55D7D2"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#8FA9A3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="2,0"/><Setter Property="MinHeight" Value="35"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabPill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabPill" Property="Background" Value="#122724"/><Setter TargetName="TabPill" Property="BorderBrush" Value="#294E47"/><Setter Property="Foreground" Value="#DCEAE6"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabPill" Property="Background" Value="#1C5A4F"/><Setter TargetName="TabPill" Property="BorderBrush" Value="#4BB99F"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF2F1"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#173A3F"/><Setter Property="RowBackground" Value="#0A2024"/><Setter Property="AlternatingRowBackground" Value="#0D282C"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8,7"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,6"/><Setter Property="Foreground" Value="#DDF2F1"/></Style>

  <DataTemplate x:Key="MoonOreDetails"><Border Margin="8" Padding="10" CornerRadius="7" Background="#102D31" BorderBrush="#39796C" BorderThickness="1"><StackPanel>
   <TextBlock Text="ORE BREAKDOWN | gold highlights the highest estimated ISK per m3 still available" Foreground="#8FB2B5" Margin="0,0,0,8" TextWrapping="Wrap"/>
   <ItemsControl ItemsSource="{Binding OreRows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Border Width="184" Margin="0,0,8,8" Padding="9" Background="#07181B" BorderBrush="{Binding ValueColor}" BorderThickness="1" CornerRadius="6"><StackPanel>
     <DockPanel><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,6,0"/><TextBlock Text="{Binding Name}" Foreground="{Binding ValueColor}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
     <TextBlock Text="{Binding Remaining}" Foreground="#EAF7F7" Margin="0,7,0,3" FontWeight="Bold"/>
     <ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}" Maximum="100" Height="7" Foreground="{Binding ValueColor}" Background="#18383A"/>
     <TextBlock Text="{Binding PercentText}" Foreground="#8FB2B5" Margin="0,3"/><TextBlock Text="{Binding ValueText}" Foreground="{Binding ValueColor}"/>
     <TextBlock Text="{Binding HourText}" Foreground="{Binding ValueColor}" Margin="0,3,0,0"/>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="ESI average market prices; estimates use the mining rate above. No boost, travel, reprocessing or selling time is included." Foreground="#8FB2B5" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel></Border></DataTemplate>
</ResourceDictionary></Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="2,0,2,12">
   <StackPanel><TextBlock Text="MOON OPERATIONS" FontSize="27" FontWeight="Bold" Foreground="#E8FFFF"/><TextBlock Text="All R4 ore | Monday-based calendar | mined vs despawned | jackpot tracking" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5"><CheckBox x:Name="DesktopAlertsCheck" Content="DESKTOP ALERTS" Foreground="#55D7D2" VerticalAlignment="Center" Click="DesktopAlerts_Click" ToolTip="Moon reset and fuel alerts in the background while Command Center is running, even with this window closed. Refresh ESI to check now."/></StackPanel><TextBlock x:Name="UpdatedText" Text="Not refreshed" HorizontalAlignment="Right" Foreground="#7EA1A4"/><TextBlock Text="Composition comes from saved scans; ledger dates are retained locally" Foreground="#567B7F" FontSize="11"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
    <TextBlock Text="CORP DATA TOON" VerticalAlignment="Center" Foreground="#8FBFC1" FontWeight="SemiBold" Margin="0,0,9,0"/>
    <ComboBox x:Name="PilotCombo" Grid.Column="1" Height="34" DisplayMemberPath="CharacterName"/>
    <Button x:Name="UsePilotButton" Grid.Column="2" Content="USE TOON" Click="UsePilot_Click" Margin="8,0,0,0"/>
    <Button x:Name="ReconnectButton" Grid.Column="3" Content="RECONNECT / ADD" Click="Reconnect_Click" Margin="8,0,0,0"/>
    <Button x:Name="RefreshButton" Grid.Column="4" Content="REFRESH ESI" Click="Refresh_Click" Margin="8,0,0,0" Background="#17656A" BorderBrush="#55D7D2"/>
    <TextBox x:Name="SearchBox" Grid.Column="6" Height="34" TextChanged="SearchBox_TextChanged" ToolTip="Search moon, drill or system"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2"><TextBlock x:Name="CycleLabel" Text="CURRENT CYCLE" Foreground="#74D6C9" Margin="2,0,0,8" TextWrapping="Wrap"/><UniformGrid Columns="6" Margin="0,0,0,10">
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="FRACTURED THIS CYCLE" Foreground="#7EA8AB"/><TextBlock x:Name="ScheduledText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#55D7D2"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="LIVE FIELDS / READY NOW" Foreground="#7EA8AB"/><TextBlock x:Name="ActiveText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#81C784"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="R4 MINED THIS CYCLE" Foreground="#7EA8AB"/><TextBlock x:Name="MinedText" Text="0 m3" FontSize="20" FontWeight="Bold" Foreground="#74D6C9"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#6F3535" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="EST. LOST THIS CYCLE" Foreground="#B89A9A"/><TextBlock x:Name="LostText" Text="0 m3" FontSize="20" FontWeight="Bold" Foreground="#EF5350"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#6F5A2C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="JACKPOTS THIS CYCLE" Foreground="#C9B784"/><TextBlock x:Name="JackpotText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#FFD166"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="EXPIRED WITH ORE THIS CYCLE" Foreground="#7EA8AB"/><TextBlock x:Name="DespawnText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#74D6C9"/></StackPanel></Border>
  </UniformGrid></StackPanel>
  <TabControl x:Name="MoonTabs" Grid.Row="3" Background="#07181B" BorderBrush="#245058">
   <TabItem Header="OVERVIEW"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="100"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="80"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><TextBlock Text="LUNAR OPERATIONS" FontSize="21" FontWeight="Bold" Foreground="#55D7D2"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Estimate m3/s" VerticalAlignment="Center" Foreground="#8FB2B5" Margin="0,0,8,0"/><TextBox x:Name="OverviewRate" Text="50" Width="55" Margin="0,0,16,0" TextChanged="OverviewRate_Changed"/><ComboBox x:Name="OverviewSystem" Width="220" Height="34" HorizontalAlignment="Right" SelectionChanged="OverviewSystem_Changed"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="#0C2529" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="OverviewSummary" FontSize="18" Foreground="#74D6C9" FontWeight="SemiBold"/><TextBlock x:Name="OverviewNext" Foreground="#FFD166" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Fields persist until estimated despawn, even without mining activity. Restart-inferred fields and ore estimates are not live rock scans." TextWrapping="Wrap" Foreground="#8FB2B5" Margin="0,6,0,0"/></StackPanel></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*" MinWidth="180"/></Grid.ColumnDefinitions><GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#245058" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the field and schedule panels"/>
     <DockPanel Margin="0,0,12,12"><TextBlock DockPanel.Dock="Top" Text="FIELDS IN SPACE | select a field for its ledger" Foreground="#55D7D2" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid RowDetailsVisibilityMode="VisibleWhenSelected" RowDetailsTemplate="{StaticResource MoonOreDetails}" x:Name="OverviewFields" SelectionChanged="OverviewField_Changed" AlternationCount="2"><DataGrid.Columns>
      <DataGridTemplateColumn Header="REFINERY / SYSTEM" Width="1.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><Image Source="{Binding StructureImageUri}" Width="24" Height="24" Margin="0,0,7,0"/><TextBlock Text="{Binding StructureName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="SYSTEM" Binding="{Binding SystemName}" Width="*"/><DataGridTextColumn Header="EST. ORE LEFT" Binding="{Binding RemainingSummary}" Width="*"/><DataGridTextColumn Header="DESPAWN" Binding="{Binding FieldExpiry}" Width="1.2*"/>
     </DataGrid.Columns></DataGrid></DockPanel>
     <DockPanel Grid.Column="2" Margin="8,0,0,12"><TextBlock DockPanel.Dock="Top" Text="UP NEXT | extraction schedule" Foreground="#55D7D2" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid RowDetailsVisibilityMode="VisibleWhenSelected" RowDetailsTemplate="{StaticResource MoonOreDetails}" SelectionChanged="OverviewUpcoming_Changed" x:Name="OverviewUpcoming" AlternationCount="2"><DataGrid.Columns><DataGridTemplateColumn Header="REFINERY" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><Image Source="{Binding StructureImageUri}" Width="24" Height="24" Margin="0,0,7,0"/><TextBlock Text="{Binding StructureName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="85"/><DataGridTextColumn Header="WHEN" Binding="{Binding ScheduleValue}" Width="1.2*"/></DataGrid.Columns></DataGrid></DockPanel>
    </Grid>
    <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="#245058" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the field ledger"/><DockPanel Grid.Row="4"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock x:Name="OverviewLedgerTitle" Text="FIELD LEDGER" FontWeight="Bold" Foreground="#55D7D2"/><TextBlock x:Name="OverviewEvidence" Foreground="#8FB2B5" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><DataGrid x:Name="OverviewLedger" AlternationCount="2"><DataGrid.Columns><DataGridTemplateColumn Header="MINER" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Portrait}" Width="22" Height="22" Margin="0,0,7,0"/><TextBlock Text="{Binding CharacterName}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="CORPORATION" Binding="{Binding CorporationName}" Width="*"/><DataGridTextColumn Header="MINED" Binding="{Binding VolumeText}" Width="*"/><DataGridTextColumn Header="EST. VALUE" Binding="{Binding IskText}" Width="*"/><DataGridTextColumn Header="ORE" Binding="{Binding OreBreakdown}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel>
   </Grid></TabItem>
   <TabItem Header="CALENDAR"><Grid Margin="8" Background="#07181B"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Button Content="‹" Click="PreviousPeriod_Click"/><Button Content="TODAY" Click="Today_Click" Margin="6,0"/><Button Content="›" Click="NextPeriod_Click"/><TextBlock x:Name="CalendarTitle" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="#E8FFFF" Margin="14,0,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MonthModeButton" Content="MONTH" Tag="MONTH" Click="CalendarMode_Click"/><Button x:Name="WeekModeButton" Content="WEEK" Tag="WEEK" Click="CalendarMode_Click" Margin="6,0"/><Button x:Name="DayModeButton" Content="DAY" Tag="DAY" Click="CalendarMode_Click"/></StackPanel></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="CalendarHost"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="MOON DETAIL"><Grid Margin="8" Background="#07181B"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Button Content="ALL" Tag="ALL" Click="Filter_Click"/><Button Content="UPCOMING" Tag="UPCOMING" Click="Filter_Click" Margin="6,0,0,0"/><Button Content="ACTIVE" Tag="ACTIVE" Click="Filter_Click" Margin="6,0,0,0"/><Button Content="ORE LEFT" Tag="ALERT" Click="Filter_Click" Margin="6,0,0,0"/><Button Content="JACKPOTS" Tag="JACKPOT" Click="Filter_Click" Margin="6,0,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="LSE audit profiles load automatically" Foreground="#668C90" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="IMPORT MOON SETUP" Click="Import_Click"/><Button Content="EXPORT SETUP CSV" Click="Export_Click" Margin="6,0,0,0"/></StackPanel></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><ItemsControl x:Name="MoonItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="365" MinHeight="315" Margin="5" Background="#0D292D" BorderBrush="#28545A" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="68" Height="68" HorizontalAlignment="Left"><Ellipse Fill="#071416" Stroke="{Binding StatusBrush}" StrokeThickness="3"/><Image Source="{Binding MoonImageUri}" Width="60" Height="60" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/></Image.Clip></Image></Grid><StackPanel Grid.Column="1"><TextBlock Text="{Binding MoonName}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StructureName}" Foreground="#98B7BA" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SystemName}" Foreground="#668C90" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Border Background="{Binding StatusBrush}" CornerRadius="3" Padding="6,2"><TextBlock Text="{Binding Status}" Foreground="#081416" FontWeight="Bold" FontSize="10"/></Border><TextBlock Text="{Binding JackpotLabel}" Foreground="#FFD166" FontWeight="Bold" Margin="8,2,0,0"/></StackPanel></StackPanel></Grid>
      <Grid Margin="0,10,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ScheduleLabel}" Foreground="#789EA1" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ScheduleValue}" FontWeight="SemiBold"/></Grid><Border Height="1" Background="#204449"/>
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ORE" Foreground="#789EA1" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="MINED" Foreground="#789EA1"/><TextBlock Grid.Column="2" Text="EST. LEFT" Foreground="#789EA1"/></Grid>
      <ItemsControl ItemsSource="{Binding OreRows}" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{Binding Color}"/><TextBlock Grid.Column="1" Text="{Binding Mined}"/><TextBlock Grid.Column="2" Text="{Binding Remaining}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel MinWidth="0" Margin="0,0,8,0"><TextBlock Text="{Binding PullLabel}" Foreground="#658C8F" FontSize="10"/><TextBlock Text="{Binding LastFractureLabel}" Foreground="#658C8F" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastFracture}"/></StackPanel><Button Grid.Column="1" Content="EDIT PROFILE" Padding="9,4" FontSize="10" VerticalAlignment="Bottom" Click="Profile_Click"/></Grid>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="DESPAWN AUDIT"><Grid Margin="8" Background="#07181B"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#102D31" BorderBrush="#355C61" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,9"><TextBlock Text="ESTIMATED AUDIT | ESI does not expose rock left in space. Remaining ore is calculated from pull length × 30,000 m3/hour × saved ore profile, minus ledgered mining and configured waste." Foreground="#9FC5C7" TextWrapping="Wrap"/></Border><DataGrid Grid.Row="1" x:Name="AuditGrid" AlternationCount="2" RowDetailsVisibilityMode="Collapsed" HeadersVisibility="Column">
<DataGrid.RowDetailsTemplate><DataTemplate><Border Margin="12,4,12,12" Padding="14" Background="#102D31" BorderBrush="#39796C" BorderThickness="1" CornerRadius="7"><StackPanel>
<TextBlock Text="{Binding StructureName}" Foreground="#55D7D2" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Fractured, StringFormat='Fractured: {0}'}" Foreground="#8FB2B5" Margin="0,4,0,10"/>
<TextBlock Text="Ore remaining is an estimate at expiry, not ore still in space. Unknown outcomes have no reliable remaining-volume estimate." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,0,0,10"/>
<ItemsControl ItemsSource="{Binding OreRows}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<Border Width="235" Padding="12" Margin="0,0,10,6" Background="#07181B" BorderBrush="{Binding Color}" BorderThickness="1" CornerRadius="6"><StackPanel>
<DockPanel><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" Foreground="{Binding Color}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
<TextBlock Text="{Binding Mined, StringFormat='Mined: {0}'}" Margin="0,10,0,5" Foreground="#74D6C9"/>
<StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding DataContext.Reliable, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<TextBlock Text="{Binding Remaining, StringFormat='Est. left at expiry: {0}'}" Foreground="#FFD166"/>
<ProgressBar Value="{Binding RemainingPercent, Mode=OneWay}" Maximum="100" Height="7" Margin="0,8,0,5" Foreground="{Binding Color}" Background="#173A3F"/>
<TextBlock Text="{Binding PercentText}" Foreground="#8FB2B5"/>
</StackPanel></StackPanel></Border>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></DataGrid.RowDetailsTemplate>
<DataGrid.Columns>
