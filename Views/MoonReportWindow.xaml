<Window x:Class="EveMultiPreview.Views.MoonReportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EVE Command Center · Moon Calendar &amp; Reporting" Width="1600" Height="940" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#07181B" Foreground="#EAF7F7" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#0C2529"/><SolidColorBrush x:Key="Line" Color="#245058"/><SolidColorBrush x:Key="Muted" Color="#8FB2B5"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="Background" Value="#12383D"/><Setter Property="BorderBrush" Value="#2C6269"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#0A1F23"/><Setter Property="Foreground" Value="#EAF7F7"/><Setter Property="BorderBrush" Value="#2C6269"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0A1F23"/><Setter Property="Foreground" Value="#EAF7F7"/><Setter Property="BorderBrush" Value="#2C6269"/><Setter Property="CaretBrush" Value="#55D7D2"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A7C9CB"/><Setter Property="Background" Value="#0C2529"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="Padding" Value="18,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF2F1"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#173A3F"/><Setter Property="RowBackground" Value="#0A2024"/><Setter Property="AlternatingRowBackground" Value="#0D282C"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8,7"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,6"/><Setter Property="Foreground" Value="#DDF2F1"/></Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="2,0,2,12">
   <StackPanel><TextBlock Text="MOON CALENDAR &amp; REPORTING" FontSize="27" FontWeight="Bold" Foreground="#E8FFFF"/><TextBlock Text="All R4 ore · Monday-based calendar · mined vs despawned · jackpot tracking" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock x:Name="UpdatedText" Text="Not refreshed" HorizontalAlignment="Right" Foreground="#7EA1A4"/><TextBlock Text="Composition comes from saved scans; ledger dates are retained locally" Foreground="#567B7F" FontSize="11"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
    <TextBlock Text="CORP DATA TOON" VerticalAlignment="Center" Foreground="#8FBFC1" FontWeight="SemiBold" Margin="0,0,9,0"/>
    <ComboBox x:Name="PilotCombo" Grid.Column="1" Height="34" DisplayMemberPath="CharacterName"/>
    <Button x:Name="UsePilotButton" Grid.Column="2" Content="USE TOON" Click="UsePilot_Click" Margin="8,0,0,0"/>
    <Button x:Name="ReconnectButton" Grid.Column="3" Content="RECONNECT / ADD" Click="Reconnect_Click" Margin="8,0,0,0"/>
    <Button x:Name="RefreshButton" Grid.Column="4" Content="REFRESH ESI" Click="Refresh_Click" Margin="8,0,0,0" Background="#17656A" BorderBrush="#55D7D2"/>
    <TextBox x:Name="SearchBox" Grid.Column="6" Height="34" TextChanged="SearchBox_TextChanged" ToolTip="Search moon, drill or system"/>
   </Grid>
  </Border>
  <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,10">
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="SCHEDULED" Foreground="#7EA8AB"/><TextBlock x:Name="ScheduledText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#55D7D2"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="READY / ACTIVE" Foreground="#7EA8AB"/><TextBlock x:Name="ActiveText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#81C784"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="R4 MINED" Foreground="#7EA8AB"/><TextBlock x:Name="MinedText" Text="0 m3" FontSize="20" FontWeight="Bold" Foreground="#74D6C9"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#6F3535" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="EST. DESPAWNED" Foreground="#B89A9A"/><TextBlock x:Name="LostText" Text="0 m3" FontSize="20" FontWeight="Bold" Foreground="#EF5350"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#6F5A2C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="JACKPOTS OBSERVED" Foreground="#C9B784"/><TextBlock x:Name="JackpotText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#FFD166"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="FIELDS WITH ORE LEFT" Foreground="#7EA8AB"/><TextBlock x:Name="DespawnText" Text="0" FontSize="23" FontWeight="Bold" Foreground="#FF8A80"/></StackPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="3" Background="#07181B" BorderBrush="#245058">
   <TabItem Header="CALENDAR"><Grid Margin="8" Background="#07181B"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Button Content="‹" Click="PreviousPeriod_Click"/><Button Content="TODAY" Click="Today_Click" Margin="6,0"/><Button Content="›" Click="NextPeriod_Click"/><TextBlock x:Name="CalendarTitle" VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Foreground="#E8FFFF" Margin="14,0,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="MONTH" Tag="MONTH" Click="CalendarMode_Click"/><Button Content="WEEK" Tag="WEEK" Click="CalendarMode_Click" Margin="6,0"/><Button Content="DAY" Tag="DAY" Click="CalendarMode_Click"/></StackPanel></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CalendarHost"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="MOON DETAIL"><Grid Margin="8" Background="#07181B"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Button Content="ALL" Tag="ALL" Click="Filter_Click"/><Button Content="UPCOMING" Tag="UPCOMING" Click="Filter_Click" Margin="6,0,0,0"/><Button Content="ACTIVE" Tag="ACTIVE" Click="Filter_Click" Margin="6,0,0,0"/><Button Content="ORE LEFT" Tag="ALERT" Click="Filter_Click" Margin="6,0,0,0"/><Button Content="JACKPOTS" Tag="JACKPOT" Click="Filter_Click" Margin="6,0,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="LOAD LSE AUDIT" Click="ImportLseAudit_Click" Background="#4B3A14" BorderBrush="#B9973E"/><Button Content="IMPORT MOON SETUP" Click="Import_Click" Margin="6,0,0,0"/><Button Content="EXPORT SETUP CSV" Click="Export_Click" Margin="6,0,0,0"/></StackPanel></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="MoonItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="365" MinHeight="315" Margin="5" Background="#0D292D" BorderBrush="#28545A" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="68" Height="68" HorizontalAlignment="Left"><Ellipse Fill="#071416" Stroke="{Binding StatusBrush}" StrokeThickness="3"/><Image Source="{Binding MoonImageUri}" Width="60" Height="60" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/></Image.Clip></Image></Grid><StackPanel Grid.Column="1"><TextBlock Text="{Binding MoonName}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StructureName}" Foreground="#98B7BA" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SystemName}" Foreground="#668C90" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Border Background="{Binding StatusBrush}" CornerRadius="3" Padding="6,2"><TextBlock Text="{Binding Status}" Foreground="#081416" FontWeight="Bold" FontSize="10"/></Border><TextBlock Text="{Binding JackpotLabel}" Foreground="#FFD166" FontWeight="Bold" Margin="8,2,0,0"/></StackPanel></StackPanel></Grid>
      <Grid Margin="0,10,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ScheduleLabel}" Foreground="#789EA1" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ScheduleValue}" FontWeight="SemiBold"/></Grid><Border Height="1" Background="#204449"/>
      <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ORE" Foreground="#789EA1" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="MINED" Foreground="#789EA1"/><TextBlock Grid.Column="2" Text="EST. LEFT" Foreground="#789EA1"/></Grid>
      <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Zeolites" Foreground="#CE93D8"/><TextBlock Text="Sylvite" Foreground="#80CBC4"/><TextBlock Text="Bitumens" Foreground="#90CAF9"/><TextBlock Text="Coesite" Foreground="#FFCC80"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding ZeolitesMined}"/><TextBlock Text="{Binding SylviteMined}"/><TextBlock Text="{Binding BitumensMined}"/><TextBlock Text="{Binding CoesiteMined}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding ZeolitesRemaining}"/><TextBlock Text="{Binding SylviteRemaining}"/><TextBlock Text="{Binding BitumensRemaining}"/><TextBlock Text="{Binding CoesiteRemaining}"/></StackPanel></Grid>
      <DockPanel Margin="0,10,0,0"><StackPanel><TextBlock Foreground="#658C8F" FontSize="10"><Run Text="PULL  "/><Run Text="{Binding PullLength}"/></TextBlock><TextBlock Foreground="#658C8F" FontSize="10"><Run Text="LAST FRACTURE  "/><Run Text="{Binding LastFracture}"/></TextBlock></StackPanel><Button DockPanel.Dock="Right" Content="ORE PROFILE" Padding="8,4" FontSize="10" Click="Profile_Click"/></DockPanel>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="DESPAWN AUDIT"><DataGrid x:Name="AuditGrid" Margin="8" AlternationCount="2"><DataGrid.Columns>
    <DataGridTextColumn Header="MOON" Binding="{Binding MoonName}" Width="1.4*"/><DataGridTextColumn Header="EXPIRED" Binding="{Binding Expired}" Width="*"/>
    <DataGridTextColumn Header="ZEO MINED" Binding="{Binding ZeolitesMined}" Width="*"/><DataGridTextColumn Header="ZEO LEFT" Binding="{Binding ZeolitesLeft}" Width="*"/>
    <DataGridTextColumn Header="SYL MINED" Binding="{Binding SylviteMined}" Width="*"/><DataGridTextColumn Header="SYL LEFT" Binding="{Binding SylviteLeft}" Width="*"/>
    <DataGridTextColumn Header="BIT MINED" Binding="{Binding BitumensMined}" Width="*"/><DataGridTextColumn Header="BIT LEFT" Binding="{Binding BitumensLeft}" Width="*"/>
    <DataGridTextColumn Header="COE MINED" Binding="{Binding CoesiteMined}" Width="*"/><DataGridTextColumn Header="COE LEFT" Binding="{Binding CoesiteLeft}" Width="*"/>
    <DataGridTextColumn Header="OUTCOME" Binding="{Binding Outcome}" Width="*"/>
   </DataGrid.Columns></DataGrid></TabItem>
   <TabItem Header="REPORTING"><Grid Margin="8" Background="#07181B"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><TextBlock Text="COMPARE" VerticalAlignment="Center" Foreground="#8FB2B5" Margin="0,0,8,0"/><ComboBox x:Name="ReportKindCombo" Width="120" SelectionChanged="ReportSelection_Changed"><ComboBoxItem Content="MONTHS" IsSelected="True"/><ComboBoxItem Content="WEEKS"/></ComboBox><ComboBox x:Name="CompareACombo" Width="230" Margin="8,0" DisplayMemberPath="Label" SelectionChanged="ReportSelection_Changed"/><TextBlock Text="VS" VerticalAlignment="Center" Foreground="#6F9497"/><ComboBox x:Name="CompareBCombo" Width="230" Margin="8,0" DisplayMemberPath="Label" SelectionChanged="ReportSelection_Changed"/></StackPanel></DockPanel>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10"><Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0"><StackPanel><TextBlock Text="MINED DIFFERENCE" Foreground="#7EA8AB"/><TextBlock x:Name="CompareMinedText" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="DESPAWN DIFFERENCE" Foreground="#7EA8AB"/><TextBlock x:Name="CompareLostText" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0"><StackPanel><TextBlock Text="EFFICIENCY" Foreground="#7EA8AB"/><TextBlock x:Name="CompareEfficiencyText" FontSize="20" FontWeight="Bold"/></StackPanel></Border><Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0"><StackPanel><TextBlock Text="BEST PERIOD" Foreground="#7EA8AB"/><TextBlock x:Name="CompareWinnerText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
    <DataGrid Grid.Row="2" x:Name="PeriodGrid" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="PERIOD" Binding="{Binding Label}" Width="1.6*"/><DataGridTextColumn Header="MINED" Binding="{Binding MinedText}" Width="*"/><DataGridTextColumn Header="DESPAWNED" Binding="{Binding LostText}" Width="*"/><DataGridTextColumn Header="EFFICIENCY" Binding="{Binding EfficiencyText}" Width="*"/><DataGridTextColumn Header="PULLS" Binding="{Binding PullCount}" Width="*"/><DataGridTextColumn Header="JACKPOTS" Binding="{Binding JackpotCount}" Width="*"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
  </TabControl>
  <DockPanel Grid.Row="4" Margin="2,9,2,0"><TextBlock x:Name="StatusText" Text="Select a corporation-data toon, then refresh ESI." Foreground="#8FB2B5"/><TextBlock DockPanel.Dock="Right" Text="Required: Station Manager + Accountant · weeks start Monday" Foreground="#52777B" FontSize="11"/></DockPanel>
 </Grid>
</Window>
