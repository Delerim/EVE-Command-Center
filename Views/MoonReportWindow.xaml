<Window x:Class="EveMultiPreview.Views.MoonReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Command Center · Moon Report"
        Width="1520" Height="900" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#07181B" Foreground="#EAF7F7"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#0C2529"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#102F34"/>
        <SolidColorBrush x:Key="LineBrush" Color="#245058"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8FB2B5"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#55D7D2"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DDF6F4"/>
            <Setter Property="Background" Value="#12383D"/>
            <Setter Property="BorderBrush" Value="#2C6269"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A5056"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#55D7D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0A1F23"/>
            <Setter Property="Foreground" Value="#EAF7F7"/>
            <Setter Property="BorderBrush" Value="#2C6269"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1F23"/>
            <Setter Property="Foreground" Value="#EAF7F7"/>
            <Setter Property="BorderBrush" Value="#2C6269"/>
            <Setter Property="CaretBrush" Value="#55D7D2"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A7C9CB"/>
            <Setter Property="Background" Value="#0C2529"/>
            <Setter Property="BorderBrush" Value="#245058"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#07181B"/>
            <Setter Property="Foreground" Value="#DDF2F1"/>
            <Setter Property="BorderBrush" Value="#245058"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#173A3F"/>
            <Setter Property="RowBackground" Value="#0A2024"/>
            <Setter Property="AlternatingRowBackground" Value="#0D282C"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#12383D"/>
            <Setter Property="Foreground" Value="#9FD2D2"/>
            <Setter Property="BorderBrush" Value="#245058"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="Foreground" Value="#DDF2F1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,12">
            <StackPanel>
                <TextBlock Text="MOON REPORT" FontSize="27" FontWeight="Bold"
                           Foreground="#E8FFFF"/>
                <TextBlock Text="Extraction schedule · fracture history · Zeolites and Bitumens despawn audit"
                           Foreground="{StaticResource MutedBrush}" FontSize="13"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="UpdatedText" Text="Not refreshed"
                           HorizontalAlignment="Right" Foreground="#7EA1A4"/>
                <TextBlock Text="ESI estimates are labelled · tracking improves from first refresh"
                           HorizontalAlignment="Right" Foreground="#567B7F" FontSize="11"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                CornerRadius="7" Padding="11" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="CORP DATA TOON" VerticalAlignment="Center"
                           Foreground="#8FBFC1" FontWeight="SemiBold" Margin="0,0,9,0"/>
                <ComboBox x:Name="PilotCombo" Grid.Column="1" Height="34"
                          DisplayMemberPath="CharacterName"/>
                <Button x:Name="UsePilotButton" Grid.Column="2" Content="USE TOON"
                        Click="UsePilot_Click" Margin="8,0,0,0"/>
                <Button x:Name="ReconnectButton" Grid.Column="3" Content="RECONNECT / ADD"
                        Click="Reconnect_Click" Margin="8,0,0,0"/>
                <Button x:Name="RefreshButton" Grid.Column="4" Content="REFRESH ESI"
                        Click="Refresh_Click" Margin="8,0,0,0"
                        Background="#17656A" BorderBrush="#55D7D2"/>
                <TextBox x:Name="SearchBox" Grid.Column="6" Height="34"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Search moon, drill or system"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                <StackPanel><TextBlock Text="SCHEDULED" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="ScheduledText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#55D7D2"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                <StackPanel><TextBlock Text="READY TO FRACTURE" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="ReadyText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FFB74D"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                <StackPanel><TextBlock Text="ACTIVE FIELDS" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="ActiveText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#81C784"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#0D2B30" BorderBrush="#6F3535"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                <StackPanel><TextBlock Text="TARGET DESPAWNS" Foreground="#B89A9A"/>
                    <TextBlock x:Name="DespawnText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#EF5350"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                <StackPanel><TextBlock Text="ZEOLITES LEFT" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="ZeoLostText" Text="0 m3" FontSize="20" FontWeight="Bold" Foreground="#CE93D8"/></StackPanel>
            </Border>
            <Border Grid.Column="5" Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                <StackPanel><TextBlock Text="BITUMENS LEFT" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="BitumensLostText" Text="0 m3" FontSize="20" FontWeight="Bold" Foreground="#90CAF9"/></StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="3" x:Name="ReportTabs" Background="#07181B"
                    BorderBrush="#245058">
            <TabItem Header="MOON SCHEDULE">
                <Grid Background="#07181B" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ALL" Tag="ALL" Click="Filter_Click"/>
                            <Button Content="UPCOMING" Tag="UPCOMING" Click="Filter_Click" Margin="6,0,0,0"/>
                            <Button Content="ACTIVE" Tag="ACTIVE" Click="Filter_Click" Margin="6,0,0,0"/>
                            <Button Content="TARGET ALERTS" Tag="ALERT" Click="Filter_Click" Margin="6,0,0,0"/>
                            <Button Content="ZEOLITES" Tag="ZEO" Click="Filter_Click" Margin="6,0,0,0"/>
                            <Button Content="BITUMENS" Tag="BITUMENS" Click="Filter_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="IMPORT MOON SETUP" Click="Import_Click"/>
                            <Button Content="EXPORT SETUP CSV" Click="Export_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MoonItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="345" MinHeight="288" Margin="5"
                                            Background="#0D292D" BorderBrush="#28545A"
                                            BorderThickness="1" CornerRadius="8" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="74" Height="74" HorizontalAlignment="Left">
                                                    <Ellipse Fill="#071416" Stroke="{Binding StatusBrush}"
                                                             StrokeThickness="3"/>
                                                    <Image Source="{Binding MoonImageUri}" Stretch="UniformToFill"
                                                           Width="66" Height="66">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="33,33" RadiusX="33" RadiusY="33"/>
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MoonName}" FontSize="16"
                                                               FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StructureName}" Foreground="#98B7BA"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SystemName}" Foreground="#668C90"
                                                               FontSize="11"/>
                                                    <Border Background="{Binding StatusBrush}" CornerRadius="3"
                                                            HorizontalAlignment="Left" Padding="6,2" Margin="0,5,0,0">
                                                        <TextBlock Text="{Binding Status}" Foreground="#081416"
                                                                   FontWeight="Bold" FontSize="10"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,10,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ScheduleLabel}" Foreground="#789EA1"
                                                           FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ScheduleValue}"
                                                           Foreground="#E7FFFF" FontWeight="SemiBold"/>
                                            </Grid>

                                            <Border Grid.Row="2" Height="1" Background="#204449"/>

                                            <Grid Grid.Row="3" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ORE" Foreground="#789EA1" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="MINED" Foreground="#789EA1" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="EST. LEFT" Foreground="#789EA1" FontWeight="SemiBold"/>
                                            </Grid>
                                            <Grid Grid.Row="4" Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Zeolites" Foreground="#CE93D8"/>
                                                    <TextBlock Text="Bitumens" Foreground="#90CAF9" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ZeolitesMined}"/>
                                                    <TextBlock Text="{Binding BitumensMined}" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding ZeolitesRemaining}"/>
                                                    <TextBlock Text="{Binding BitumensRemaining}" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="5" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="PULL  " Foreground="#658C8F" FontSize="10"/>
                                                        <TextBlock Text="{Binding PullLength}" Foreground="#658C8F" FontSize="10"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="LAST FRACTURE  " Foreground="#658C8F" FontSize="10"/>
                                                        <TextBlock Text="{Binding LastFracture}" Foreground="#658C8F" FontSize="10"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="ORE PROFILE" Padding="8,4"
                                                        FontSize="10" Click="Profile_Click"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="DESPAWN AUDIT">
                <Grid Background="#07181B" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="2,2,2,10" Foreground="#8FB2B5"
                               Text="A field is audited when its configured lifetime expires. Remaining ore is estimated from pull length, moon profile, mined ledger volume and waste percentage."/>
                    <DataGrid Grid.Row="1" x:Name="AuditGrid" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MOON" Binding="{Binding MoonName}" Width="1.5*"/>
                            <DataGridTextColumn Header="DRILL" Binding="{Binding StructureName}" Width="1.3*"/>
                            <DataGridTextColumn Header="SYSTEM" Binding="{Binding SystemName}" Width="*"/>
                            <DataGridTextColumn Header="FRACTURED" Binding="{Binding Fractured}" Width="*"/>
                            <DataGridTextColumn Header="EXPIRED" Binding="{Binding Expired}" Width="*"/>
                            <DataGridTextColumn Header="ZEO MINED" Binding="{Binding ZeolitesMined}" Width="*"/>
                            <DataGridTextColumn Header="ZEO LEFT" Binding="{Binding ZeolitesLeft}" Width="*"/>
                            <DataGridTextColumn Header="BITUMENS MINED" Binding="{Binding BitumensMined}" Width="*"/>
                            <DataGridTextColumn Header="BITUMENS LEFT" Binding="{Binding BitumensLeft}" Width="*"/>
                            <DataGridTemplateColumn Header="OUTCOME" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding OutcomeBrush}" CornerRadius="3"
                                                Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Outcome}" Foreground="#071416"
                                                       FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="2,9,2,0">
            <TextBlock x:Name="StatusText" Text="Select a corporation-data toon, then refresh ESI."
                       Foreground="#8FB2B5"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="Required: Station Manager + Accountant · ESI history is about 30 days"
                       Foreground="#52777B" FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
