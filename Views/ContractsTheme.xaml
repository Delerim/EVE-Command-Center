<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Panel" Color="#0C2529"/><SolidColorBrush x:Key="Line" Color="#245058"/><SolidColorBrush x:Key="Muted" Color="#8FB2B5"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#DDF6F4"/><Setter Property="Background" Value="#12383D"/><Setter Property="BorderBrush" Value="#2C6269"/><Setter Property="Padding" Value="12,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#EAF7F4"/><Setter Property="Background" Value="#101A1E"/><Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemShell" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#17322D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="#1C5A4F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EAF7F4"/><Setter Property="Background" Value="#0C171A"/><Setter Property="BorderBrush" Value="#294A44"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><Border x:Name="ComboShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Grid.Column="0" Margin="10,0,4,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" TextElement.Foreground="#EAF7F4"/><TextBlock Grid.Column="1" Text="&#x25BE;" Foreground="#58D3B4" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
     <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="420" Background="#101A1E" BorderBrush="#315E56" BorderThickness="1" CornerRadius="9" Padding="4"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="#3F7569"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboShell" Property="BorderBrush" Value="#58D3B4"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0A1F23"/><Setter Property="Foreground" Value="#EAF7F7"/><Setter Property="BorderBrush" Value="#2C6269"/><Setter Property="CaretBrush" Value="#55D7D2"/><Setter Property="Padding" Value="8,5"/></Style>

  <Style TargetType="DataGrid"><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="Background" Value="#07181B"/><Setter Property="Foreground" Value="#DDF2F1"/><Setter Property="BorderBrush" Value="#245058"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#173A3F"/><Setter Property="RowBackground" Value="#0A2024"/><Setter Property="AlternatingRowBackground" Value="#0D282C"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#12383D"/><Setter Property="Foreground" Value="#9FD2D2"/><Setter Property="Padding" Value="8,7"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,6"/><Setter Property="Foreground" Value="#DDF2F1"/></Style>
         <Style x:Key="EccScrollThumb"
               TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody"
                                Background="#355C55"
                                CornerRadius="5"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBody"
                                        Property="Background"
                                        Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBody"
                                        Property="Background"
                                        Value="#7BE7CF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ThumbBody"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="EccVerticalScrollBarTemplate"
                         TargetType="{x:Type ScrollBar}">
            <Border Background="#091315"
                    BorderBrush="#18302C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="11">
                <Track x:Name="PART_Track"
                       Orientation="Vertical"
                       IsDirectionReversed="True"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource EccScrollThumb}"
                               MinHeight="26"/>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="EccHorizontalScrollBarTemplate"
                         TargetType="{x:Type ScrollBar}">
            <Border Background="#091315"
                    BorderBrush="#18302C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="11">
                <Track x:Name="PART_Track"
                       Orientation="Horizontal"
                       IsDirectionReversed="False"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource EccScrollThumb}"
                               MinWidth="26"/>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background"
                    Value="#091315"/>
            <Setter Property="Foreground"
                    Value="#58D3B4"/>
            <Setter Property="Width"
                    Value="11"/>
            <Setter Property="Template"
                    Value="{StaticResource EccVerticalScrollBarTemplate}"/>

            <Style.Triggers>
                <Trigger Property="Orientation"
                         Value="Horizontal">
                    <Setter Property="Width"
                            Value="Auto"/>
                    <Setter Property="Height"
                            Value="11"/>
                    <Setter Property="Template"
                            Value="{StaticResource EccHorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#8FA9A3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="2,0"/><Setter Property="MinHeight" Value="35"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabPill" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabPill" Property="Background" Value="#122724"/><Setter TargetName="TabPill" Property="BorderBrush" Value="#294E47"/><Setter Property="Foreground" Value="#DCEAE6"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabPill" Property="Background" Value="#1C5A4F"/><Setter TargetName="TabPill" Property="BorderBrush" Value="#4BB99F"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
