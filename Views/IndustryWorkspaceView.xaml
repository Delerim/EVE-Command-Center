<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="EveCommandCenter.Views.IndustryWorkspaceView" Background="#07181B" Foreground="#DDF6F4">
  <UserControl.Resources>
    <ResourceDictionary Source="IndustryWorkspaceTheme.xaml" />
  </UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <WrapPanel>
        <TextBlock Text="Production workspace" Foreground="#55D7D2" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,15,0" />
        <Button Content="Reload workspace" Click="Reload_Click" />
        <CheckBox x:Name="ShowArchived" Content="Show archived" Click="Reload_Click" />
        <Button x:Name="RecoverButton" Content="RESTORE LAST GOOD BACKUP" Click="Recover_Click" Visibility="Collapsed" />
      </WrapPanel>
      <TextBlock x:Name="Message" Foreground="#8FB2B5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="3,5" />
    </StackPanel>
    <Grid Grid.Row="1" x:Name="ProjectWorkspace" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390" MinWidth="300" x:Name="NavigationWidth" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="540" />
      </Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,10,0">
        <Button Content="← All projects" Click="BackProjects_Click" HorizontalAlignment="Left" DockPanel.Dock="Top" />
        <DockPanel DockPanel.Dock="Top">
          <Button DockPanel.Dock="Right" Content="Delete" Click="ShowDelete_Click" Foreground="#E8A9A5" Padding="10,4" />
          <TextBlock Text="CURRENT PROJECT" Foreground="#8FB6BA" VerticalAlignment="Center" Margin="3,8" />
        </DockPanel>
        <Expander x:Name="DeletePrompt" Visibility="Collapsed" DockPanel.Dock="Top" Header="Delete selected project" Foreground="#E8A9A5" Margin="6,8">
          <StackPanel Margin="3,8">
            <TextBlock x:Name="DeleteSummary" TextWrapping="Wrap" />
            <CheckBox x:Name="ConfirmDelete" Content="Release its reservations and delete" />
            <Button Content="Delete project" Click="DeleteProject_Click" Foreground="#FFC4BC" BorderBrush="#915C58" />
          </StackPanel>
        </Expander>
        <TextBlock DockPanel.Dock="Top" Text="COMPONENTS &amp; MATERIALS" Foreground="#8FB6BA" Margin="3,12,0,6" />
        <TreeView ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="Nodes" SelectedItemChanged="Node_Selected" Background="#091C20" Foreground="#DDF6F4" BorderBrush="#245058">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource ComponentTreeItem}" />
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <Grid Margin="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="38" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#20383D" CornerRadius="6" Width="30" Height="30">
                  <Grid>
                    <TextBlock Text="◇" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Icon}" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#E5F1F2" />
                  <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{Binding Color}" FontSize="11" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding Readiness}" FontSize="11" Foreground="#A6C3C6" Margin="0,4,0,0" ToolTip="{Binding ReadinessDetail}" />
                </StackPanel>
              </Grid>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#245058" />
      <TabControl SelectionChanged="WorkspaceTab_Changed" x:Name="WorkspaceTabs" SelectedIndex="0" Grid.Column="2" Background="#07181B" BorderBrush="#245058">
        <TabItem x:Name="ProjectDetailTab" Header="Component">
          <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid>
              <Border x:Name="WorkspaceEmpty" Style="{StaticResource Card}" Margin="18">
                <StackPanel>
                  <TextBlock Text="Plan your next build" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="Choose an owned blueprint in the Blueprint library, then create a production plan. Its components, stock and jobs stay together here." TextWrapping="Wrap" Margin="0,10" />
                </StackPanel>
              </Border>
              <Grid x:Name="ProjectEditor" Visibility="Collapsed" Margin="12">
                <DockPanel x:Name="NodeEditor" Visibility="Collapsed">
                  <Border Style="{StaticResource Card}" Padding="12" DockPanel.Dock="Top">
                    <DockPanel>
                      <Border Width="40" Height="40" CornerRadius="9" Background="#1B383D" Margin="0,0,14,0">
                        <Grid>
                          <TextBlock Text="◇" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image x:Name="NodeIcon" />
                        </Grid>
                      </Border>
                      <StackPanel>
                        <TextBlock x:Name="NodeTitle" Foreground="#F0FAFA" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="NodeSummary" Foreground="#8FB6BA" Margin="0,6,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <WrapPanel DockPanel.Dock="Top">
                    <StackPanel>
                      <TextBlock Text="Required output units" />
                      <TextBox x:Name="NodeQuantity" Width="120" Height="34" ToolTip="Calculated demand from the parent blueprint. Select a blueprint to recalculate material efficiency." />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Builder / buyer" />
                      <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="Executor" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Make / Buy / Use Stock" />
                      <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="Strategy" Width="120" />
                    </StackPanel>
                    <Button Content="Save component" Click="SaveNode_Click" VerticalAlignment="Bottom" />
                  </WrapPanel>
                  <TabControl x:Name="ComponentTabs" Background="#07181B" BorderThickness="0" Margin="0,8,0,0">
                    <TabItem Header="Inputs">
                      <DockPanel Margin="0,12">
                        <TextBlock x:Name="InputsHint" Margin="0,0,0,8" TextWrapping="Wrap" DockPanel.Dock="Top" />
                        <DataGrid x:Name="ComponentInputs" ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="45" SelectionChanged="Input_Selected">
                          <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Component / material" SortMemberPath="Name" Width="260" MinWidth="210">
                              <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <DockPanel>
                                    <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                  </DockPanel>
                                </DataTemplate>
                              </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Available" SortMemberPath="SortAvailable" Binding="{Binding Free}" Width="100" MinWidth="85">
                              <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                  <Setter Property="Foreground" Value="#83CFC1" />
                                </Style>
                              </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Missing stock" SortMemberPath="SortMissing" Width="115" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MissingLabel}" Foreground="{Binding StockColor}" FontWeight="SemiBold" HorizontalAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Required" Binding="{Binding Quantity, StringFormat=N0}" Width="100" MinWidth="85">
                              <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                  <Setter Property="Foreground" Value="#C5DADD" />
                                </Style>
                              </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Reserved" Binding="{Binding Reserved, StringFormat=N0}" Width="100" MinWidth="85">
                              <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                  <Setter Property="HorizontalAlignment" Value="Right" />
                                  <Setter Property="Foreground" Value="#C5DADD" />
                                </Style>
                              </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Stock check" SortMemberPath="StockStatus" Width="155" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StockStatus}" Foreground="{Binding StockColor}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Source" Binding="{Binding Strategy}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </TabItem>
                    <TabItem Header="Assign &amp; track">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10">

                          <Expander Header="1. Blueprint for this build" IsExpanded="False" Margin="0,0,0,12">
                            <StackPanel Margin="0,10">
                              <TextBlock x:Name="ComponentBlueprintHint" TextWrapping="Wrap" Margin="0,0,0,8" />
                              <WrapPanel Margin="0,0,0,8">
                                <ComboBox x:Name="ComponentBlueprintOwner" Style="{StaticResource WorkspaceCombo}" DisplayMemberPath="Name" SelectionChanged="ComponentBlueprintOwner_Changed" />
                                <ComboBox x:Name="ComponentBlueprintLocation" Style="{StaticResource WorkspaceCombo}" MaxWidth="450" SelectionChanged="ComponentBlueprintLocation_Changed" />
                              </WrapPanel>
                              <Grid Height="220" x:Name="ComponentBlueprintsFrame">
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="*" />
                                  <RowDefinition Height="8" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="ComponentBlueprints" MinHeight="45">
                                  <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Blueprint" SortMemberPath="Name" Width="2*">
                                      <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                          <DockPanel>
                                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                          </DockPanel>
                                        </DataTemplate>
                                      </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*" />
                                    <DataGridTextColumn Header="ME / TE" SortMemberPath="ME" Binding="{Binding Efficiency}" Width="*" />
                                    <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Runs" SortMemberPath="Runs" Binding="{Binding RunText}" Width="70"  ElementStyle="{StaticResource QuantityText}"/>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" />
                                    <DataGridTextColumn Header="Availability" Binding="{Binding Status}" Width="*" />
                                  </DataGrid.Columns>
                                </DataGrid>
                                <Thumb Height="8" Cursor="SizeNS" DragDelta="ResizeTable_DragDelta" Grid.Row="1">
                                  <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                      <Border Background="#284950" CornerRadius="3" Margin="0,2">
                                        <Border Width="35" Height="2" Background="#80B4B9" HorizontalAlignment="Center" />
                                      </Border>
                                    </ControlTemplate>
                                  </Thumb.Template>
                                </Thumb>
                              </Grid>
                              <Button Content="Select blueprint &amp; recalculate inputs" Click="SelectComponentBlueprint_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                          </Expander>

                          <Border x:Name="PlannedJobPanel" Style="{StaticResource Card}" Margin="0,14,0,12">
                            <StackPanel>
                              <TextBlock Text="2. Assign the builder" Foreground="#55D7D2" FontWeight="Bold" />
                              <TextBlock x:Name="PlannedJobStatus" TextWrapping="Wrap" Margin="0,5" />
                              <WrapPanel>
                                <TextBlock Text="Production location" VerticalAlignment="Center" />
                                <ComboBox x:Name="JobFacilityPicker" Style="{StaticResource WorkspaceCombo}" MaxWidth="350" SelectionChanged="Facility_Changed" />
                                <TextBox x:Name="JobFacility" Visibility="Collapsed" />
                                <Button Content="Assign builder" Click="PlanJob_Click" />
                                <Button Content="Clear job assignment" Click="RemovePlanJob_Click" />
                              </WrapPanel>
                              <TextBlock Text="Uses the builder selected above. Save the assignment here, start manufacturing in EVE, then link that job below." TextWrapping="Wrap" Foreground="#8FB2B5" />
                            </StackPanel>
                          </Border>
                          <Border x:Name="ActualJobPanel" Style="{StaticResource Card}">
                            <StackPanel>
                              <TextBlock Text="3. Link the job started in EVE" Style="{StaticResource SectionTitle}" />
                              <TextBlock x:Name="ActualJobStatus" TextWrapping="Wrap" Margin="0,0,0,10" />
                              <Grid Height="240" x:Name="ExistingJobsFrame">
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="*" />
                                  <RowDefinition Height="8" />
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="ExistingJobs" MinHeight="45" SelectionChanged="Job_Selected">
                                  <DataGrid.Columns>
                                    <DataGridTextColumn Header="Toon" Binding="{Binding Owner}" Width="*" />
                                    <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Runs" Binding="{Binding Link.Runs}" Width="60"  ElementStyle="{StaticResource QuantityText}"/>
                                    <DataGridTextColumn Header="Facility" Binding="{Binding Facility}" Width="2*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
                                    <DataGridTextColumn Header="Ends (EVE)" SortMemberPath="Link.EndUtc" Binding="{Binding End}" Width="135" />
                                  </DataGrid.Columns>
                                </DataGrid>
                                <Thumb Height="8" Cursor="SizeNS" DragDelta="ResizeTable_DragDelta" Grid.Row="1">
                                  <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                      <Border Background="#284950" CornerRadius="3" Margin="0,2">
                                        <Border Width="35" Height="2" Background="#80B4B9" HorizontalAlignment="Center" />
                                      </Border>
                                    </ControlTemplate>
                                  </Thumb.Template>
                                </Thumb>
                              </Grid>
                              <TextBlock x:Name="JobEvidence" TextWrapping="Wrap" Margin="0,10" />
                              <WrapPanel>
                                <Button x:Name="MatchJobButton" Content="Link selected EVE job" Click="MatchJob_Click" IsEnabled="False" />
                                <Button Content="Unlink job" Click="UnmatchJob_Click" />
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Stock &amp; transfers">
                      <DockPanel Margin="0,8">
                        <WrapPanel Margin="0,6" DockPanel.Dock="Top">
                          <ComboBox x:Name="StockOwner" Style="{StaticResource WorkspaceCombo}" DisplayMemberPath="Name" SelectionChanged="StockOwner_Changed" MinWidth="150" MaxWidth="250" />
                          <ComboBox x:Name="StockLocation" Style="{StaticResource WorkspaceCombo}" MaxWidth="250" SelectionChanged="StockLocation_Changed" MinWidth="150" />
                          <TextBox x:Name="StockSearch" ToolTip="Search stock by pilot, station or container" TextChanged="StockSearch_Changed" DockPanel.Dock="Top" Width="190" />
                        </WrapPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                          <WrapPanel>
                            <TextBlock Text="Reserve quantity" VerticalAlignment="Center" />
                            <TextBox x:Name="ReserveQuantity" Width="100" Text="1" />
                            <Button Content="RESERVE SELECTED STACK" Click="Reserve_Click" />
                            <Button Content="RELEASE SELECTED RESERVATION" Click="Release_Click" HorizontalAlignment="Left" DockPanel.Dock="Bottom" />
                          </WrapPanel>
                          <TextBlock x:Name="Coverage" Foreground="#FFD166" TextWrapping="NoWrap" Margin="3,7" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <Grid Margin="0,12" x:Name="StockLayout">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="2*" MinHeight="65" x:Name="StockHeight" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" MinHeight="60" />
                          </Grid.RowDefinitions>
                          <GridSplitter Height="6" HorizontalAlignment="Stretch" Background="#284950" Grid.Row="1" />
                          <DataGrid x:Name="Stock" MinHeight="50">
                            <DataGrid.Columns>
                              <DataGridTemplateColumn Header="Material" SortMemberPath="Name" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                  <DataTemplate>
                                    <DockPanel>
                                      <Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,8,0" />
                                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                  </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                              </DataGridTemplateColumn>
                              <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Free" SortMemberPath="SortFree" Binding="{Binding Free}" Width="115" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="#83CFC1" />
                                  </Style>
                                </DataGridTextColumn.ElementStyle>
                              </DataGridTextColumn>
                              <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Observed" Binding="{Binding Quantity, StringFormat=N0}" Width="115" MinWidth="90">
                                <DataGridTextColumn.ElementStyle>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="#C5DADD" />
                                  </Style>
                                </DataGridTextColumn.ElementStyle>
                              </DataGridTextColumn>
                              <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Reserved" Binding="{Binding Reserved, StringFormat=N0}" Width="100"  ElementStyle="{StaticResource QuantityText}"/>
                              <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="145" />
                              <DataGridTextColumn Header="Station / container" Binding="{Binding Path}" Width="*" MinWidth="210" />
                              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Detail}" />
                              </Style>
                            </DataGrid.RowStyle>
                          </DataGrid>
                          <DataGrid x:Name="Reservations" MinHeight="45" Grid.Row="2">
                            <DataGrid.Columns>
                              <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Units" Binding="{Binding Quantity}" Width="70"  ElementStyle="{StaticResource QuantityText}"/>
                              <DataGridTextColumn Header="Reserved source" Binding="{Binding Source}" Width="2*" />
                              <DataGridTextColumn Header="Review" Binding="{Binding Review}" Width="2*" />
                            </DataGrid.Columns>
                          </DataGrid>
                        </Grid>
                      </DockPanel>
                    </TabItem>
                    <TabItem Header="Notes &amp; assumptions">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10">
                          <TextBlock Text="Notes" Margin="3,8,0,0" />
                          <TextBox x:Name="NodeNotes" ToolTip="Component notes, job/haul planning" TextWrapping="Wrap" AcceptsReturn="True" />
                          <TextBlock x:Name="Eligibility" TextWrapping="Wrap" Foreground="#FFD166" Margin="3,5" />
                          <WrapPanel x:Name="ManualChildControls" Margin="0,4">
                            <StackPanel>
                              <TextBlock Text="Component" />
                              <TextBox x:Name="ChildType" Width="130" Visibility="Collapsed" />
                              <TextBlock Text="Choose a product above" Margin="4,10" MinWidth="160" x:Name="SelectedChildName" />
                            </StackPanel>
                            <StackPanel>
                              <TextBlock Text="Child quantity" />
                              <TextBox x:Name="ChildQuantity" Width="100" Text="1" />
                            </StackPanel>
                            <Button Content="ADD CHILD COMPONENT" Click="AddChild_Click" VerticalAlignment="Bottom" />
                          </WrapPanel>
                          <Expander Header="Project settings" Foreground="#74D6C9" Margin="3,0,3,6">
                            <Border BorderBrush="#245058" BorderThickness="1" Background="#102D31" Padding="10" CornerRadius="5">
                              <StackPanel>
                                <Button Content="GENERATE MATERIAL TREE FOR THIS DRAFT" Click="ExpandDraft_Click" HorizontalAlignment="Right" />
                                <TextBlock x:Name="ProjectIdentity" Foreground="#55D7D2" FontWeight="Bold" />
                                <WrapPanel>
                                  <StackPanel>
                                    <TextBlock Text="Name" />
                                    <TextBox x:Name="ProjectName" Width="190" />
                                  </StackPanel>
                                  <StackPanel>
                                    <TextBlock Text="Project owner" ToolTip="Changing the lead does not filter or reassign child components" />
                                    <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="ProjectLead" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                  </StackPanel>
                                  <StackPanel>
                                    <TextBlock Text="Buyer" />
                                    <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="ProjectBuyer" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                  </StackPanel>
                                  <StackPanel>
                                    <TextBlock Text="Seller" />
                                    <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="ProjectSeller" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                  </StackPanel>
                                </WrapPanel>
                                <TextBox x:Name="ProjectNotes" ToolTip="Project notes" MinHeight="32" TextWrapping="Wrap" AcceptsReturn="True" />
                                <WrapPanel>
                                  <CheckBox x:Name="Paused" Content="Paused (holds reservations)" />
                                  <CheckBox x:Name="Archived" Content="Archived" />
                                  <Button Content="SAVE PROJECT" Click="SaveProject_Click" />
                                </WrapPanel>
                              </StackPanel>
                            </Border>
                          </Expander>
                          <Expander Header="Project history" Foreground="#74D6C9" Margin="0,10">
                            <TextBlock x:Name="Audit" TextWrapping="Wrap" Margin="8" />
                          </Expander>
                          <Expander Header="Transfer / haul requirement" Margin="0,12" DockPanel.Dock="Bottom">
                            <StackPanel>
                              <CheckBox x:Name="TransferNeeded" Content="Transfer needed before use at the next stage" />
                              <TextBox x:Name="TransferNote" ToolTip="Origin, destination and handoff instructions" />
                              <Button Content="Save transfer requirement" Click="Transfer_Click" HorizontalAlignment="Left" />
                              <TextBlock Text="A saved requirement does not confirm delivery. Asset disappearance never completes a transfer." TextWrapping="Wrap" />
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </ScrollViewer>
                    </TabItem>
                  </TabControl>
                </DockPanel>
              </Grid>
            </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="LibraryTab" Header="Blueprint library" Visibility="Collapsed">
     </TabItem>
        <TabItem x:Name="MaterialsTab" Header="All project materials">
          <DockPanel Margin="12">
            <TextBlock Text="Green: stock covers demand. Amber: missing stock. Grey: inventory needs checking. Available excludes all reservations; missing stock subtracts available and reserved-here quantities. To reserve is an allocation task, not a stock shortage. N/A means none found; Unknown means not confirmed. Shared stock still needs reserving; location and hauling are separate." TextWrapping="Wrap" Margin="3,8" DockPanel.Dock="Top" />
            <Button Content="COPY MATERIALS LIST" Click="CopyShopping_Click" HorizontalAlignment="Left" DockPanel.Dock="Bottom" />
            <DataGrid x:Name="Shopping" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Material" SortMemberPath="Name" Width="240" MinWidth="200">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Available" SortMemberPath="SortAvailable" Binding="{Binding FreeLabel}" Width="100" MinWidth="85">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="#83CFC1" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Missing stock" SortMemberPath="SortMissing" Width="115" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MissingLabel}" Foreground="{Binding StockColor}" FontWeight="SemiBold" HorizontalAlignment="Right" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Required" Binding="{Binding Required, StringFormat=N0}" Width="100" MinWidth="85">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="#C5DADD" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Reserved here" Binding="{Binding Reserved, StringFormat=N0}" Width="115" MinWidth="115">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="#C5DADD" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Stock check" SortMemberPath="StockStatus" Width="155" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StockStatus}" Foreground="{Binding StockColor}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Owned" SortMemberPath="SortOwned" Binding="{Binding OwnedLabel}" Width="100" MinWidth="85"  ElementStyle="{StaticResource QuantityText}"/>
                <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="All reserved" Binding="{Binding TotalReserved, StringFormat=N0}" Width="100" MinWidth="85"  ElementStyle="{StaticResource QuantityText}"/>
                <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="To reserve" Binding="{Binding Unreserved, StringFormat=N0}" Width="100" MinWidth="85">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right" />
                      <Setter Property="Foreground" Value="#C5DADD" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Projects" Binding="{Binding Projects}" Width="*" />
              </DataGrid.Columns>
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                  <Setter Property="ToolTip" Value="{Binding Review}" />
                </Style>
              </DataGrid.RowStyle>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="SkillsTab" Header="Required skills">
          <DockPanel Margin="14">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Who can build this project?" FontSize="20" Foreground="#E1F3F2" Margin="0,0,0,8"/>
              <TextBlock x:Name="SkillsScope" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <ListBox x:Name="SkillPilots" SelectionChanged="SkillPilot_Selected" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Width="168" Margin="6">
                  <Image Source="{Binding Portrait}" Width="36" Height="36" Margin="0,0,8,0"/>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#E1F3F2"/><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="SkillsStatus" TextWrapping="Wrap" Margin="0,12"/>
            </StackPanel>
            <DataGrid x:Name="ProjectSkills"><DataGrid.Columns>
              <DataGridTemplateColumn Header="Skill" SortMemberPath="Name" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="Trained" Binding="{Binding Trained}" Width="80"/>
              <DataGridTextColumn HeaderStyle="{StaticResource QuantityHeader}" Header="Required" Binding="{Binding Required}" Width="80" ElementStyle="{StaticResource QuantityText}"/>
              <DataGridTemplateColumn Header="Training needed" SortMemberPath="Training" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Training}" Foreground="{Binding Color}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Used by" SortMemberPath="Products" Width="3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Products}" TextWrapping="Wrap" ToolTip="{Binding Products}" Margin="0,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns></DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem x:Name="ProjectPurchasesTab" Header="Purchases">
         <DockPanel Margin="14">
          <StackPanel DockPanel.Dock="Top">
           <DockPanel><Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Reload purchases" Click="ReloadProjectPurchases_Click"/><StackPanel><TextBlock Text="Purchase costs" FontSize="22" FontWeight="SemiBold" Foreground="#E1F3F2"/><TextBlock Text="What you paid for this project's materials and components" Foreground="#91B9BB" Margin="0,5,0,16"/></StackPanel></DockPanel>
           <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Background="#112D31" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderBrush="#76D7CB" BorderThickness="0,2,0,0"><StackPanel><TextBlock Text="ATTRIBUTED PURCHASE COST" FontSize="10" Foreground="#91B9BB"/><TextBlock x:Name="ProjectPurchaseSummary" Margin="0,8,0,0" FontSize="20" Foreground="#76D7CB" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Background="#11282E" CornerRadius="8" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="ITEMS PURCHASED" FontSize="10" Foreground="#91B9BB"/><TextBlock x:Name="ProjectPurchaseItems" FontSize="20" Foreground="#DEEDF0" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Background="#11282E" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="PURCHASES" FontSize="10" Foreground="#91B9BB"/><TextBlock x:Name="ProjectPurchaseCount" FontSize="20" Foreground="#DEEDF0" Margin="0,8,0,0"/></StackPanel></Border>
           </UniformGrid>
           <TextBlock Text="Costs cover assigned purchases only. Fees, manufacturing costs and previously owned stock are separate. Purchased does not mean delivered or reserved." TextWrapping="Wrap" Foreground="#91B9BB" Margin="0,0,0,14"/>
           <TextBlock x:Name="ProjectPurchaseEmpty" TextWrapping="Wrap" Margin="12,20"/>
          </StackPanel>
          <TabControl x:Name="ProjectCostViews" Background="Transparent" BorderThickness="0">
           <TabItem Header="By item"><DockPanel Margin="0,12,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button x:Name="InspectItemPurchases" DockPanel.Dock="Right" Content="View selected item's purchases" IsEnabled="False" Click="InspectItemPurchases_Click"/><TextBlock Text="Average price = assigned cost / assigned quantity. Select an item to inspect its purchases." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#91B9BB"/></DockPanel>
            <DataGrid x:Name="ProjectItemCosts" SelectionChanged="ProjectCost_Selected" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
             <DataGridTemplateColumn Header="Item" SortMemberPath="Name" Width="2*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Name}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
             <DataGridTextColumn Header="Quantity bought" Binding="{Binding Quantity, StringFormat=N0}" Width="135" MinWidth="135" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
             <DataGridTextColumn Header="Average price" Binding="{Binding AveragePrice, StringFormat=N4}" Width="145" MinWidth="145" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
             <DataGridTextColumn Header="Total paid (ISK)" Binding="{Binding Cost, StringFormat=N2}" Width="160" MinWidth="160" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
             <DataGridTextColumn Header="Lowest price" Binding="{Binding LowestPrice, StringFormat=N4}" Width="130" MinWidth="130" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
             <DataGridTextColumn Header="Highest price" Binding="{Binding HighestPrice, StringFormat=N4}" Width="130" MinWidth="130" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
             <DataGridTextColumn Header="Purchases" Binding="{Binding Purchases, StringFormat=N0}" Width="100" MinWidth="100" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
             <DataGridTextColumn Header="Last bought (UTC)" Binding="{Binding LastBought, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="160" MinWidth="160"/>
            </DataGrid.Columns></DataGrid>
           </DockPanel></TabItem>
           <TabItem Header="Purchases"><DockPanel Margin="0,12,0,0"><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button x:Name="ClearPurchaseFilter" DockPanel.Dock="Right" Content="Show all items" Click="ClearPurchaseFilter_Click" Visibility="Collapsed"/><TextBlock x:Name="ProjectPurchaseFilter" VerticalAlignment="Center" Foreground="#91B9BB"/></DockPanel>
          <DataGrid x:Name="ProjectPurchases" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
           <DataGridTextColumn Header="Bought (UTC)" Binding="{Binding Purchase.Date, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="155" MinWidth="155"/>
           <DataGridTemplateColumn Header="Item" SortMemberPath="Purchase.Name" Width="2*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Purchase.Icon}" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="{Binding Purchase.Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
           <DataGridTextColumn Header="Buyer" Binding="{Binding Buyer}" Width="145" MinWidth="145"/>
           <DataGridTextColumn Header="Quantity" Binding="{Binding Allocation.Quantity, StringFormat=N0}" Width="100" MinWidth="100" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
           <DataGridTextColumn Header="Unit price" Binding="{Binding Purchase.UnitPrice, StringFormat=N4}" Width="120" MinWidth="120" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
           <DataGridTextColumn Header="Attributed cost" Binding="{Binding Cost, StringFormat=N2}" Width="150" MinWidth="150" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
           <DataGridTextColumn Header="Bought at" Binding="{Binding Purchase.Location}" Width="2*" MinWidth="190"/>
           <DataGridTextColumn Header="Why" Binding="{Binding Allocation.Note}" Width="180" MinWidth="180"/>
          </DataGrid.Columns></DataGrid>
           </DockPanel></TabItem>
          </TabControl>
         </DockPanel>
        </TabItem>

        <TabItem x:Name="ProjectSalesTab" Header="Sales"><DockPanel Margin="14">
         <StackPanel DockPanel.Dock="Top"><DockPanel><Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Reload sales" Click="ReloadProjectSales_Click"/><StackPanel><TextBlock Text="Sales from this project" FontSize="22" FontWeight="SemiBold" Foreground="#E1F3F2"/><TextBlock Text="Confirmed trades, linked to this project by you" Foreground="#91B9BB" Margin="0,5,0,16"/></StackPanel></DockPanel>
          <UniformGrid Columns="2" Margin="0,0,0,16"><Border Background="#112D31" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderBrush="#76D7CB" BorderThickness="0,2,0,0"><StackPanel><TextBlock Text="GROSS RECEIPTS" FontSize="10" Foreground="#91B9BB"/><TextBlock x:Name="ProjectSalesSummary" FontSize="22" Foreground="#76D7CB" Margin="0,8,0,0"/></StackPanel></Border><Border Background="#11282E" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="UNITS ATTRIBUTED" FontSize="10" Foreground="#91B9BB"/><TextBlock x:Name="ProjectSalesQuantity" FontSize="22" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
          <TextBlock x:Name="ProjectSalesNote" TextWrapping="Wrap" Foreground="#91B9BB" Margin="0,0,0,14"/>
         </StackPanel>
         <DataGrid x:Name="ProjectSales" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
          <DataGridTextColumn Header="Sold (UTC)" Binding="{Binding Sale.Date, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="155" MinWidth="155"/>
          <DataGridTemplateColumn Header="Item" SortMemberPath="Sale.Name" Width="2*" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Sale.Icon}" Width="28" Height="28" Margin="0,0,10,0"/><TextBlock Text="{Binding Sale.Name}" VerticalAlignment="Center" ToolTip="{Binding Sale.Name}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="Seller" Binding="{Binding Seller}" Width="145" MinWidth="145"/>
          <DataGridTextColumn Header="Quantity" Binding="{Binding Allocation.Quantity, StringFormat=N0}" Width="100" MinWidth="100" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
          <DataGridTextColumn Header="Unit price" Binding="{Binding Sale.UnitPrice, StringFormat=N2}" Width="130" MinWidth="130" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
          <DataGridTextColumn Header="Gross receipts" Binding="{Binding GrossProceeds, StringFormat=N2}" Width="155" MinWidth="155" HeaderStyle="{StaticResource QuantityHeader}" ElementStyle="{StaticResource QuantityText}"/>
          <DataGridTextColumn Header="Sold at" Binding="{Binding Sale.Location}" Width="2*" MinWidth="190"/>
          <DataGridTextColumn Header="Note" Binding="{Binding Allocation.Note}" Width="180" MinWidth="180"/>
         </DataGrid.Columns></DataGrid>
        </DockPanel></TabItem>

      </TabControl>
    </Grid>
    <DockPanel Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" Margin="12">
      <StackPanel DockPanel.Dock="Top"><Button Content="Back to projects" Click="BackProjects_Click" HorizontalAlignment="Left"/><TextBlock Text="Project defaults" FontSize="24" Margin="4,12"/><TextBlock Text="Defaults for new production projects. Existing projects keep their own owner, buyer and seller." Margin="4,0,4,12"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
              <Expander Header="Default owner, buyer and seller" IsExpanded="True" Foreground="#74D6C9" Margin="0,4,0,8">
                <StackPanel>
                  <TextBlock Text="The owner supplies blueprints and default skill checks. Choose a buyer and seller for planning; these settings do not add dashboard widgets." TextWrapping="Wrap" Margin="3,8" />
                  <WrapPanel>
                    <StackPanel>
                      <TextBlock Text="Project owner" />
                      <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="DefaultLead" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Buyer" />
                      <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="DefaultBuyer" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Seller" />
                      <ComboBox Style="{StaticResource WorkspaceCombo}" x:Name="DefaultSeller" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    </StackPanel>
                    <Button Content="Save defaults" Click="Defaults_Click" VerticalAlignment="Bottom" />
                  </WrapPanel>
                  <Grid Height="220" x:Name="RolesFrame" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="8" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="Roles" IsReadOnly="False" Margin="0,6">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Linked character" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridCheckBoxColumn Header="Make" Binding="{Binding Make}" />
                        <DataGridCheckBoxColumn Header="Buy" Binding="{Binding Buy}" />
                        <DataGridCheckBoxColumn Header="Sell" Binding="{Binding Sell}" />
                        <DataGridCheckBoxColumn Header="Jobs" Binding="{Binding Jobs}" />
                        <DataGridCheckBoxColumn Header="Market" Binding="{Binding Market}" />
                        <DataGridCheckBoxColumn Header="Wallet" Binding="{Binding Wallet}" />
                        <DataGridCheckBoxColumn Header="Dashboard" Binding="{Binding Dashboard}" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <Thumb Height="8" Cursor="SizeNS" DragDelta="ResizeTable_DragDelta" Grid.Row="1">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="#284950" CornerRadius="3" Margin="0,2">
                            <Border Width="35" Height="2" Background="#80B4B9" HorizontalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Grid>
                </StackPanel>
              </Expander>

            </StackPanel>
          </ScrollViewer>
            </DockPanel>
    <DockPanel Grid.Row="1" Margin="12" x:Name="ProjectGallery">
      <StackPanel DockPanel.Dock="Top" Margin="0,8,0,18">
        <TextBlock Text="Your production projects" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="Choose a build to review components, blueprints, stock and jobs." Margin="0,8,0,12" Foreground="#99B7BC" />
        <WrapPanel><Button Content="+ New project" Click="NewProject_Click"/><Button Content="Project defaults" Click="ProjectDefaults_Click"/></WrapPanel>
      </StackPanel>
      <ListBox x:Name="Projects" SelectionChanged="Project_Selected" Background="#07181B" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Width="260" Padding="18" Margin="5" Background="#10282D" BorderBrush="#2C4C53" BorderThickness="1" CornerRadius="12">
              <StackPanel>
                <Image Source="{Binding Icon}" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,18" />
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#E5F1F2" />
                <TextBlock Text="{Binding Detail}" Foreground="#99B7BC" TextWrapping="Wrap" Margin="0,10,0,15" />
                <TextBlock Text="Open project  →" Foreground="#74D6C9" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Row="1" Visibility="Collapsed" Margin="12" x:Name="CreationPage"><Expander Header="Create by product name" DockPanel.Dock="Bottom" Margin="10"><StackPanel>              <Expander Header="FIND PRODUCT / COMPONENT BY NAME" Foreground="#74D6C9" Margin="0,4,0,8">
                <StackPanel>
                  <TextBox x:Name="TypeSearch" ToolTip="Search product names; first 80 matches" TextChanged="TypeSearch_Changed" />
                  <ListBox x:Name="TypeResults" DisplayMemberPath="Value" Height="100" Background="#091C20" Foreground="#DDF6F4" />
                  <WrapPanel>
                    <Button Content="USE FOR NEW PROJECT" Click="UseProduct_Click" />
                    <Button Content="USE FOR CHILD COMPONENT" Visibility="Collapsed" Click="UseComponent_Click" />
                  </WrapPanel>
                </StackPanel>
              </Expander>
              <Expander Header="NEW DRAFT PROJECT" IsExpanded="True" Foreground="#74D6C9" Margin="0,4,0,8">
                <StackPanel>
                  <TextBlock Text="Choose a product by name above, or create a build from an owned blueprint." TextWrapping="Wrap" Margin="3,6" />
                  <WrapPanel>
                    <StackPanel>
                      <TextBlock Text="Project name" />
                      <TextBox x:Name="NewName" Width="200" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Product" />
                      <TextBox x:Name="NewType" Width="95" Visibility="Collapsed" />
                      <TextBlock Text="Choose a product above" Margin="4,10" MinWidth="160" x:Name="SelectedProductName" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Output quantity" />
                      <TextBox x:Name="NewQuantity" Text="1" Width="95" />
                    </StackPanel>
                    <Button Content="CREATE PROJECT" Click="Create_Click" VerticalAlignment="Bottom" />
                  </WrapPanel>
                </StackPanel>
              </Expander></StackPanel></Expander>
      <Button Content="← Projects" Click="BackProjects_Click" HorizontalAlignment="Left" DockPanel.Dock="Top" />
      <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
          <WrapPanel>
            <StackPanel>
              <TextBlock Text="BLUEPRINT OWNER" Foreground="#80BFFF" />
              <ComboBox x:Name="BlueprintOwner" Style="{StaticResource WorkspaceCombo}" DisplayMemberPath="Name" SelectionChanged="BlueprintOwner_Changed" MinWidth="180" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="STATION / CONTAINER" Foreground="#80BFFF" />
              <ComboBox x:Name="BlueprintLocation" Style="{StaticResource WorkspaceCombo}" SelectionChanged="BlueprintFilter_Changed" MinWidth="260" MaxWidth="450" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="SEARCH BLUEPRINT / PRODUCT" />
              <TextBox x:Name="BlueprintSearch" Width="210" TextChanged="BlueprintSearch_Changed" />
            </StackPanel>
          </WrapPanel>
          <TextBlock x:Name="BlueprintSummary" TextWrapping="Wrap" Foreground="#8FB2B5" Margin="3,8" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Background="#102D31" BorderBrush="#245058" BorderThickness="1" Padding="10" Margin="0,8,0,0">
          <StackPanel>
            <WrapPanel>
              <TextBlock Text="Output units" VerticalAlignment="Center" />
              <TextBox x:Name="BlueprintQuantity" Text="1" Width="90" />
              <Button Content="CREATE PRODUCTION PLAN" Click="CreateBlueprint_Click" ToolTip="Selected blueprint ME applies to final output. Child recipes use ME 0, with no facility/rig bonuses. Reactions and invention remain purchase inputs. No jobs are submitted." />
            </WrapPanel>
          </StackPanel>
        </Border>
        <DataGrid x:Name="Blueprints">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="BLUEPRINT" SortMemberPath="Name" Width="2*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="ME / TE" SortMemberPath="ME" Binding="{Binding Efficiency}" Width="150" />
            <DataGridTextColumn Header="RUNS" SortMemberPath="Runs" Binding="{Binding RunText}" Width="80" />
            <DataGridTextColumn Header="LOCATION / CONTAINER" Binding="{Binding Location}" Width="2*" />
            <DataGridTemplateColumn Header="STATUS" SortMemberPath="Status" Width="170">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border BorderBrush="{Binding Color}" BorderThickness="2,0,0,0" Padding="8,3">
                    <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </DockPanel>
  </Grid>
</UserControl>