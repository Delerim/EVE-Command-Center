<Window x:Class="EveCommandCenter.Views.ContractsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EVE Command Center - Corporation Contracts" Width="1420" Height="830" MinWidth="1080" MinHeight="650"
 Background="#07181B" Foreground="#EAF7F7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel><TextBlock Text="CORPORATION CONTRACTS" FontSize="27" FontWeight="Bold" Foreground="#EAF7F7"/><TextBlock Text="Buyback checks, Janice appraisals and a closer look at every delivery" Foreground="#8FB2B5" Margin="0,4,0,0"/></StackPanel>
   <StackPanel HorizontalAlignment="Right"><TextBlock x:Name="FreshnessText" Foreground="#74D6C9" HorizontalAlignment="Right"/><CheckBox x:Name="AlertsCheck" Content="NEW CONTRACT ALERTS" Foreground="#55D7D2" Click="Alerts_Click" Margin="0,8,0,0" HorizontalAlignment="Right" ToolTip="Monitor every 30 minutes while Command Center is running, even with this window closed."/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#0C2529" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
   <DockPanel><TextBlock Text="CORP DATA TOON" Foreground="#8FB2B5" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="PilotCombo" Width="250" DisplayMemberPath="CharacterName"/>
    <Button x:Name="ReconnectButton" Content="RECONNECT / ADD" Click="Reconnect_Click" Margin="10,0,0,0"/>
    <Button x:Name="RefreshButton" Content="USE TOON / REFRESH" Click="Refresh_Click" Margin="8,0,0,0" Background="#17656A" BorderBrush="#55D7D2"/>
    <TextBlock Text="Read access requires the appropriate corporation permissions." Foreground="#8FB2B5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"/>
   </DockPanel>
  </Border>
  <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="OUTSTANDING" Foreground="#8FB2B5"/><TextBlock x:Name="CountText" FontSize="26" Foreground="#55D7D2" FontWeight="Bold"/><TextBlock x:Name="CorpText" Foreground="#8FB2B5" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0"><StackPanel><TextBlock Text="CONTRACT VALUE" Foreground="#8FB2B5"/><TextBlock x:Name="ValueText" FontSize="23" Foreground="#EAF7F7" FontWeight="Bold"/><TextBlock Text="Total requested ISK" Foreground="#8FB2B5"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0"><StackPanel><TextBlock Text="CHECKS PASSED" Foreground="#8FB2B5"/><TextBlock x:Name="PassedText" FontSize="26" Foreground="#74D6C9" FontWeight="Bold"/><TextBlock Text="Inspect contents before accepting" Foreground="#8FB2B5"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#6F5A2C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="NEEDS ATTENTION" Foreground="#C9B784"/><TextBlock x:Name="AttentionText" FontSize="26" Foreground="#FFD166" FontWeight="Bold"/><TextBlock Text="Price, market or location checks" Foreground="#8FB2B5"/></StackPanel></Border>
  </UniformGrid>
  <StackPanel Grid.Row="3" Margin="0,0,0,12">
   <WrapPanel Margin="0,0,0,8"><TextBlock Text="JITA BUY %" VerticalAlignment="Center" Foreground="#8FB2B5"/><TextBox x:Name="RateBox" Width="55" Margin="8,0,14,0"/>
    <TextBlock Text="TOLERANCE %" VerticalAlignment="Center" Foreground="#8FB2B5"/><TextBox x:Name="ToleranceBox" Width="55" Margin="8,0,14,0"/>
    <Button Content="SAVE RULES" Click="SaveRules_Click"/><TextBlock Text="  Checks use the linked appraisal; contracts are never accepted automatically." Foreground="#6F9497" VerticalAlignment="Center"/>
   </WrapPanel>
   <TextBlock Text="APPROVED: Raren - Ducks Migration  |  Mazitah - Eagle One  |  Joppaya IX - Moon 9 - Ardishapur Family Bureau" Foreground="#74D6C9" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DockPanel><TextBox x:Name="SearchBox" Width="330" TextChanged="Search_Changed" ToolTip="Search issuer, title, location or contract ID"/>
    <ComboBox x:Name="FilterCombo" Width="190" Margin="10,0,0,0" SelectionChanged="Search_Changed"><ComboBoxItem Content="All outstanding" IsSelected="True"/><ComboBoxItem Content="Checks passed"/><ComboBoxItem Content="Needs attention"/></ComboBox>
    <TextBlock Text="Double-click a row to inspect its contents" Foreground="#8FB2B5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </DockPanel>
  </StackPanel>
  <DataGrid Grid.Row="4" x:Name="ContractsGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Row_DoubleClick" SelectionMode="Single" AlternationCount="2">
   <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{Binding RowColor}"/><Setter Property="BorderBrush" Value="{Binding ResultColor}"/><Setter Property="BorderThickness" Value="4,0,0,0"/><Setter Property="ToolTip" Value="{Binding Reason}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="BorderThickness" Value="4,1,1,1"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="ISSUER" Binding="{Binding Issuer}" Width="1.1*"/>
    <DataGridTextColumn Header="PRICE" Binding="{Binding PriceText}" Width="1.2*"/>
    <DataGridTextColumn Header="EXPECTED" Binding="{Binding ExpectedText}" Width="1.2*"/>
    <DataGridTextColumn Header="JITA BUY %" Binding="{Binding ActualPercentText}" Width="85"/>
    <DataGridTextColumn Header="DIFFERENCE" Binding="{Binding DifferenceText}" Width="1.1*"/>
    <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="1.6*"/>
    <DataGridTemplateColumn Header="RESULT" Width="1.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" ToolTip="{Binding Reason}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresText}" Width="100"/>
    <DataGridTemplateColumn Header="JANICE" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="VIEW" Click="Janice_Click" Padding="6,3" ToolTip="Open linked Janice appraisal"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="IN GAME" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="OPEN" Click="Game_Click" Padding="6,3" ToolTip="Open contract in the authorized character's EVE client"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="5"><Border Background="#0C2529" BorderBrush="{Binding SelectedItem.ResultColor, ElementName=ContractsGrid}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,10,0,0"><TextBlock Text="{Binding SelectedItem.Reason, ElementName=ContractsGrid}" Foreground="#EAF7F7" TextWrapping="Wrap"/></Border><TextBlock x:Name="StatusText" Text="Choose your corporation-data character. Monitoring continues when this window is closed." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
 </Grid>
</Window>
