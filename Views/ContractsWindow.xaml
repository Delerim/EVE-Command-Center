<Window x:Class="EveCommandCenter.Views.ContractsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="EVE Command Center - Corporation Contracts" Width="1420" Height="960" MinWidth="1080" MinHeight="650"
 Background="#07181B" Foreground="#EAF7F7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ContractsTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel><TextBlock Text="CORPORATION CONTRACTS" FontSize="27" FontWeight="Bold" Foreground="#EAF7F7"/><TextBlock Text="Buyback checks, Janice appraisals and a closer look at every delivery" Foreground="#8FB2B5" Margin="0,4,0,0"/></StackPanel>
   <StackPanel HorizontalAlignment="Right"><TextBlock x:Name="FreshnessText" Foreground="#74D6C9" HorizontalAlignment="Right"/><CheckBox x:Name="AlertsCheck" Content="CONTRACT ALERTS" Foreground="#55D7D2" Click="Alerts_Click" Margin="0,8,0,0" HorizontalAlignment="Right" ToolTip="Check every 30 minutes (or later if ESI requires) while Command Center is running, even with this window closed."/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#0C2529" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
   <DockPanel><TextBlock Text="CORP DATA TOON" Foreground="#8FB2B5" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="PilotCombo" Width="250" DisplayMemberPath="CharacterName"/>
    <Button x:Name="ReconnectButton" Content="RECONNECT / ADD" Click="Reconnect_Click" Margin="10,0,0,0"/>
    <Button x:Name="RefreshButton" Content="USE TOON / REFRESH" Click="Refresh_Click" Margin="8,0,0,0" Background="#17656A" BorderBrush="#55D7D2"/>
    <TextBlock Text="Read access requires the appropriate corporation permissions." Foreground="#8FB2B5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"/>
   </DockPanel>
  </Border>
  <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="OUTSTANDING" Foreground="#8FB2B5"/><TextBlock x:Name="CountText" FontSize="26" Foreground="#55D7D2" FontWeight="Bold"/><TextBlock x:Name="CorpText" Foreground="#8FB2B5" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0"><StackPanel><TextBlock Text="CONTRACT VALUE" Foreground="#8FB2B5"/><TextBlock x:Name="ValueText" FontSize="23" Foreground="#EAF7F7" FontWeight="Bold"/><TextBlock Text="Total requested ISK" Foreground="#8FB2B5"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#245058" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0"><StackPanel><TextBlock Text="CHECKS PASSED" Foreground="#8FB2B5"/><TextBlock x:Name="PassedText" FontSize="26" Foreground="#74D6C9" FontWeight="Bold"/><TextBlock Text="Inspect contents before accepting" Foreground="#8FB2B5"/></StackPanel></Border>
   <Border Background="#0D2B30" BorderBrush="#6F5A2C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="NEEDS ATTENTION" Foreground="#C9B784"/><TextBlock x:Name="AttentionText" FontSize="26" Foreground="#FFD166" FontWeight="Bold"/><TextBlock Text="Price, market or location checks" Foreground="#8FB2B5"/></StackPanel></Border>
  </UniformGrid>
  <StackPanel Grid.Row="3" Margin="0,0,0,12">
   <WrapPanel Margin="0,0,0,8"><TextBlock Text="JITA BUY %" VerticalAlignment="Center" Foreground="#8FB2B5"/><TextBox x:Name="RateBox" Width="55" Margin="8,0,14,0"/>
    <TextBlock Text="TOLERANCE %" VerticalAlignment="Center" Foreground="#8FB2B5"/><TextBox x:Name="ToleranceBox" Width="55" Margin="8,0,14,0"/>
    <Button Content="SAVE RULES" Click="SaveRules_Click"/><TextBlock Text="  Checks use the linked appraisal; contracts are never accepted automatically." Foreground="#6F9497" VerticalAlignment="Center"/>
   </WrapPanel>
   <TextBlock Text="APPROVED: Raren - Ducks Migration  |  Mazitah - Eagle One  |  Joppaya IX - Moon 9 - Ardishapur Family Bureau" Foreground="#74D6C9" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <DockPanel><TextBox x:Name="SearchBox" Width="330" TextChanged="Search_Changed" ToolTip="Search issuer, title, location or contract ID"/>
    <ComboBox x:Name="FilterCombo" Width="190" Margin="10,0,0,0" SelectionChanged="Search_Changed"><ComboBoxItem Content="All outstanding" IsSelected="True"/><ComboBoxItem Content="Checks passed"/><ComboBoxItem Content="Needs attention"/></ComboBox>
    <TextBlock Text="Double-click a row to inspect its contents" Foreground="#8FB2B5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </DockPanel>
  </StackPanel>
  <TabControl x:Name="ContractTabs" Grid.Row="4" Background="#07181B" BorderBrush="#245058"><TabItem Header="OUTSTANDING" Background="#12383D" Foreground="#55D7D2">
  <DataGrid x:Name="ContractsGrid" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Row_DoubleClick" SelectionMode="Single" AlternationCount="2">
   <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="{Binding RowColor}"/><Setter Property="BorderBrush" Value="{Binding ResultColor}"/><Setter Property="BorderThickness" Value="4,0,0,0"/><Setter Property="ToolTip" Value="{Binding Reason}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="BorderThickness" Value="4,1,1,1"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
   <DataGrid.Columns>
    <DataGridTextColumn Header="ISSUER" Binding="{Binding Issuer}" Width="1.1*"/>
    <DataGridTextColumn Header="PRICE" Binding="{Binding PriceText}" Width="1.2*"/>
    <DataGridTextColumn Header="EXPECTED" Binding="{Binding ExpectedText}" Width="1.2*"/>
    <DataGridTextColumn Header="JITA BUY %" Binding="{Binding ActualPercentText}" Width="85"/>
    <DataGridTextColumn Header="DIFFERENCE" Binding="{Binding DifferenceText}" Width="1.1*"/>
    <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="1.6*"/>
    <DataGridTemplateColumn Header="RESULT" Width="1.1*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" ToolTip="{Binding Reason}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="EXPIRES" Binding="{Binding ExpiresText}" Width="100"/>
    <DataGridTemplateColumn Header="JANICE" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="VIEW" Click="Janice_Click" Padding="6,3" ToolTip="Open linked Janice appraisal"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="IN GAME" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="OPEN" Click="Game_Click" Padding="6,3" ToolTip="Open contract in the authorized character's EVE client"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  </TabItem><TabItem Header="HISTORY" Background="#12383D" Foreground="#55D7D2"><DockPanel Margin="10">
   <TextBlock x:Name="HistorySummary" DockPanel.Dock="Top" Foreground="#74D6C9" FontSize="17" Margin="0,0,0,10" TextWrapping="Wrap"/>
   <TextBlock DockPanel.Dock="Bottom" Text="Recorded history includes ESI's available records and locally archived contracts. Acceptor may be a corporation; ESI does not always identify its acting pilot." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,10,0,0"/>
   <DataGrid x:Name="HistoryGrid" MouseDoubleClick="History_DoubleClick" AlternationCount="2"><DataGrid.Columns>
    <DataGridTextColumn Header="CONTRACT" Binding="{Binding Contract.Id}" Width="95"/><DataGridTextColumn Header="STATUS" Binding="{Binding Contract.Status}" Width="110"/>
    <DataGridTextColumn Header="ISSUER" Binding="{Binding Issuer}" Width="*"/><DataGridTextColumn Header="PRICE" Binding="{Binding PriceText}" Width="*"/>
    <DataGridTextColumn Header="ACCEPTED BY" Binding="{Binding Acceptor}" Width="*"/><DataGridTextColumn Header="ACCEPTED" Binding="{Binding AcceptedText}" Width="145"/>
    <DataGridTextColumn Header="ISSUED" Binding="{Binding Contract.Issued, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="145"/>
    <DataGridTemplateColumn Header="JANICE" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="VIEW" Click="Janice_Click" Padding="6,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="IN GAME" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="OPEN" Click="Game_Click" Padding="6,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns></DataGrid>
  </DockPanel></TabItem><TabItem Header="ACCEPTORS" Background="#12383D" Foreground="#55D7D2"><DataGrid x:Name="AcceptorsGrid" Margin="10" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="ACCEPTOR REPORTED BY ESI" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="CONTRACTS ACCEPTED" Binding="{Binding Count}" Width="*"/><DataGridTextColumn Header="TOTAL PRICE (ISK)" Binding="{Binding Value, StringFormat=N2}" Width="*"/><DataGridTextColumn Header="LAST ACCEPTANCE" Binding="{Binding Last, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="BUYBACK REPORT" Background="#12383D" Foreground="#55D7D2"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <WrapPanel><TextBlock Text="PERIOD" Foreground="#8FB2B5" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ReportPeriod" Width="105" SelectionChanged="Report_Changed"><ComboBoxItem Content="Week"/><ComboBoxItem Content="Month" IsSelected="True"/><ComboBoxItem Content="Year"/></ComboBox><Button Content="PREVIOUS" Click="ReportPrevious_Click" Margin="12,0,6,0"/><DatePicker x:Name="ReportDate" Width="156" Style="{StaticResource CommandDatePicker}" SelectedDateChanged="Report_Changed"/><Button Content="NEXT" Click="ReportNext_Click" Margin="6,0"/><Button Content="TODAY" Click="ReportToday_Click"/></WrapPanel>
 <StackPanel Grid.Row="1" Margin="0,14"><TextBlock x:Name="ReportTitle" FontSize="20" Foreground="#55D7D2"/><TextBlock x:Name="ReportSummary" Foreground="#74D6C9" Margin="0,6,0,0"/></StackPanel>
 <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ReportBars" VerticalAlignment="Top"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="38" ToolTip="{Binding Tooltip}" Margin="1,0"><Grid Height="200"><Border Height="{Binding Height}" Width="25" Background="#55D7D2" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"/></Grid><TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="#8FB2B5" Margin="0,6"/><TextBlock Text="{Binding Count}" HorizontalAlignment="Center" Foreground="#74D6C9"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 <TextBlock Grid.Row="3" Text="Bars: total accepted contract price (ISK). Numbers: contracts per day/month. UTC acceptance dates. Includes completed incoming item exchanges with Janice links only. Available ESI history plus local archive; missing historical coverage is not proof of zero activity." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,12,0,0"/>
</Grid></TabItem></TabControl>
  <StackPanel Grid.Row="5"><Border Background="#0C2529" BorderBrush="{Binding SelectedItem.ResultColor, ElementName=ContractsGrid}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,10,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ContractTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding SelectedItem.Reason, ElementName=ContractsGrid}" Foreground="#EAF7F7" TextWrapping="Wrap"/></Border><TextBlock x:Name="StatusText" Text="Choose your corporation-data character. Monitoring continues when this window is closed." Foreground="#8FB2B5" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
 </Grid>
</Window>
