<UserControl x:Class="EveCommandCenter.Views.PiEconomicsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#DDF6F4">
<UserControl.Resources><Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C5750"/><Setter Property="Foreground" Value="#DDF6F4"/></Trigger></Style.Triggers></Style></UserControl.Resources><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.6*" MinWidth="450"/></Grid.ColumnDefinitions>
<DockPanel><TextBlock DockPanel.Dock="Top" Text="POCO RATES | per pilot and planet" FontWeight="Bold" Foreground="#55D7D2" Margin="0,0,0,10"/><DataGrid x:Name="Planets" SelectionChanged="Planet_Selected"><DataGrid.Columns><DataGridTextColumn Header="PILOT / PLANET" Binding="{Binding Label}" Width="2*"/><DataGridTextColumn Header="TOTAL POCO %" Binding="{Binding Rate}" Width="*"/><DataGridTextColumn Header="MANUAL UPDATE" Binding="{Binding Updated}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel>
<GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="#245058"/>
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,0"><TextBlock Text="PI BATCH PROFIT" FontSize="20" FontWeight="Bold" Foreground="#55D7D2"/><TextBlock x:Name="ColonyTitle" Margin="0,8" FontWeight="Bold"/>
<TextBlock Text="Enter the effective POCO rate for this pilot: owner rate plus any NPC portion after Customs Code Expertise. Rates are manual, not ESI verified. Import duty uses half the export taxable value; enter the full rate once." TextWrapping="Wrap" Foreground="#9FC5C7" Margin="0,0,0,12"/>
<WrapPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="Total POCO %"/><TextBox x:Name="PocoRate" Width="130"/></StackPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="Seller sales tax %"/><TextBox x:Name="SalesRate" Width="130"/></StackPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="Seller broker %"/><TextBox x:Name="BrokerRate" Width="130"/></StackPanel></WrapPanel>
<CheckBox Foreground="#DDF6F4" x:Name="Immediate" Content="Sell immediately to Jita buy orders (no sale broker fee)" Margin="0,0,0,12"/>
<WrapPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="Output product"/><ComboBox x:Name="Product" DisplayMemberPath="Name" Width="230"/></StackPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="Batch output units"/><TextBox x:Name="Units" Text="100" Width="130"/></StackPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="Other batch costs (ISK)"/><TextBox x:Name="Other" Text="0" Width="160"/></StackPanel></WrapPanel>
<TextBlock Text="Scenario, not an extraction ledger: T2+ assumes T1 inputs bought directly in Jita and intermediate processing on this planet. Own T1 is valued at replacement cost. T1 output assumes local extraction. Add hauling, setup allocation or extra upstream customs costs above. No guaranteed throughput or order fills." TextWrapping="Wrap" Foreground="#9FC5C7" Margin="0,0,0,12"/>
<Button Content="USE COLLECTABLE ESTIMATE" Click="Collectable_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/><WrapPanel><Button Content="SAVE RATES &amp; CALCULATE" Click="Calculate_Click"/><Button x:Name="QuotesButton" Content="LOAD JITA QUOTES" Click="Quotes_Click" Margin="8,0"/></WrapPanel><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#FFD166" Margin="0,10"/>
<Border Background="#102D31" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="ESTIMATED BATCH MARGIN" Foreground="#9FC5C7"/><TextBlock x:Name="Net" Text="Select a planet" FontSize="24" Margin="0,8"/><TextBlock x:Name="Breakdown" TextWrapping="Wrap"/><TextBlock x:Name="InputSummary" Foreground="#9FC5C7" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
</StackPanel></ScrollViewer></Grid></UserControl>
