<Window x:Class="EveMultiPreview.Views.CloudBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Command Center · Cloud Backup"
        Width="850" Height="690" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#07181B"
        Foreground="#EAF7F7" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8FFFF"/>
            <Setter Property="Background" Value="#12383D"/>
            <Setter Property="BorderBrush" Value="#2C6269"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1F23"/>
            <Setter Property="Foreground" Value="#EAF7F7"/>
            <Setter Property="BorderBrush" Value="#2C6269"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBE4E4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="GOOGLE DRIVE BACKUP" FontSize="27"
                       FontWeight="Bold" Foreground="#E8FFFF"/>
            <TextBlock Text="Restore the whole command centre after an update or on another PC"
                       Foreground="#8FB2B5" FontSize="13"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
            <Border Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,5,0">
                <StackPanel><TextBlock Text="GOOGLE STATUS" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="GoogleStatusText" Text="Not connected"
                               FontSize="17" FontWeight="Bold" Foreground="#FFB74D"/></StackPanel>
            </Border>
            <Border Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0">
                <StackPanel><TextBlock Text="REMOTE BACKUP" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="RemoteBackupText" Text="Not checked"
                               FontSize="17" FontWeight="Bold" Foreground="#55D7D2"/></StackPanel>
            </Border>
            <Border Background="#0D2B30" BorderBrush="#245058"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="5,0,0,0">
                <StackPanel><TextBlock Text="LAST LOCAL BACKUP" Foreground="#7EA8AB"/>
                    <TextBlock x:Name="LastBackupText" Text="Never"
                               FontSize="17" FontWeight="Bold" Foreground="#81C784"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#0C2529" BorderBrush="#245058"
                BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ONE-TIME GOOGLE SETUP" FontWeight="Bold"
                           Foreground="#A9DADA"/>
                <TextBlock Margin="0,6,0,10" Foreground="#789EA1"
                           TextWrapping="Wrap"
                           Text="Create a Desktop OAuth client in Google Cloud, enable Google Drive API, download its client JSON, then choose it here. Keep that JSON: a new PC must use the same OAuth client to see the hidden backup. The app requests only Drive's private app-data scope. EVE and Google refresh tokens stay in Windows Credential Manager and are never placed in the backup."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConnectButton" Content="CHOOSE OAUTH JSON &amp; CONNECT"
                            Click="Connect_Click" Background="#17656A" BorderBrush="#55D7D2"/>
                    <Button x:Name="ReconnectButton" Content="RECONNECT GOOGLE"
                            Click="Reconnect_Click" Margin="8,0,0,0"/>
                    <Button x:Name="DisconnectButton" Content="DISCONNECT"
                            Click="Disconnect_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#0C2529" BorderBrush="#245058"
                BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AUTOMATIC BACKUP" FontWeight="Bold" Foreground="#A9DADA"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="AutoBackupCheck" Content="Back up while running and on exit"/>
                        <TextBlock Text="Every" Foreground="#789EA1" Margin="18,2,7,0"/>
                        <TextBox x:Name="MinutesBox" Width="58" Text="15"/>
                        <TextBlock Text="minutes" Foreground="#789EA1" Margin="7,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="SAVE AUTOMATION" Click="SaveAutomation_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="#0C2529" BorderBrush="#245058"
                BorderThickness="1" CornerRadius="7" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="BACKUP CONTENTS" FontWeight="Bold" Foreground="#A9DADA"/>
                <TextBlock Grid.Row="1" Margin="0,7,0,12" TextWrapping="Wrap"
                           Foreground="#789EA1"
                           Text="Client accounts and layout · thumbnail and overview settings · mining preferences and tile order · mining JSONL/history · pilot metadata · moon profiles, pulls, ledger history and reports. Tokens, runtime caches, window handles and process IDs are excluded."/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BackupButton" Content="BACK UP NOW" Click="Backup_Click"
                            Background="#17656A" BorderBrush="#55D7D2"/>
                    <Button x:Name="RestoreButton" Content="RESTORE &amp; RESTART"
                            Click="Restore_Click" Margin="8,0,0,0" Background="#5A4020"
                            BorderBrush="#C89243"/>
                    <Button Content="REFRESH STATUS" Click="RefreshStatus_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="2,12,2,0">
            <ProgressBar x:Name="BusyBar" Width="160" Height="5"
                         IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right"
                       Text="Ready" Foreground="#8FB2B5" TextWrapping="Wrap"
                       HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
