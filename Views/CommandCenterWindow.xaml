<Window x:Class="EveCommandCenter.Views.CommandCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EVE Command Center"
        MinWidth="1120"
        MinHeight="720"
        Width="1600"
        Height="920"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#050D12"
        Foreground="#E9F7F6">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeroBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#102D34" Offset="0"/>
            <GradientStop Color="#0A2029" Offset="0.52"/>
            <GradientStop Color="#07151C" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="Cyan" Color="#55D7D2"/>
        <SolidColorBrush x:Key="Mint" Color="#74D6C9"/>
        <SolidColorBrush x:Key="Muted" Color="#6E9496"/>
        <SolidColorBrush x:Key="Panel" Color="#0A1C22"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#173A43"/>

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#55D7D2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#0D2730"/>
            <Setter Property="Foreground" Value="#DCEFED"/>
            <Setter Property="BorderBrush" Value="#234752"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#123A40"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#42B6A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#185247"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="LaunchButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#17564B"/>
            <Setter Property="BorderBrush" Value="#64E3C8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="13,13"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0A1C22"/>
            <Setter Property="BorderBrush" Value="#173A43"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="-3"
                                             Duration="0:0:0.12"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             To="0"
                                             Duration="0:0:0.14"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#55D7D2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="BigMetric" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2FFFD"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6E9496"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootShell"
          Opacity="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#071820"
                BorderBrush="#17333C"
                BorderThickness="0,0,1,0"
                Padding="14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                CornerRadius="9"
                                Background="#071419"
                                BorderBrush="#55D7D2"
                                BorderThickness="1">
                            <Image x:Name="CommandCenterBrandIcon"
                                   Source="/Resources/CommandCenterIcon.png"
                                   Width="38"
                                   Height="38"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="9,0,0,0">
                            <TextBlock Text="EVE"
                                       Foreground="#55D7D2"
                                       FontWeight="Bold"
                                       FontSize="23"/>
                            <TextBlock Text="COMMAND CENTER"
                                       Foreground="#F1F8F7"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBlock Text="OPERATIONS CONSOLE"
                                       Foreground="#5E7E85"
                                       FontSize="8.5"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="LaunchOverviewButton"
                            Style="{StaticResource LaunchButton}"
                            Click="LaunchOverview_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" Foreground="#FFFFFF"/>
                            <StackPanel>
                                <TextBlock Text="LAUNCH CHARACTER OVERVIEW"/>
                                <TextBlock Text="Live fleet overlay"
                                           Foreground="#A8D9CF"
                                           FontSize="9.5"
                                           FontWeight="Normal"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="OPERATIONS"
                               Foreground="#55777D"
                               FontSize="9"
                               FontWeight="Bold"
                               Margin="4,17,0,3"/>

                    <Button Style="{StaticResource NavButton}" Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="DASHBOARD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Mining_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="MINING" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Pilots_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="PILOTS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Industry_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="INDUSTRY" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Planetary_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="PLANETARY INDUSTRY" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Moons_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="MOON OPERATIONS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Contracts_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C7;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="CONTRACTS / ACCOUNTS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Notifications_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="NOTIFICATIONS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource NavButton}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="SETTINGS" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}"/>
                            <TextBlock Text="REFRESH LIVE DATA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#092229"
                            BorderBrush="#21454E"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,11,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#55D7D2"
                                         Margin="0,0,7,0"/>
                                <TextBlock Text="SYSTEM LINK"
                                           Foreground="#55D7D2"
                                           FontSize="9.5"
                                           FontWeight="Bold"/>
                            </DockPanel>
                            <TextBlock x:Name="SidebarFreshnessText"
                                       Text="Loading saved operations data..."
                                       Foreground="#86A9AB"
                                       FontSize="9.5"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#071319"
                    BorderBrush="#17333C"
                    BorderThickness="0,0,0,1"
                    Padding="22,12">
                <DockPanel>
                    <StackPanel>
                        <TextBlock x:Name="PageTitleText" Text="COMMAND OVERVIEW"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#F2F8F7"/>
                        <TextBlock x:Name="PageSubtitleText" Text="Fleet, industry and corporation operations"
                                   Foreground="#66898F"
                                   FontSize="10.5"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="VersionClockText"
                                   Text="v3.6.1 | EVE --:--:-- | LOCAL --:--:--"
                                   Foreground="#8DB1B3"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="ClientStatusText"
                                   Text="0 EVE clients detected"
                                   Foreground="#55D7D2"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="WorkspaceArea"
                  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#07171D"
                        BorderBrush="#173A43"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <DockPanel>
                        <TextBlock Text="WORKSPACE"
                                   Foreground="#55777D"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="2,0,12,0"/>

                        <ItemsControl x:Name="WorkspaceTabStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Key}"
                                            Click="WorkspaceTab_Click"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding Border}"
                                            Padding="9,5"
                                            Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{Binding Foreground}"
                                                       FontSize="12"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{Binding Foreground}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="DashboardScroll"
                              Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DashboardContent"
                            Margin="22">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="DashboardTransform"/>
                    </StackPanel.RenderTransform>

                    <Border x:Name="WelcomePanel"
                            Background="{StaticResource HeroBrush}"
                            BorderBrush="#245763"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <Border Background="#123B40"
                                            BorderBrush="#39796C"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,3"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="COMMAND LINK ONLINE"
                                                   Foreground="#74D6C9"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"/>
                                    </Border>

                                    <Border Background="#1F2718"
                                            BorderBrush="#6D7A35"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,3">
                                        <TextBlock Text="TRANQUILITY OPERATIONS"
                                                   Foreground="#D6D784"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock x:Name="WelcomeTitleText"
                                           Text="WELCOME, COMMANDER"
                                           Foreground="#F6FFFD"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Margin="0,12,0,2"/>

                                <TextBlock x:Name="WelcomeStatusText"
                                           Text="Command Center is coming online..."
                                           Foreground="#A6C5C5"
                                           FontSize="12"/>

                                <TextBlock x:Name="WelcomeTelemetryText"
                                           Text="Telemetry link initializing"
                                           Foreground="#55D7D2"
                                           FontSize="10.5"
                                           Margin="0,11,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  Width="205"
                                  Height="108">
                                <Ellipse Width="104"
                                         Height="104"
                                         Stroke="#1D5961"
                                         StrokeThickness="1"
                                         Opacity="0.7"
                                         HorizontalAlignment="Right"/>
                                <Ellipse Width="76"
                                         Height="76"
                                         Stroke="#2B7E7C"
                                         StrokeThickness="1"
                                         Opacity="0.75"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,14,0"/>
                                <Ellipse Width="46"
                                         Height="46"
                                         Fill="#0C3035"
                                         Stroke="#55D7D2"
                                         StrokeThickness="1"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,29,0"/>
                                <TextBlock Text="&#xE7C1;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#64E3C8"
                                           FontSize="23"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,41,0"/>
                                <TextBlock Text="ECC // OPS"
                                           Foreground="#6E9496"
                                           FontSize="9"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,6"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Background="#0C252B"
                            BorderBrush="#2E605B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="13"
                            Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="#FFD166"
                                       FontSize="15"
                                       Margin="0,0,9,0"/>
                            <TextBlock Text="NEEDS ATTENTION"
                                       Foreground="#FFD166"
                                       FontWeight="Bold"
                                       Margin="0,0,15,0"/>
                            <TextBlock x:Name="AttentionText"
                                       Text="Checking saved operations state..."
                                       Foreground="#D8E7E5"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" Style="{StaticResource IconGlyph}"/>
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="MINING ACTIVITY"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="OPEN MINING"
                                            Padding="8,4"
                                            FontSize="10"
                                            Click="Mining_Click"/>
                                </DockPanel>

                                <UniformGrid Columns="4"
                                             Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TODAY" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MiningTodayText" Text="--" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="YESTERDAY" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MiningYesterdayText" Text="--" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="THIS WEEK" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MiningWeekText" Text="--" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="THIS MONTH" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MiningMonthText" Text="--" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock x:Name="MiningDetailText"
                                           Style="{StaticResource MutedText}"
                                           Text="Mining history will appear as soon as logs are available."
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C3;" Style="{StaticResource IconGlyph}"/>
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="MOON OPERATIONS"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="OPEN MOONS"
                                            Padding="8,4"
                                            FontSize="10"
                                            Click="Moons_Click"/>
                                </DockPanel>

                                <UniformGrid Columns="4"
                                             Margin="0,14,0,8">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MoonActiveText" Text="0" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="READY" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MoonReadyText" Text="0" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="SCHEDULED" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MoonScheduledText" Text="0" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PROFILE ISSUES" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="MoonProfileIssueText" Text="0" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock x:Name="MoonHealthText"
                                           Foreground="#74D6C9"
                                           FontSize="11"
                                           Margin="0,4,0,8"
                                           Text="Profile health loading..."/>

                                <ItemsControl x:Name="MoonNextItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Primary}"
                                                           Foreground="#E0F0EE"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Secondary}"
                                                           Foreground="{Binding Tone}"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource IconGlyph}"/>
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="INDUSTRY BY PILOT"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="OPEN INDUSTRY"
                                            Padding="8,4"
                                            FontSize="10"
                                            Click="Industry_Click"/>
                                </DockPanel>

                                <TextBlock x:Name="IndustrySummaryText"
                                           Style="{StaticResource MutedText}"
                                           Text="Loading saved industry snapshots..."
                                           Margin="0,8,0,7"/>

                                <ItemsControl x:Name="IndustryItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#09171C"
                                                    BorderBrush="#15343B"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#EAF5F3"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Summary}"
                                                               Foreground="{Binding Tone}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource IconGlyph}"/>
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="PLANETARY INDUSTRY BY PILOT"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="OPEN PI"
                                            Padding="8,4"
                                            FontSize="10"
                                            Click="Planetary_Click"/>
                                </DockPanel>

                                <TextBlock x:Name="PiSummaryText"
                                           Style="{StaticResource MutedText}"
                                           Text="Loading saved colony snapshots..."
                                           Margin="0,8,0,7"/>

                                <ItemsControl x:Name="PiItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#09171C"
                                                    BorderBrush="#15343B"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8"
                                                    Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#EAF5F3"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Summary}"
                                                               Foreground="{Binding Tone}"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C7;" Style="{StaticResource IconGlyph}"/>
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="CONTRACTS / ACCOUNTING"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="OPEN CONTRACTS"
                                            Padding="8,4"
                                            FontSize="10"
                                            Click="Contracts_Click"/>
                                </DockPanel>

                                <UniformGrid Columns="4"
                                             Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="OUTSTANDING" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="ContractsOutstandingText" Text="0" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="BUYBACKS THIS WEEK" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="ContractsBuybackCountText" Text="0" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="VALUE THIS WEEK" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="ContractsBuybackValueText" Text="0 ISK" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="REPORTING GROUPS" Style="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="ContractsGroupText" Text="0" Style="{StaticResource BigMetric}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock x:Name="ContractsDetailText"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,11,0,0"
                                           Text="Waiting for corporation contract state."/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Style="{StaticResource Card}"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA8F;" Style="{StaticResource IconGlyph}"/>
                                        <TextBlock Style="{StaticResource SectionTitle}"
                                                   Text="SYSTEM / DATA FRESHNESS"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="OPEN NOTICES"
                                            Padding="8,4"
                                            FontSize="10"
                                            Click="Notifications_Click"/>
                                </DockPanel>

                                <TextBlock x:Name="NotificationText"
                                           Foreground="#FFD166"
                                           FontWeight="SemiBold"
                                           Margin="0,12,0,8"
                                           Text="0 active notifications"/>

                                <TextBlock x:Name="FreshnessDetailText"
                                           Foreground="#8BB0B2"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           Text="Loading service freshness..."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
                </ScrollViewer>

                <Border x:Name="ModuleFrame"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#061116"
                        BorderBrush="#173A43"
                        BorderThickness="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ModuleTransform"/>
                    </Border.RenderTransform>

                    <ContentControl x:Name="ModuleSurface"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Focusable="False"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>