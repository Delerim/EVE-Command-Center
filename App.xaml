<Application x:Class="EveCommandCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- UI string catalog base (English). Selected language overlays
                     are merged on top at runtime by LocalizationService (issue #86). -->
                <ResourceDictionary Source="Resources/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Dark Theme Color System -->
        <Color x:Key="BgDark">#FF1A1A2E</Color>
        <Color x:Key="BgPanel">#FF252540</Color>
        <Color x:Key="Accent">#FF00AAFF</Color>
        <Color x:Key="Accent2">#FF7B68EE</Color>
        <Color x:Key="TextPrimary">#FFFFFFFF</Color>
        <Color x:Key="TextSecondary">#FF888888</Color>
        <Color x:Key="BorderColor">#FF3A3A50</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
        <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}"/>
        <SolidColorBrush x:Key="BgBaseBrush" Color="#FF1E1E30"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- EVE Command Center global dark scrollbars -->
        <Style x:Key="EccScrollThumb"
               TargetType="{x:Type Thumb}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody"
                                Background="#355C55"
                                CornerRadius="5"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBody"
                                        Property="Background"
                                        Value="#58D3B4"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBody"
                                        Property="Background"
                                        Value="#7BE7CF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ThumbBody"
                                        Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="EccVerticalScrollBarTemplate"
                         TargetType="{x:Type ScrollBar}">
            <Border Background="#091315"
                    BorderBrush="#18302C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="11">
                <Track x:Name="PART_Track"
                       Orientation="Vertical"
                       IsDirectionReversed="True"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource EccScrollThumb}"
                               MinHeight="26"/>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="EccHorizontalScrollBarTemplate"
                         TargetType="{x:Type ScrollBar}">
            <Border Background="#091315"
                    BorderBrush="#18302C"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="11">
                <Track x:Name="PART_Track"
                       Orientation="Horizontal"
                       IsDirectionReversed="False"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb Style="{StaticResource EccScrollThumb}"
                               MinWidth="26"/>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background"
                    Value="#091315"/>
            <Setter Property="Foreground"
                    Value="#58D3B4"/>
            <Setter Property="Width"
                    Value="11"/>
            <Setter Property="Template"
                    Value="{StaticResource EccVerticalScrollBarTemplate}"/>

            <Style.Triggers>
                <Trigger Property="Orientation"
                         Value="Horizontal">
                    <Setter Property="Width"
                            Value="Auto"/>
                    <Setter Property="Height"
                            Value="11"/>
                    <Setter Property="Template"
                            Value="{StaticResource EccHorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared fully enclosed tool-tab chrome. Windows with their own pill
             style keep that local style; every ordinary TabItem now gets the
             same rounded, bordered treatment instead of the stock clipped edge. -->
        <Style x:Key="EccTabItemStyle"
               TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#9FC5C7"/>
            <Setter Property="Background" Value="#0B1B1E"/>
            <Setter Property="BorderBrush" Value="#28574E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabShell"
                                        Property="Background"
                                        Value="#122724"/>
                                <Setter TargetName="TabShell"
                                        Property="BorderBrush"
                                        Value="#3D8C7C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabShell"
                                        Property="Background"
                                        Value="#1A4B43"/>
                                <Setter TargetName="TabShell"
                                        Property="BorderBrush"
                                        Value="#58D3B4"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}"
               BasedOn="{StaticResource EccTabItemStyle}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
