<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 (20H1) is the minimum that exposes the full Windows.Graphics.Capture surface -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- PerMonitorV2: WinForms coords stay in physical pixels, WPF renders crisply
         per monitor. Requires DIP/physical conversions anywhere the two meet
         (see Interop/DpiHelper.cs). -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>EVE Command Center</AssemblyName>
    <RootNamespace>EveCommandCenter</RootNamespace>
    <Version>3.5.6</Version>
    <Title>EVE Command Center</Title>
    <Product>EVE Command Center</Product>
    <Description>EVE Online command center for multi-client preview, mining and pilot intelligence</Description>

    <!-- Publish settings -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- v2.3.x uses the WinForms ThumbnailWindow.cs implementation. The older
       WPF ThumbnailWindow.xaml/.xaml.cs files are still present upstream but
       must not be compiled, otherwise both define EveCommandCenter.Views.ThumbnailWindow. -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Page Remove="Tests\**\*.xaml" />
    <Compile Remove="Views\ThumbnailWindow.xaml.cs" />
    <Page Remove="Views\ThumbnailWindow.xaml" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon-Suspend.ico" />
    <EmbeddedResource Include="Resources\alert_patterns.json" />
    <EmbeddedResource Include="Resources\pi-catalog.json" />
    <EmbeddedResource Include="Resources\industry-catalog.json" />
    <EmbeddedResource Include="Resources\skill-planner.json" />
  </ItemGroup>

</Project>
